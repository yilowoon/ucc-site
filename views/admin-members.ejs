<%- include('partials/header') %>
<div class="container admin-wrap">
  <div class="admin-head">
    <div>
      <h1>회원 관리</h1>
      <p class="admin-sub">회원 목록입니다. 회원유형 탭 안에서 <b>정회원(회비 납부)</b>과 <b>준회원(회비 미납·미확인)</b>으로 구분됩니다. 이름을 클릭하면 상세 정보를 볼 수 있습니다.</p>
    </div>
    <div class="admin-head-actions">
      <a class="btn btn-neutral btn-sm" href="/admin">대시보드</a>
    </div>
  </div>

  <div class="member-stats">
    <span class="mstat"><b><%= total || 0 %></b> 전체 회원</span>
    <span class="mstat">·</span>
    <% ["개인회원","기업회원","단체회원"].forEach(function(t){ %>
      <span class="mstat"><b><%= byType[t] || 0 %></b> <%= t %></span>
    <% }); %>
  </div>

  <%
    function tabHref(t){
      var p = [];
      if (t) p.push('type=' + encodeURIComponent(t));
      if (q) p.push('q=' + encodeURIComponent(q));
      return '/admin/members' + (p.length ? '?' + p.join('&') : '');
    }
  %>
  <div class="member-toolbar">
    <div class="seg" role="tablist">
      <a class="seg-btn <%= !type ? 'on' : '' %>" href="<%= tabHref('') %>">전체</a>
      <% ["개인회원","기업회원","단체회원"].forEach(function(t){ %>
        <a class="seg-btn <%= type===t ? 'on' : '' %>" href="<%= tabHref(t) %>"><%= t %></a>
      <% }); %>
    </div>
    <form class="member-search" method="get" action="/admin/members">
      <% if (type) { %><input type="hidden" name="type" value="<%= esc(type) %>" /><% } %>
      <input type="text" name="q" value="<%= esc(q) %>" placeholder="이름·이메일·소속 검색" />
      <button type="submit" class="btn btn-primary btn-sm">검색</button>
      <% if (q) { %><a class="btn btn-neutral btn-sm" href="<%= tabHref(type) %>">초기화</a><% } %>
    </form>
  </div>

  <%
    var sections = [
      { label: '정회원', note: '회비 납부 완료', list: full,  cls: 'grade-full'  },
      { label: '준회원', note: '회비 미납·미확인', list: assoc, cls: 'grade-assoc' }
    ];
  %>
  <% sections.forEach(function(sec){ %>
    <section class="member-section">
      <h2 class="member-sec-h">
        <span class="grade-badge <%= sec.cls %>"><%= sec.label %></span>
        <span class="member-sec-note"><%= sec.note %></span>
        <span class="member-sec-count"><%= sec.list.length %>명</span>
      </h2>
      <% if (!sec.list.length) { %>
        <p class="post-empty"><%= q ? '검색 결과가 없습니다.' : '해당하는 회원이 없습니다.' %></p>
      <% } else { %>
      <div class="member-scroll">
        <table class="log-table member-table">
          <thead>
            <tr>
              <th>회원유형</th><th>이름</th><th>소속</th><th>직급</th>
              <th>관심분야</th><th>회원가입일</th><th>회비납부일</th><th>회원자격</th>
            </tr>
          </thead>
          <tbody>
            <% sec.list.forEach(function(m){ %>
              <tr class="member-row" onclick="location.href='/admin/members/<%= m.id %>'">
                <td><span class="board-tag"><%= esc(m.member_type) %></span></td>
                <td class="member-name"><a href="/admin/members/<%= m.id %>"><%= esc(m.name) %></a></td>
                <td><%= esc(m.org_name || '-') %></td>
                <td><%= esc(m.position || '-') %></td>
                <td><%= esc(m.interest || '-') %></td>
                <td><%= fmtDate(m.created_at) || '-' %></td>
                <td><%= m.fee_paid_at ? fmtDate(m.fee_paid_at) : '-' %></td>
                <td><span class="grade-badge <%= m.grade === '정회원' ? 'grade-full' : 'grade-assoc' %>"><%= esc(m.grade || '준회원') %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  <% }); %>
</div>
<%- include('partials/footer') %>
