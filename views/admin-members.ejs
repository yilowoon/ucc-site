<%- include('partials/header') %>
<div class="container admin-wrap">
  <div class="admin-head">
    <div>
      <h1>회원 관리</h1>
      <p class="admin-sub">회원가입으로 등록된 회원 내역입니다. (개인정보는 최소 열람 원칙)</p>
    </div>
    <div class="admin-head-actions">
      <a class="btn btn-neutral btn-sm" href="/admin">대시보드</a>
    </div>
  </div>

  <div class="member-stats">
    <% ["개인회원","기업회원","단체회원","준회원"].forEach(function(t){ %>
      <span class="mstat"><b><%= byType[t] || 0 %></b> <%= t %></span>
    <% }); %>
  </div>

  <form class="member-search" method="get" action="/admin/members">
    <input type="text" name="q" value="<%= esc(q) %>" placeholder="이름·이메일·기관명 검색" />
    <button type="submit" class="btn btn-primary btn-sm">검색</button>
    <% if (q) { %><a class="btn btn-neutral btn-sm" href="/admin/members">초기화</a><% } %>
  </form>

  <% if (!members.length) { %>
    <p class="post-empty"><%= q ? '검색 결과가 없습니다.' : '가입한 회원이 없습니다.' %></p>
  <% } else { %>
  <div class="member-scroll">
  <ul class="admin-list member-list">
    <li class="admin-list-head" aria-hidden="true">
      <span class="col-mtype">구분</span>
      <span class="col-mname">이름</span>
      <span class="col-memail">이메일</span>
      <span class="col-mphone">연락처</span>
      <span class="col-morg">기관·단체</span>
      <span class="col-mdate">가입일</span>
      <span class="col-act">관리</span>
    </li>
    <% members.forEach(function(m){ %>
      <li class="admin-row">
        <span class="col-mtype"><span class="board-tag"><%= esc(m.member_type) %></span></span>
        <span class="col-mname"><%= esc(m.name) %></span>
        <span class="col-memail"><a href="mailto:<%= esc(m.email) %>"><%= esc(m.email) %></a></span>
        <span class="col-mphone"><%= esc(m.phone || '-') %></span>
        <span class="col-morg"><%= esc(m.org_name || '-') %></span>
        <span class="col-mdate"><%= fmtDate(m.created_at) %></span>
        <span class="col-act">
          <form action="/admin/members/<%= m.id %>/delete" method="post" onsubmit="return confirm('이 회원을 삭제하시겠습니까?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="linkbtn linkbtn-danger">삭제</button>
          </form>
        </span>
      </li>
    <% }); %>
  </ul>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
