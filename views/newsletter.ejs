<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <span class="page-banner-en">DAILY NEWS</span>
    <h1 class="page-banner-title">데일리뉴스</h1>
    <p class="page-banner-desc">도시공동체본부의 미션과 맞닿은 소식을 매일 아침·저녁 자동으로 모아 전해드립니다.</p>
  </div>
</section>

<%- include('partials/board-tabs') %>

<div class="container board-wrap">
  <section class="brief-intro" aria-label="데일리뉴스 소개">
    <div class="brief-intro-body">
      <span class="brief-intro-eyebrow">DAILY NEWS</span>
      <h2 class="brief-intro-title">지속가능한 도시의 오늘을 이야기 하다.</h2>
      <p class="brief-intro-lead">
        사회적 가치가 이끄는 변화의 물결, 그 중심에 서서 도시의 오늘을 조명합니다.
        사회적 경제부터 소셜 벤처, 그리고 혁신 생태계까지. 도시공동체본부의 비전이 투영된
        깊이 있는 소식을 <strong>매일 아침과 저녁</strong>, 가장 먼저 전해드립니다.
      </p>
    </div>
    <div class="brief-intro-meta">
      <span class="brief-intro-badge">
        <span class="brief-intro-badge-label">발행시간</span>
        <span class="brief-intro-badge-value">매일 오전 8시, 오후 6시</span>
      </span>
    </div>
  </section>

  <div class="board-toolbar">
    <span class="board-count">전체 <strong><%= total %></strong>건</span>
  </div>

  <ul class="post-list post-list--nl">
    <li class="post-list-head" aria-hidden="true">
      <span class="col-no">번호</span>
      <span class="col-title">제목</span>
      <span class="col-src">출처</span>
      <span class="col-kw">키워드</span>
      <span class="col-date">등록일</span>
      <span class="col-views">조회</span>
    </li>
    <% if (!items.length) { %>
      <li class="post-empty">아직 수집된 데일리뉴스가 없습니다. 매일 오전 8시·오후 6시에 자동으로 업데이트됩니다.</li>
    <% } %>
    <% items.forEach(function(n, i){ %>
      <li class="post-row">
        <span class="col-no"><%= total - ((page - 1) * per) - i %></span>
        <span class="col-title">
          <a href="/newsletter/<%= n.id %>?page=<%= page %>">
            <span class="thumb-dot" title="이미지 포함" aria-hidden="true"></span>
            <span class="post-title-text"><%= n.title %></span>
          </a>
        </span>
        <span class="col-src"><%= n.source || '-' %></span>
        <span class="col-kw"><span class="nl-kw"><%= n.keyword %></span></span>
        <span class="col-date"><%= fmtDate(n.created_at) %></span>
        <span class="col-views"><%= n.views || 0 %></span>
      </li>
    <% }); %>
  </ul>

  <% if (pages > 1) { %>
    <nav class="pagination" aria-label="페이지">
      <% if (page > 1) { %><a href="?page=<%= page - 1 %>" class="page-prev">이전</a><% } %>
      <% for (var p = 1; p <= pages; p++) { %>
        <% if (p === page) { %><span class="page-num active" aria-current="page"><%= p %></span>
        <% } else { %><a href="?page=<%= p %>" class="page-num"><%= p %></a><% } %>
      <% } %>
      <% if (page < pages) { %><a href="?page=<%= page + 1 %>" class="page-next">다음</a><% } %>
    </nav>
  <% } %>

  <p class="panel-note" style="margin-top:22px">※ 본 데일리뉴스는 외부 언론 기사를 <strong>제목·요약·출처 링크</strong> 형태로 큐레이션한 것입니다. 각 기사의 저작권은 해당 언론사에 있으며, 전체 내용은 상세 페이지의 ‘원문 보기’에서 확인하실 수 있습니다.</p>
</div>

<%- include('partials/footer') %>
