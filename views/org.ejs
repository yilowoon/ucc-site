<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <span class="page-banner-en">ORGANIZATION</span>
    <h1 class="page-banner-title">조직도</h1>
    <p class="page-banner-desc">이사회·상임대표 아래 사무국과 6대 센터가 유기적으로 협력합니다.</p>
  </div>
</section>

<!-- 조직 구성도 -->
<section class="section" id="chart">
  <div class="container">
    <div class="section-head"><div><h2 class="section-title c-green">조직 구성도</h2><span class="section-en">STRUCTURE</span></div></div>

    <div class="orgchart">
      <!-- 상단 위계 -->
      <div class="oc-top">
        <span class="oc-node oc-node--head">도시공동체본부<small>(이사장) 이가희</small></span>
      </div>
      <div class="oc-drop"></div>
      <div class="oc-gov">
        <span class="oc-node oc-node--board">이사회</span>
        <span class="oc-node oc-node--exec">상임대표<small>이형구</small></span>
      </div>
      <div class="oc-drop"></div>
      <div class="oc-bus"></div>

      <!-- 부서 + 상세 -->
      <div class="oc-depts">
        <!-- 사무국 -->
        <div class="oc-dept">
          <span class="oc-head oc-c-green">사무국</span>
          <div class="oc-subs">
            <span class="oc-sub">사무총장</span>
            <span class="oc-sub">사무국장</span>
          </div>
        </div>

        <!-- 도시혁신연구소 -->
        <div class="oc-dept">
          <span class="oc-head oc-c-blue">도시혁신연구소</span>
          <div class="oc-detail">
            <span class="oc-badge">지적 정체성</span>
            <ul>
              <li>도시문제 연구 및 리빙랩 실험</li>
              <li>GINI 글로벌 혁신 인증</li>
              <li>ESG 컨설팅 및 도시 표준 개발</li>
            </ul>
          </div>
        </div>

        <!-- 미디어&콘텐츠센터 -->
        <div class="oc-dept">
          <span class="oc-head oc-c-green">미디어&amp;콘텐츠센터</span>
          <div class="oc-detail">
            <span class="oc-badge">외적 표현</span>
            <ul>
              <li>시카고 한국일보 전략적 협력</li>
              <li>자체 미디어 및 SNS 채널 운영</li>
              <li>글로벌 브랜드 구축 및 홍보</li>
            </ul>
          </div>
        </div>

        <!-- 지역공동체활성화센터 -->
        <div class="oc-dept">
          <span class="oc-head oc-c-orange">지역공동체활성화센터</span>
          <div class="oc-detail">
            <span class="oc-badge">나눔 / 공유</span>
            <ul>
              <li>도시공동체 포럼 및 치유 프로그램</li>
              <li>지역 축제 및 문화예술 행사</li>
              <li>한복모델선발대회 개최</li>
            </ul>
          </div>
        </div>

        <!-- 컨설팅센터 -->
        <div class="oc-dept">
          <span class="oc-head oc-c-blue">컨설팅센터</span>
          <div class="oc-detail">
            <span class="oc-badge">가치 순환</span>
            <ul>
              <li>개인·기업·공공 맞춤형 컨설팅</li>
              <li>국내외 파트너십 네트워크 구축</li>
              <li>전문가 풀 운영 및 수익 창출</li>
            </ul>
          </div>
        </div>

        <!-- 교육혁신센터 -->
        <div class="oc-dept">
          <span class="oc-head oc-c-green">교육혁신센터</span>
          <div class="oc-detail">
            <span class="oc-badge">인적 성장</span>
            <ul>
              <li>4단계 인재양성 로드맵 운영</li>
              <li>경력단절여성 재진입 지원</li>
              <li>대학 연계 산학협력 프로그램</li>
            </ul>
          </div>
        </div>

        <!-- 메이커센터 -->
        <div class="oc-dept">
          <span class="oc-head oc-c-green">메이커센터</span>
          <div class="oc-detail">
            <span class="oc-badge">공간 기반</span>
            <ul>
              <li>디지털 제조 인프라 구축</li>
              <li>스타트업 인큐베이팅 공간</li>
              <li>시제품 제작 및 기술 지원</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <p class="oc-caption"><strong>이사장</strong> 이가희 문학박사 &nbsp;·&nbsp; <strong>상임대표</strong> 이형구 박사 &nbsp;·&nbsp; 이사회·자문위원회(학계·산업·공공·법률) 운영</p>
  </div>
</section>

<%- include('partials/footer') %>
