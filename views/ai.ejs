<%- include('partials/header') %>
<style>
  /* 배움터 과정 랜딩 — 전환형 컴포넌트 */
  .btn-ghost-light{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.5)}
  .btn-ghost-light:hover{background:rgba(255,255,255,.18);border-color:#fff;color:#fff;transform:translateY(-2px)}
  .lp-hero{position:relative;overflow:hidden;color:#fff;text-align:center;background:linear-gradient(rgba(16,44,33,.82), rgba(11,33,25,.93)), url('/img/ai-class.webp') center 38%/cover no-repeat;padding:clamp(64px,9vw,110px) 0 clamp(54px,7vw,88px)}
  .lp-hero::before{content:"";position:absolute;inset:0;background:radial-gradient(120% 120% at 50% 42%, transparent 0%, rgba(11,33,25,.55) 100%);pointer-events:none}
  .lp-hero::after{content:"";position:absolute;left:50%;top:-80px;width:420px;height:420px;transform:translateX(-50%);background:radial-gradient(circle, rgba(205,155,76,.28), transparent 68%);pointer-events:none}
  .lp-hero .container{position:relative;z-index:1}
  .lp-hero-eyebrow{display:inline-block;font-size:.78rem;letter-spacing:.22em;font-weight:800;color:var(--gold-400);margin-bottom:18px}
  .lp-hero-title{font-size:clamp(2rem,5.6vw,3.4rem);font-weight:800;line-height:1.22;letter-spacing:-1px;margin:0 0 18px}
  .lp-hero-title strong{color:#ffd98a}
  .lp-hero-sub{font-size:clamp(1rem,2.2vw,1.18rem);line-height:1.7;color:rgba(255,255,255,.9);margin:0 auto 30px;max-width:680px}
  .lp-hero-sub b{color:#ffe6b0;font-weight:700}
  .lp-hero-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .lp-hero-tags{list-style:none;display:flex;gap:10px 22px;justify-content:center;flex-wrap:wrap;margin:30px 0 0;padding:0}
  .lp-hero-tags li{font-size:.92rem;font-weight:600;color:rgba(255,255,255,.82)}
  .pain-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}
  .pain-card{display:flex;gap:14px;align-items:flex-start;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:22px;box-shadow:var(--shadow-sm)}
  .pain-card .pain-q{flex:0 0 auto;width:32px;height:32px;border-radius:50%;background:var(--ci-green);color:#fff;font-weight:800;display:grid;place-items:center;font-size:.95rem}
  .pain-card p{margin:0;color:var(--ink-soft);font-size:1rem;line-height:1.55;padding-top:3px}
  .pain-card p b{color:var(--green-800)}
  .pain-answer{text-align:center;margin:26px auto 0;font-size:1.08rem;font-weight:700;color:var(--green-800)}
  .pain-answer b{color:var(--ci-green-d)}
  .persona-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
  .persona-card{text-align:center;background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:30px 22px;box-shadow:var(--shadow-sm);transition:transform .24s var(--ease),box-shadow .24s var(--ease)}
  .persona-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
  .persona-ico{font-size:2.4rem;line-height:1;display:block;margin-bottom:12px}
  .persona-card h3{font-size:1.16rem;color:var(--green-800);margin:0 0 8px}
  .persona-card p{font-size:.94rem;color:var(--ink-soft);line-height:1.58;margin:0}
  .ba-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:18px}
  .ba-card{display:grid;grid-template-columns:1fr auto 1fr;align-items:stretch;gap:10px;background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:var(--shadow-sm)}
  .ba-before,.ba-after{border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:8px}
  .ba-before{background:var(--paper-warm)}
  .ba-after{background:linear-gradient(135deg, rgba(91,185,110,.14), rgba(34,169,224,.1));border:1px solid rgba(91,185,110,.3)}
  .ba-tag{align-self:flex-start;font-size:.68rem;font-weight:800;letter-spacing:.08em;color:var(--muted);background:#fff;border:1px solid var(--line);border-radius:999px;padding:2px 9px}
  .ba-tag--on{color:#fff;background:var(--ci-green-d);border-color:var(--ci-green-d)}
  .ba-before p,.ba-after p{margin:0;font-size:.96rem;line-height:1.5;color:var(--ink-soft)}
  .ba-after p b{color:var(--green-800)}
  .ba-arrow{display:grid;place-items:center;color:var(--ci-green-d);font-size:1.5rem;font-weight:800}
  @media(max-width:420px){.ba-card{grid-template-columns:1fr}.ba-arrow{transform:rotate(90deg)}}
  /* 교육 현장 */
  .onsite-photo{position:relative;border-radius:18px;overflow:hidden;box-shadow:var(--shadow);margin:0 0 26px;aspect-ratio:16/9}
  .onsite-photo img{width:100%;height:100%;object-fit:cover;display:block}
  .onsite-photo figcaption{position:absolute;left:0;right:0;bottom:0;padding:48px 28px 22px;color:#fff;font-size:1.02rem;font-weight:600;background:linear-gradient(to top, rgba(11,33,25,.88), rgba(11,33,25,.2) 70%, transparent)}
  .onsite-highlights{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .onsite-hl{text-align:center;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:26px 20px;box-shadow:var(--shadow-sm);transition:transform .22s var(--ease),box-shadow .22s var(--ease)}
  .onsite-hl:hover{transform:translateY(-4px);box-shadow:var(--shadow)}
  .onsite-hl .oh-ico{font-size:2rem;line-height:1;display:block;margin-bottom:10px}
  .onsite-hl h4{margin:0 0 6px;color:var(--green-800);font-size:1.08rem}
  .onsite-hl p{margin:0;color:var(--ink-soft);font-size:.92rem;line-height:1.55}
  @media(max-width:720px){.onsite-highlights{grid-template-columns:1fr}.onsite-photo{aspect-ratio:4/3}}
  /* 수료생 소속기관 로고 — 좌우로 흐르는 마퀴 */
  .logo-marquee{position:relative;overflow:hidden;padding:8px 0;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
  .logo-track{display:flex;width:max-content;animation:logo-scroll 34s linear infinite}
  .logo-marquee:hover .logo-track{animation-play-state:paused}
  .logo-item{flex:0 0 auto;margin-right:64px;height:60px;display:flex;align-items:center;justify-content:center}
  .logo-item img{height:60px;width:auto;object-fit:contain}
  .logo-item .logo-text{font-weight:700;color:var(--green-800);font-size:1.15rem;white-space:nowrap;letter-spacing:-.3px}
  @keyframes logo-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @media (prefers-reduced-motion: reduce){.logo-track{animation:none;flex-wrap:wrap;justify-content:center;gap:28px 48px;width:auto}.logo-item{margin-right:0}}
  /* 수료생 현황 차트 */
  .stat-total{text-align:center;margin-bottom:30px}
  .stat-total .st-num{font-size:clamp(2.4rem,7vw,3.6rem);font-weight:800;color:var(--ci-green-d);line-height:1}
  .stat-total .st-cap{display:block;color:var(--ink-soft);font-size:1.02rem;margin-top:8px}
  .stat-charts{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  .stat-chart{background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:26px 28px;box-shadow:var(--shadow-sm)}
  .stat-chart-title{font-size:1.1rem;color:var(--green-800);margin:0 0 18px;font-weight:800}
  .bar-list{list-style:none;margin:0;padding:0;display:grid;gap:14px}
  .bar-list li{display:grid;grid-template-columns:104px 1fr 44px;align-items:center;gap:10px}
  .bar-label{font-size:.9rem;color:var(--ink-soft);text-align:right;line-height:1.3}
  .bar-track{background:var(--paper-warm);border-radius:999px;height:14px;overflow:hidden}
  .bar-fill{display:block;height:100%;border-radius:999px;transition:width .6s var(--ease)}
  .bar-pct{font-size:.86rem;font-weight:800;color:var(--green-800);text-align:right}
  .bar-c0{background:var(--ci-green)}.bar-c1{background:var(--ci-blue)}.bar-c2{background:var(--ci-orange)}.bar-c3{background:var(--gold-500)}.bar-c4{background:#7fae8d}.bar-c5{background:#9aa6b0}
  /* 도넛(파이) 차트 */
  .donut-chart{display:flex;align-items:center;gap:26px;flex-wrap:wrap;justify-content:center}
  .donut-svg{width:188px;height:188px;flex:0 0 auto}
  .donut-legend{list-style:none;margin:0;padding:0;display:grid;gap:11px;min-width:170px;flex:1}
  .donut-legend li{display:grid;grid-template-columns:14px 1fr auto;align-items:center;gap:10px}
  .dl-sw{width:14px;height:14px;border-radius:4px;display:inline-block}
  .dl-label{font-size:.92rem;color:var(--ink-soft);line-height:1.3}
  .dl-val{font-size:.9rem;font-weight:800;color:var(--green-800)}
  @media(max-width:520px){.donut-chart{flex-direction:column}}
  @media(max-width:760px){.stat-charts{grid-template-columns:1fr}}
  @media(max-width:420px){.bar-list li{grid-template-columns:84px 1fr 40px}}
  /* PROJECT 04 대표(협력) 프로젝트 */
  .proj-feature{margin-top:22px;background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:30px 32px;box-shadow:var(--shadow-sm);border-top:5px solid var(--ci-orange-d)}
  .proj-feature-tags{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
  .pf-no{font-size:.76rem;font-weight:800;letter-spacing:.08em;color:var(--ci-orange-d)}
  .pf-badge{font-size:.76rem;font-weight:800;color:#fff;background:var(--green-700);border-radius:999px;padding:4px 12px}
  .proj-feature-title{font-size:clamp(1.3rem,3vw,1.7rem);font-weight:800;color:var(--green-800);margin:0 0 10px;letter-spacing:-.5px}
  .proj-feature-title b{color:var(--ci-orange-d)}
  .proj-feature-lede{color:var(--ink-soft);font-size:1rem;line-height:1.7;margin:0}
  .proj-feature-lede b{color:var(--green-800)}
  .proj-feature-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:24px 0}
  .pf-step{display:flex;gap:12px;background:var(--paper-warm);border:1px solid var(--line);border-radius:12px;padding:16px}
  .pf-step-no{flex:0 0 auto;font-size:1.1rem;font-weight:800;color:var(--ci-orange-d)}
  .pf-step h4{margin:0 0 5px;font-size:.98rem;color:var(--green-800)}
  .pf-step p{margin:0;font-size:.86rem;color:var(--ink-soft);line-height:1.5}
  .proj-feature-impact{display:flex;gap:14px;align-items:center;background:linear-gradient(135deg, rgba(205,155,76,.12), rgba(91,185,110,.1));border:1px solid rgba(205,155,76,.3);border-radius:12px;padding:16px 20px}
  .pf-impact-ico{font-size:1.8rem;line-height:1}
  .proj-feature-impact p{margin:0;font-size:.98rem;line-height:1.6;color:var(--ink-soft)}
  .proj-feature-impact p b{color:var(--green-800)}
  @media(max-width:860px){.proj-feature-steps{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:480px){.proj-feature-steps{grid-template-columns:1fr}.proj-feature{padding:24px 20px}}
  .point-list{display:grid;gap:16px}
  .point-row{display:flex;gap:22px;align-items:flex-start;background:var(--paper);border:1px solid var(--line);border-left:4px solid var(--ci-blue);border-radius:16px;padding:26px 30px;box-shadow:var(--shadow-sm);transition:transform .22s var(--ease),box-shadow .22s var(--ease)}
  .point-row:hover{transform:translateX(4px);box-shadow:var(--shadow)}
  .point-no{flex:0 0 auto;font-size:1.7rem;font-weight:800;color:var(--ci-blue-d);line-height:1;min-width:46px}
  .point-body h3{font-size:1.22rem;color:var(--green-800);margin:0 0 7px}
  .point-body p{margin:0;color:var(--ink-soft);font-size:1rem;line-height:1.62}
  .point-body p b{color:var(--green-800)}
  .faq-list{display:grid;gap:12px;max-width:820px;margin:0 auto}
  .faq-item{background:var(--paper);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow-sm);overflow:hidden}
  .faq-item summary{cursor:pointer;list-style:none;padding:18px 22px;font-weight:700;color:var(--green-800);font-size:1.02rem;display:flex;align-items:center;justify-content:space-between;gap:12px}
  .faq-item summary::-webkit-details-marker{display:none}
  .faq-item summary::after{content:"+";color:var(--ci-orange-d);font-size:1.4rem;font-weight:800;transition:transform .2s}
  .faq-item[open] summary::after{transform:rotate(45deg)}
  .faq-a{padding:0 22px 20px;color:var(--ink-soft);font-size:.98rem;line-height:1.68}
  .faq-a b{color:var(--green-800)}
  .faq-more{text-align:center;margin:22px 0 0;color:var(--muted)}
  .faq-more a{color:var(--ci-green-d);font-weight:700}
  .final-cta{text-align:center;color:#fff;padding:clamp(56px,8vw,92px) 0;background:radial-gradient(120% 130% at 50% 0%, #1f5540, #0e2a20 70%);position:relative;overflow:hidden}
  .final-cta::after{content:"";position:absolute;left:50%;bottom:-120px;width:460px;height:460px;transform:translateX(-50%);background:radial-gradient(circle, rgba(205,155,76,.18), transparent 68%)}
  .final-cta .container{position:relative;z-index:1}
  .final-cta h2{font-size:clamp(1.5rem,3.6vw,2.2rem);font-weight:800;margin:0 0 14px;letter-spacing:-.5px}
  .final-cta p{color:rgba(255,255,255,.88);font-size:1.05rem;line-height:1.7;margin:0 0 28px}
  .final-cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  /* 핵심 역량 배너 */
  .lp-band{text-align:center;color:#fff;padding:clamp(48px,7vw,78px) 0;background:radial-gradient(120% 130% at 50% 0%, #1f5540, #0e2a20 72%);position:relative;overflow:hidden}
  .lp-band::after{content:"";position:absolute;left:50%;top:-100px;width:420px;height:420px;transform:translateX(-50%);background:radial-gradient(circle, rgba(205,155,76,.2), transparent 68%);pointer-events:none}
  .lp-band .container{position:relative;z-index:1}
  .lp-band-lead{font-size:clamp(1.1rem,2.6vw,1.5rem);font-weight:700;color:#e9efe9;margin:0 0 8px}
  .lp-band-title{font-size:clamp(1.7rem,4.4vw,2.6rem);font-weight:800;margin:0 0 14px;letter-spacing:-.5px}
  .lp-band-title b{color:#ffd98a}
  .lp-band-sub{color:rgba(255,255,255,.82);font-size:1.02rem;line-height:1.7;max-width:620px;margin:0 auto 26px}
  .lp-band-sub b{color:#ffe6b0}
  .lp-band-stack{list-style:none;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin:0;padding:0}
  .lp-band-stack li{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:11px 20px;font-weight:700;font-size:.96rem}
  .lp-sticky{position:fixed;left:0;right:0;bottom:0;z-index:90;display:flex;align-items:center;justify-content:space-between;gap:14px;background:rgba(14,42,32,.97);color:#fff;padding:12px 18px;box-shadow:0 -6px 24px rgba(0,0,0,.25);transform:translateY(110%);transition:transform .3s var(--ease)}
  .lp-sticky.is-show{transform:translateY(0)}
  .lp-sticky-text{font-weight:800;font-size:1rem}
  .lp-sticky .btn{padding:11px 22px;white-space:nowrap}
  @media(max-width:420px){.lp-sticky-text{font-size:.9rem}.lp-sticky{padding:10px 14px}}
</style>

<!-- 히어로 -->
<section class="lp-hero">
  <div class="container">
    <span class="lp-hero-eyebrow">AI UTILIZATION EXPERT COURSE</span>
    <h1 class="lp-hero-title">누구나 쓰는 AI,<br><strong>나의 무기</strong>로 만드세요</h1>
    <p class="lp-hero-sub">생성형 AI와 AI 에이전트를 업무·일상에 활용하는 실무 역량을 기릅니다.<br>시민·직장인·소상공인·공공기관까지, 코딩 없이 <b>프롬프트만으로</b> 시작하는 단계별 AI 교육.</p>
    <div class="lp-hero-cta">
      <a class="btn btn-primary btn-lg" href="/learn/apply">교육 신청하기 →</a>
      <a class="btn btn-ghost-light btn-lg" href="#curriculum">커리큘럼 보기</a>
    </div>
    <ul class="lp-hero-tags">
      <li>✓ 실습 100% 프로젝트</li>
      <li>✓ 코딩 몰라도 OK</li>
      <li>✓ 현장 전문가 멘토링</li>
      <li>✓ 수료 후 커뮤니티</li>
    </ul>
  </div>
</section>

<!-- 과정 한눈에 -->
<section class="section" id="facts" style="padding-top:38px">
  <div class="container">
    <div class="course-facts">
      <div class="cf-item"><span class="cf-label">교육 대상</span><span class="cf-value">시민 · 직장인 · 소상공인 · 공공/기관</span></div>
      <div class="cf-item"><span class="cf-label">교육 방식</span><span class="cf-value">실시간 온라인 + 실습 프로젝트</span></div>
      <div class="cf-item"><span class="cf-label">과정 구성</span><span class="cf-value">입문 → 활용 → 실무 → 전문가</span></div>
      <div class="cf-item"><span class="cf-label">수료 혜택</span><span class="cf-value">수료증 · AI 활용 커뮤니티 · 멘토링</span></div>
    </div>
  </div>
</section>

<!-- 공감 · 이런 고민 -->
<section class="section section--alt" id="pain">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">혹시, 이런 고민 있으셨나요?</h2><span class="section-en">YOUR PAIN POINTS</span></div>
    </div>
    <p class="section-lede">AI가 중요하다는 건 알지만, <strong>막상 내 일에 어떻게 써야 할지</strong> 막막하셨다면 — 이 과정이 그 답을 드립니다.</p>
    <div class="pain-grid">
      <article class="pain-card"><span class="pain-q">Q</span><p>“보고서·문서 작업에 <b>시간이 너무 많이</b> 들어요.”</p></article>
      <article class="pain-card"><span class="pain-q">Q</span><p>“AI가 좋다는데 <b>어디부터 써야 할지</b> 모르겠어요.”</p></article>
      <article class="pain-card"><span class="pain-q">Q</span><p>“우리 가게·우리 동네에 <b>AI를 어떻게 활용</b>하죠?”</p></article>
      <article class="pain-card"><span class="pain-q">Q</span><p>“<b>코딩을 몰라도</b> AI를 제대로 쓸 수 있을까요?”</p></article>
    </div>
    <p class="pain-answer">걱정 마세요. <b>프롬프트 기초부터 실무 프로젝트까지</b>, 직접 해보며 익히면 누구나 할 수 있습니다.</p>
  </div>
</section>

<!-- 이런 분께 추천 -->
<section class="section" id="who">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-blue">이런 분께 추천합니다</h2><span class="section-en">FOR WHOM</span></div>
    </div>
    <div class="persona-grid">
      <article class="persona-card"><span class="persona-ico">💼</span><h3>직장인</h3><p>반복되는 문서·데이터·보고 업무를 AI로 자동화하고 싶은 분</p></article>
      <article class="persona-card"><span class="persona-ico">🏪</span><h3>소상공인·자영업</h3><p>마케팅·콘텐츠·고객 응대에 AI를 바로 활용하고 싶은 분</p></article>
      <article class="persona-card"><span class="persona-ico">🏛️</span><h3>공공·기관 담당자</h3><p>행정·민원·교육·복지 현장에 AI를 접목하고 싶은 분</p></article>
      <article class="persona-card"><span class="persona-ico">🌱</span><h3>시민·입문자</h3><p>AI가 처음이라도 일상과 학습에 똑똑하게 쓰고 싶은 분</p></article>
    </div>
  </div>
</section>

<!-- 교육 체계 · 단계 -->
<section class="section section--alt" id="ladder">
  <div class="container">
    <div class="section-head">
