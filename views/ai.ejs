<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <span class="page-banner-en">AI UTILIZATION EXPERT COURSE</span>
    <h1 class="page-banner-title">AI활용전문가과정</h1>
    <p class="page-banner-desc">생성형 AI와 AI 에이전트를 업무·일상에 활용하는 실무 역량을 기릅니다. 시민·직장인·소상공인·공공기관까지, 눈높이에 맞춘 단계별 AI 교육으로 <strong>누구나 AI 전문가</strong>가 됩니다.</p>
  </div>
</section>

<!-- 과정 한눈에 -->
<section class="section" id="facts" style="padding-top:34px">
  <div class="container">
    <div class="course-facts">
      <div class="cf-item"><span class="cf-label">교육 대상</span><span class="cf-value">시민 · 직장인 · 소상공인 · 공공/기관 담당자</span></div>
      <div class="cf-item"><span class="cf-label">교육 방식</span><span class="cf-value">실시간 온라인 + 실습 프로젝트</span></div>
      <div class="cf-item"><span class="cf-label">과정 구성</span><span class="cf-value">입문 → 활용 → 실무 → 전문가 단계별</span></div>
      <div class="cf-item"><span class="cf-label">수료 혜택</span><span class="cf-value">수료증 · AI 활용 커뮤니티 · 멘토링</span></div>
    </div>
  </div>
</section>

<!-- 왜 지금 AI인가 -->
<section class="section section--alt" id="why">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">왜 지금 AI인가</h2><span class="section-en">WHY AI NOW</span></div>
    </div>
    <p class="section-lede">생성형 AI는 업무·학습·창작의 방식을 바꾸고 있습니다. <strong>AI 활용 역량이 곧 경쟁력</strong>인 시대, 도시공동체본부는 시민·현장 중심의 실용 AI 교육을 제공합니다.</p>
    <div class="sgrid sgrid--green">
      <article class="scard"><h4>생성형 AI 대전환</h4><p>ChatGPT·Claude·Gemini 등 생성형 AI가 <strong>일하는 방식 자체</strong>를 바꾸고 있습니다.</p></article>
      <article class="scard"><h4>업무 생산성 혁신</h4><p>문서·데이터·보고서 작업을 AI로 자동화해 <strong>생산성을 크게</strong> 높일 수 있습니다.</p></article>
      <article class="scard"><h4>공공·지역 확산</h4><p>행정·교육·복지·소상공인 현장까지 <strong>AI 활용 수요</strong>가 빠르게 늘고 있습니다.</p></article>
      <article class="scard"><h4>누구나 쓰는 AI</h4><p>코딩 없이 <strong>프롬프트만으로</strong> 전문 업무를 수행하는 시대가 열렸습니다.</p></article>
    </div>
  </div>
</section>

<!-- 교육 체계 · 단계 -->
<section class="section" id="ladder">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-blue">교육 체계 · 단계별 과정</h2><span class="section-en">LEARNING PATH</span></div>
    </div>
    <p class="section-lede">AI <strong>입문 → 활용 → 실무 → 전문가</strong>로 이어지는 단계별 학습 사다리로, 처음 접하는 분부터 현업 담당자까지 눈높이에 맞춰 설계합니다.</p>

    <ol class="esg-flow" aria-label="AI 학습 단계">
      <li><span class="ef-no">STEP 1</span><h3>입문</h3><p>AI 이해 · 프롬프트 기초</p></li>
      <li><span class="ef-no">STEP 2</span><h3>활용</h3><p>문서·이미지·데이터 생성</p></li>
      <li><span class="ef-no">STEP 3</span><h3>실무</h3><p>업무 자동화 · AI 에이전트</p></li>
      <li><span class="ef-no">STEP 4</span><h3>전문가</h3><p>프로젝트 · 강사·컨설턴트</p></li>
    </ol>

    <div class="esg-mods" style="margin-top:30px">
      <article class="esg-mod esg-mod--green"><div class="esg-mod-head"><span class="esg-mod-no">대상 A</span><h3 class="esg-mod-title">시민 · AI 입문</h3></div><ul class="esg-mod-list"><li>생성형 AI 개념과 안전한 사용법</li><li>일상·학습에 AI 활용하기</li></ul></article>
      <article class="esg-mod esg-mod--blue"><div class="esg-mod-head"><span class="esg-mod-no">대상 B</span><h3 class="esg-mod-title">직장인 · 업무 실무</h3></div><ul class="esg-mod-list"><li>문서·보고서·데이터 업무 자동화</li><li>직무별 AI 활용 워크플로</li></ul></article>
      <article class="esg-mod esg-mod--blue"><div class="esg-mod-head"><span class="esg-mod-no">대상 C</span><h3 class="esg-mod-title">소상공인 · 자영업</h3></div><ul class="esg-mod-list"><li>마케팅·콘텐츠·고객응대 AI 활용</li><li>매출·운영에 바로 쓰는 실전 도구</li></ul></article>
      <article class="esg-mod esg-mod--feature"><div class="esg-mod-head"><span class="esg-mod-no">대상 D</span><h3 class="esg-mod-title">AI 활용 전문가·강사</h3><span class="esg-mod-badge">전문가</span></div><ul class="esg-mod-list"><li>AI 에이전트·자동화 심화</li><li>강사·컨설턴트 양성 트랙</li></ul></article>
    </div>
  </div>
</section>

<!-- 핵심 커리큘럼 -->
<section class="section section--alt" id="curriculum">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">핵심 커리큘럼</h2><span class="section-en">CURRICULUM</span></div>
    </div>
    <p class="section-lede">이론을 넘어 <strong>직접 해보며 익히는</strong> 실습 중심 커리큘럼. 프롬프트 기초부터 AI 에이전트 자동화까지 현장에서 바로 쓰는 역량을 기릅니다.</p>
    <%
      const curriculum = [
        { no: "01", title: "프롬프트 엔지니어링 기초", items: ["AI와 대화하는 법(역할·맥락·지시)", "좋은 프롬프트 설계 원리", "AI별 특징과 선택 기준"] },
        { no: "02", title: "문서·콘텐츠 생성", items: ["보고서·기획서·공문 작성", "요약·번역·교정 자동화", "이미지·카드뉴스 생성"] },
        { no: "03", title: "데이터 분석·시각화", items: ["스프레드시트·엑셀 AI 활용", "데이터 요약·차트 만들기", "인사이트 도출과 해석"] },
        { no: "04", title: "업무 자동화 · AI 에이전트", items: ["반복 업무 자동화 설계", "도구 연동(MCP)과 워크플로", "나만의 업무 도우미 구축"] },
        { no: "05", title: "AI 리포트 자동화", items: ["정기 보고·대시보드 자동화", "메일·메시지 자동 발송", "운영 데이터 모니터링"] },
        { no: "06", title: "지역·공공 AI 활용", featured: true, items: ["행정·민원 문서 작성 지원", "교육·복지 현장 적용 사례", "소상공인 마케팅 실전"] }
      ];
    %>
    <div class="esg-mods">
      <% curriculum.forEach(function(m){ %>
        <article class="esg-mod esg-mod--green<%= m.featured ? ' esg-mod--feature' : '' %>">
          <div class="esg-mod-head"><span class="esg-mod-no"><%= m.no %></span><h3 class="esg-mod-title"><%= m.title %></h3><% if (m.featured) { %><span class="esg-mod-badge">대표</span><% } %></div>
          <ul class="esg-mod-list"><% m.items.forEach(function(it){ %><li><%= it %></li><% }); %></ul>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- 실무 프로젝트 -->
<section class="section" id="projects">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-orange">실무 프로젝트</h2><span class="section-en">PROJECTS</span></div>
    </div>
    <p class="section-lede">배운 내용을 <strong>내 업무·우리 지역</strong>에 직접 적용하는 프로젝트로 과정을 마무리합니다. 완성한 결과물은 그대로 현업에서 활용할 수 있습니다.</p>
    <%
      const projects = [
        { lv: "PROJECT 01", title: "업무 자동화 도우미", cls: "green", items: ["반복 업무 흐름 분석", "AI 에이전트 설계", "나만의 업무 도우미 완성"] },
        { lv: "PROJECT 02", title: "데이터 분석·자동 보고", cls: "blue", items: ["실데이터 수집·정리", "AI 분석과 인사이트", "자동 보고서·대시보드"] },
        { lv: "PROJECT 03", title: "지역·현장 문제 해결", cls: "orange", items: ["현장 문제 정의", "AI 활용 해결안 설계", "결과 공유·발표"] }
      ];
    %>
    <div class="esg-mods esg-mods--3">
      <% projects.forEach(function(m){ %>
        <article class="esg-mod esg-mod--<%= m.cls %>">
          <div class="esg-mod-head"><span class="esg-mod-no"><%= m.lv %></span><h3 class="esg-mod-title"><%= m.title %></h3></div>
          <ul class="esg-mod-list"><% m.items.forEach(function(it){ %><li><%= it %></li><% }); %></ul>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- 과정 특장점 -->
<section class="section section--alt" id="strength">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-blue">도시공동체본부 AI 교육의 강점</h2><span class="section-en">WHY US</span></div>
    </div>
    <div class="esg-diff">
      <article class="esg-diff-card"><h3>실습 100%</h3><p>이론보다 <strong>직접 해보며</strong> 익히는 프로젝트 중심 교육으로, 수료 즉시 현업에 적용합니다.</p></article>
      <article class="esg-diff-card"><h3>눈높이 맞춤</h3><p>비전공·입문자도 따라올 수 있는 <strong>단계별 설계</strong>로, 처음이어도 완주할 수 있습니다.</p></article>
      <article class="esg-diff-card"><h3>전문가 멘토링</h3><p>현업 전문가의 <strong>밀착 피드백</strong>으로 막히는 지점을 바로 해결합니다.</p></article>
      <article class="esg-diff-card"><h3>수료 후 커뮤니티</h3><p>AI 활용 네트워크에서 <strong>지속적으로 성장</strong>하고 함께 배웁니다.</p></article>
    </div>
  </div>
</section>

<!-- 신청 안내 -->
<section class="section" id="apply">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">신청 안내</h2><span class="section-en">HOW TO APPLY</span></div>
    </div>
    <p class="section-lede">아래 절차에 따라 간편하게 신청하실 수 있습니다. 과정·일정·수강료 등 자세한 내용은 교육 문의로 안내해 드립니다.</p>
    <ol class="esg-flow esg-flow--apply" aria-label="신청 절차">
      <li><span class="ef-no">STEP 1</span><h3>교육 신청</h3><p>신청 폼 작성</p></li>
      <li><span class="ef-no">STEP 2</span><h3>상담 안내</h3><p>과정·일정 안내</p></li>
      <li><span class="ef-no">STEP 3</span><h3>등록</h3><p>수강 확정</p></li>
      <li><span class="ef-no">STEP 4</span><h3>교육 시작</h3><p>실습·프로젝트</p></li>
    </ol>

    <div class="solar-closing">
      <p><strong>AI는 더 이상 전문가만의 도구가 아닙니다.</strong> 시민·직장인·소상공인·공공기관 누구나 AI를 업무와 일상에 활용할 수 있도록, 도시공동체본부가 함께합니다.</p>
      <div class="region-cta" style="justify-content:center">
        <a class="btn btn-primary" href="/learn/apply">교육 신청하기</a>
        <a class="btn btn-ghost" href="/#contact">교육·컨설팅 문의</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
