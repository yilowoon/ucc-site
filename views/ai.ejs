<% if (typeof aiStats !== 'undefined' && aiStats) { %>
<!-- 수료생 현황 -->
<section class="section" id="stats">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">수료생 현황</h2><span class="section-en">BY THE NUMBERS</span></div>
    </div>
    <div class="stat-total"><span class="st-num"><%= aiStats.total.toLocaleString() %>명</span><span class="st-cap">지금까지 도시공동체본부 AI 교육과 함께한 수료생</span></div>
    <div class="stat-charts">
      <div class="stat-chart">
        <h3 class="stat-chart-title">신청자 직무 현황</h3>
        <ul class="bar-list">
          <% aiStats.jobs.forEach(function(r,i){ %>
            <li><span class="bar-label"><%= esc(r.label) %></span><span class="bar-track"><span class="bar-fill bar-c<%= i%6 %>" style="width:<%= r.pct %>%"></span></span><span class="bar-pct"><%= r.pct %>%</span></li>
          <% }); %>
        </ul>
      </div>
      <div class="stat-chart">
        <h3 class="stat-chart-title">지원자 기업 유형</h3>
        <%
          var DCOL = ['var(--ci-green)','var(--ci-blue)','var(--ci-orange)','var(--gold-500)','#7fae8d','#9aa6b0'];
          var C = 502.65; // 2πr (r=80)
          var cTotal = aiStats.companies.reduce(function(s,r){ return s + (Number(r.pct)||0); }, 0) || 1;
          var cum = 0;
        %>
        <div class="donut-chart">
          <svg viewBox="0 0 220 220" class="donut-svg" role="img" aria-label="지원자 기업 유형 도넛 차트">
            <circle cx="110" cy="110" r="80" fill="none" stroke="var(--line)" stroke-width="34"/>
            <% aiStats.companies.forEach(function(r,i){ var frac=(Number(r.pct)||0)/cTotal; var segLen=frac*C; %>
              <circle cx="110" cy="110" r="80" fill="none" stroke="<%= DCOL[i%6] %>" stroke-width="34"
                stroke-dasharray="<%= segLen.toFixed(2) %> <%= C.toFixed(2) %>"
                stroke-dashoffset="<%= (-cum*C).toFixed(2) %>" transform="rotate(-90 110 110)"/>
              <% cum += frac; %>
            <% }); %>
          </svg>
          <ul class="donut-legend">
            <% aiStats.companies.forEach(function(r,i){ %>
              <li><span class="dl-sw" style="background:<%= DCOL[i%6] %>"></span><span class="dl-label"><%= esc(r.label) %></span><span class="dl-val"><%= r.pct %>%</span></li>
            <% }); %>
          </ul>
        </div>
      </div>
    </div>
    <p style="text-align:center;margin-top:16px;color:var(--muted);font-size:.86rem">※ 분포는 누적 수료생 기준이며, 집계에 따라 업데이트됩니다.</p>
  </div>
</section>
<% } %>

