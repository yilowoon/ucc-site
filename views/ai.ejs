<!-- 모바일 고정 신청 바 -->
<div class="lp-sticky" id="lpSticky" aria-hidden="true">
  <span class="lp-sticky-text">AI활용전문가과정</span>
  <a class="btn btn-primary" href="/learn/apply">교육 신청하기</a>
</div>
<script>
(function(){
  var bar=document.getElementById('lpSticky'); if(!bar) return;
  function onScroll(){ if(window.scrollY>600) bar.classList.add('is-show'); else bar.classList.remove('is-show'); }
  window.addEventListener('scroll', onScroll, {passive:true}); onScroll();
})();
</script>

