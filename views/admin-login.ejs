<%- include('partials/header') %>
<div class="container admin-auth-wrap">
  <div class="admin-auth-card">
    <h1>관리자 로그인</h1>
    <p class="admin-auth-sub">게시물 작성·수정·삭제는 관리자만 가능합니다.</p>
    <% if (error) { %><p class="form-alert err"><%= error %></p><% } %>
    <form method="post" action="/admin/login" class="admin-form-fields">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="next" value="<%= esc(next) %>" />
      <div class="field">
        <label for="username">아이디</label>
        <input type="text" id="username" name="username" autocomplete="username" required autofocus />
      </div>
      <div class="field">
        <label for="password">비밀번호</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required />
      </div>
      <button type="submit" class="btn btn-primary btn-block">로그인</button>
    </form>
    <p class="admin-auth-hint">최초 비밀번호는 <code>data/INITIAL_ADMIN_PASSWORD.txt</code> 파일에서 확인할 수 있습니다.</p>
  </div>
</div>
<%- include('partials/footer') %>
