<%
  // groups: [{ key, label, cls, note, list }]  — 1개면 탭 없이 단일 섹션, 2개면 정회원/준회원 탭
%>
<style>
  .reg-detail-link{color:var(--green-600);font-weight:700;text-decoration:none}
  .reg-detail-link:hover{text-decoration:underline}
  .reg-detail-arrow{color:var(--gold-500);font-weight:800}
  .reg-row-link{cursor:pointer}
  .reg-row-link:hover{background:var(--paper-warm)}
</style>
<section class="mi-members">
  <% if (groups.length > 1) { %>
    <div class="seg mi-tabs" role="tablist">
      <% groups.forEach(function(g, i){ %>
        <button type="button" class="seg-btn <%= i===0 ? 'on' : '' %>" role="tab" data-tab="<%= g.key %>" aria-selected="<%= i===0 ? 'true' : 'false' %>">
          <%= g.label %> <span class="mi-count">(<%= g.list.length %>)</span>
        </button>
      <% }); %>
    </div>
  <% } %>

  <% groups.forEach(function(g, i){ %>
    <div class="mi-panel" id="miPanel-<%= g.key %>" role="tabpanel" <%= i===0 ? '' : 'hidden' %>>
      <p class="reg-members-desc"><span class="grade-badge <%= g.cls %>"><%= g.label %></span> <%= g.note %> · <strong><%= g.list.length %></strong>명</p>
      <div class="reg-table-wrap">
        <table class="reg-table">
          <thead>
            <tr><th>회원유형</th><th>이름</th><th>소속</th><th>직급</th><th>관심분야</th><th>회원가입일</th><th>회원자격</th></tr>
          </thead>
          <tbody>
            <% if (!g.list.length) { %>
              <tr><td colspan="7" class="reg-empty">해당하는 회원이 없습니다.</td></tr>
            <% } %>
            <% g.list.forEach(function(m){ %>
              <tr<% if (m.member_type === '기업회원') { %> class="reg-row-link" data-href="/members/company/<%= m.id %>"<% } %>>
                <td><%= esc(m.member_type) %></td>
                <td class="reg-name"><%= esc(m.name) %></td>
                <td>
                  <% if (m.member_type === '기업회원') { %>
                    <a class="reg-detail-link" href="/members/company/<%= m.id %>"><%= esc(m.org_name || '(상세보기)') %> <span class="reg-detail-arrow" aria-hidden="true">›</span></a>
                  <% } else { %><%= esc(m.org_name || '-') %><% } %>
                </td>
                <td><%= esc(m.position || '-') %></td>
                <td><%= esc(m.interest || '-') %></td>
                <td class="reg-date"><%= fmtDate(m.created_at) %></td>
                <td><span class="grade-badge <%= m.grade === '정회원' ? 'grade-full' : 'grade-assoc' %>"><%= esc(m.grade || '준회원') %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% }); %>
</section>

<script>
  (function(){
    // 기업회원 행 클릭 시 상세로 이동(셀 안 링크·버튼 클릭은 제외)
    document.querySelectorAll('.reg-row-link').forEach(function(tr){
      tr.addEventListener('click', function(e){
        if (e.target.closest('a,button')) return;
        var href = tr.getAttribute('data-href');
        if (href) window.location.href = href;
      });
    });
    var tabs = document.querySelectorAll('.mi-tabs .seg-btn');
    if (!tabs.length) return;
    tabs.forEach(function(btn){
      btn.addEventListener('click', function(){
        var key = btn.getAttribute('data-tab');
        tabs.forEach(function(b){
          var on = b === btn;
          b.classList.toggle('on', on);
          b.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        document.querySelectorAll('.mi-panel').forEach(function(p){
          p.hidden = (p.id !== 'miPanel-' + key);
        });
      });
    });
  })();
</script>
