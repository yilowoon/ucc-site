<style>
  /* 배움터 과정 랜딩 — 전환형 컴포넌트(공용) */
  .btn-ghost-light{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.5)}
  .btn-ghost-light:hover{background:rgba(255,255,255,.18);border-color:#fff;color:#fff;transform:translateY(-2px)}
  .lp-hero{position:relative;overflow:hidden;color:#fff;text-align:center;background:radial-gradient(120% 130% at 50% -10%, #1f5540 0%, #123a2e 46%, #0e2a20 100%);padding:clamp(64px,9vw,110px) 0 clamp(54px,7vw,88px)}
  .lp-hero::after{content:"";position:absolute;left:50%;top:-80px;width:420px;height:420px;transform:translateX(-50%);background:radial-gradient(circle, rgba(205,155,76,.26), transparent 68%);pointer-events:none}
  .lp-hero .container{position:relative;z-index:1}
  .lp-hero-eyebrow{display:inline-block;font-size:.78rem;letter-spacing:.22em;font-weight:800;color:var(--gold-400);margin-bottom:18px}
  .lp-hero-title{font-size:clamp(2rem,5.6vw,3.4rem);font-weight:800;line-height:1.22;letter-spacing:-1px;margin:0 0 18px}
  .lp-hero-title strong{color:#ffd98a}
  .lp-hero-sub{font-size:clamp(1rem,2.2vw,1.18rem);line-height:1.7;color:rgba(255,255,255,.9);margin:0 auto 30px;max-width:700px}
  .lp-hero-sub b{color:#ffe6b0;font-weight:700}
  .lp-hero-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .lp-hero-tags{list-style:none;display:flex;gap:10px 22px;justify-content:center;flex-wrap:wrap;margin:30px 0 0;padding:0}
  .lp-hero-tags li{font-size:.92rem;font-weight:600;color:rgba(255,255,255,.82)}
  .pain-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}
  .pain-card{display:flex;gap:14px;align-items:flex-start;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:22px;box-shadow:var(--shadow-sm)}
  .pain-card .pain-q{flex:0 0 auto;width:32px;height:32px;border-radius:50%;background:var(--ci-green);color:#fff;font-weight:800;display:grid;place-items:center;font-size:.95rem}
  .pain-card p{margin:0;color:var(--ink-soft);font-size:1rem;line-height:1.55;padding-top:3px}
  .pain-card p b{color:var(--green-800)}
  .pain-answer{text-align:center;margin:26px auto 0;font-size:1.08rem;font-weight:700;color:var(--green-800)}
  .pain-answer b{color:var(--ci-green-d)}
  .persona-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
  .persona-card{text-align:center;background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:30px 22px;box-shadow:var(--shadow-sm);transition:transform .24s var(--ease),box-shadow .24s var(--ease)}
  .persona-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
  .persona-ico{font-size:2.4rem;line-height:1;display:block;margin-bottom:12px}
  .persona-card h3{font-size:1.16rem;color:var(--green-800);margin:0 0 8px}
  .persona-card p{font-size:.94rem;color:var(--ink-soft);line-height:1.58;margin:0}
  .ba-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:18px}
  .ba-card{display:grid;grid-template-columns:1fr auto 1fr;align-items:stretch;gap:10px;background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:18px;box-shadow:var(--shadow-sm)}
  .ba-before,.ba-after{border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:8px}
  .ba-before{background:var(--paper-warm)}
  .ba-after{background:linear-gradient(135deg, rgba(91,185,110,.14), rgba(34,169,224,.1));border:1px solid rgba(91,185,110,.3)}
