  .lp-sticky{position:fixed;left:0;right:0;bottom:0;z-index:90;display:flex;align-items:center;justify-content:center;background:rgba(14,42,32,.97);color:#fff;padding:12px 88px 12px 24px;box-shadow:0 -6px 24px rgba(0,0,0,.25);transform:translateY(110%);transition:transform .3s var(--ease)}
  .lp-sticky.is-show{transform:translateY(0)}
  .lp-sticky-inner{display:flex;align-items:center;justify-content:center;gap:22px;flex-wrap:wrap;text-align:center}
  .lp-sticky-text{font-weight:700;font-size:1.02rem;line-height:1.45}
  .lp-sticky-text b{color:#ffd98a}
  .lp-sticky .btn{padding:11px 24px;white-space:nowrap}
  @media(max-width:560px){.lp-sticky-text{font-size:.84rem}.lp-sticky-inner{gap:10px}.lp-sticky{padding:9px 70px 9px 14px}}
</style>
