<%
  // 공유바 — 상세 페이지 상단. shareTitle(선택)로 공유 제목 지정.
  var _shareTitle = (typeof shareTitle !== 'undefined' && shareTitle) ? shareTitle : '';
%>
<div class="share-bar" role="group" aria-label="이 페이지 공유" data-title="<%= esc(_shareTitle) %>">
  <span class="share-label">공유</span>
  <button type="button" class="share-btn share-copy" data-share="copy" title="링크 복사" aria-label="링크 복사">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
  </button>
  <button type="button" class="share-btn share-kakao" data-share="kakao" title="카카오톡 공유" aria-label="카카오톡 공유">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3C6.9 3 2.8 6.3 2.8 10.3c0 2.6 1.7 4.9 4.3 6.2-.2.7-.7 2.5-.8 2.9 0 .2 0 .4.3.3.2-.1 2.7-1.8 3.7-2.5.6.1 1.1.1 1.7.1 5.1 0 9.2-3.3 9.2-7.3S17.1 3 12 3z"/></svg>
  </button>
  <button type="button" class="share-btn share-fb" data-share="facebook" title="페이스북 공유" aria-label="페이스북 공유">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h2.5l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.3C16.7.2 15.8.1 14.8.1 12.5.1 11 1.5 11 4.1V6H8.5v3H11v9h3V9z"/></svg>
  </button>
  <button type="button" class="share-btn share-x" data-share="x" title="X(트위터) 공유" aria-label="X 공유">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-7.1 8.1L23 22h-6.5l-5-6.6L5.8 22H2.7l7.6-8.7L1.5 2H8l4.5 6zM17.8 20.2h1.7L7.3 3.7H5.5z"/></svg>
  </button>
  <button type="button" class="share-btn share-ig" data-share="instagram" title="인스타그램 공유" aria-label="인스타그램 공유">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
  </button>
  <button type="button" class="share-btn share-more" data-share="native" title="더보기(기기 공유)" aria-label="더보기 공유" hidden>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.6" y1="10.5" x2="15.4" y2="6.5"/><line x1="8.6" y1="13.5" x2="15.4" y2="17.5"/></svg>
  </button>
</div>
<div class="share-toast" id="shareToast" role="status" aria-live="polite" hidden></div>

<% if (typeof kakaoKey !== 'undefined' && kakaoKey) { %>
  <script src="https://t1.kakaocdn.net/kakao_js_sdk/2.7.2/kakao.min.js"></script>
  <script>try{ if(window.Kakao && !Kakao.isInitialized()) Kakao.init('<%= kakaoKey %>'); }catch(e){}</script>
<% } %>
<script>
(function(){
  var bar = document.querySelector('.share-bar');
  if (!bar || bar.dataset.init) return;
  bar.dataset.init = '1';
  var toast = document.getElementById('shareToast');
  var moreBtn = bar.querySelector('[data-share="native"]');
  if (navigator.share && moreBtn) moreBtn.hidden = false;

  function pageUrl(){ return location.href; }
  function pageTitle(){ return (bar.getAttribute('data-title') || document.title.replace(/\s*[|｜].*$/, '') || document.title).trim(); }
  function showToast(msg){
    if (!toast) return;
    toast.textContent = msg; toast.hidden = false;
    clearTimeout(toast._t); toast._t = setTimeout(function(){ toast.hidden = true; }, 2200);
  }
  function fallbackCopy(u){
    try { var ta=document.createElement('textarea'); ta.value=u; ta.setAttribute('readonly',''); ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta); } catch(e){}
  }
  function copyLink(msg){
    var u = pageUrl();
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(u).then(function(){ showToast(msg); }, function(){ fallbackCopy(u); showToast(msg); });
    } else { fallbackCopy(u); showToast(msg); }
  }
  function nativeShare(){
    if (navigator.share) { navigator.share({ title: pageTitle(), url: pageUrl() }).catch(function(){}); return true; }
    return false;
  }
  function popup(url){ window.open(url, '_blank', 'noopener,noreferrer,width=600,height=520'); }

  bar.addEventListener('click', function(e){
    var b = e.target.closest('[data-share]'); if (!b) return;
    var kind = b.getAttribute('data-share');
    var u = encodeURIComponent(pageUrl()), t = encodeURIComponent(pageTitle());
    if (kind === 'copy') { copyLink('링크가 복사되었습니다.'); }
    else if (kind === 'facebook') { popup('https://www.facebook.com/sharer/sharer.php?u=' + u); }
    else if (kind === 'x') { popup('https://twitter.com/intent/tweet?url=' + u + '&text=' + t); }
    else if (kind === 'kakao') {
      if (window.Kakao && Kakao.Share && Kakao.isInitialized && Kakao.isInitialized()) {
        try {
          Kakao.Share.sendDefault({
            objectType: 'feed',
            content: { title: pageTitle(), description: '사단법인 도시공동체본부', imageUrl: location.origin + '/img/og.jpg',
              link: { mobileWebUrl: pageUrl(), webUrl: pageUrl() } }
          });
        } catch (err) { if (!nativeShare()) copyLink('링크를 복사했어요. 카카오톡에 붙여넣어 공유하세요.'); }
      } else if (!nativeShare()) { copyLink('링크를 복사했어요. 카카오톡에 붙여넣어 공유하세요.'); }
    }
    else if (kind === 'instagram') { if (!nativeShare()) copyLink('링크를 복사했어요. 인스타그램에 붙여넣어 공유하세요.'); }
    else if (kind === 'native') { nativeShare(); }
  });
})();
</script>
