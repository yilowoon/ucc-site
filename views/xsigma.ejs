<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>엑스시그마 플랫폼 · 사단법인 도시공동체본부</title>
<meta name="description" content="지역의 난제를 외부의 지식과 연결해 현장에서 검증하는 개방형 문제해결 플랫폼. 사단법인 도시공동체본부가 운영합니다.">
<link rel="icon" type="image/png" href="/img/ucc-symbol.png?v=2">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ─────────────────────────────────────────────
   토큰
   ───────────────────────────────────────────── */
:root{
  --ink:#0D211C;          /* 딥 포레스트 잉크 — 본부 로고 진녹 계열 */
  --ink-2:#14322A;
  --paper:#EFF0EA;        /* 쿨한 종이색 */
  --paper-2:#E4E6DD;
  --sigma:#16695A;        /* 주 강조 — 시그마 틸그린 */
  --azure:#2E7FA8;        /* 데이터·외부 축 — 로고 블루 */
  --signal:#E09242;       /* 신호·확장 축 — 로고 오렌지 */
  --graphite:#5A6A64;
  --rule:rgba(13,33,28,.10);
  --rule-dark:rgba(239,240,234,.14);

  --display:"Gowun Batang", serif;
  --body:"IBM Plex Sans KR","Pretendard","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  --mono:"IBM Plex Mono","IBM Plex Sans KR",monospace;

  --wrap:1180px;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:var(--body);
  font-weight:400;
  font-size:16px;
  line-height:1.78;
  -webkit-font-smoothing:antialiased;
  word-break:keep-all;
}
img,svg{max-width:100%}
a{color:inherit}

/* 모눈 배경 — 도시 격자이자 그래프 용지 */
.grid-bg{
  background-image:
    linear-gradient(var(--rule) 1px, transparent 1px),
    linear-gradient(90deg, var(--rule) 1px, transparent 1px);
  background-size:52px 52px;
}
.grid-bg-dark{
  background-image:
    linear-gradient(var(--rule-dark) 1px, transparent 1px),
    linear-gradient(90deg, var(--rule-dark) 1px, transparent 1px);
  background-size:52px 52px;
}

.wrap{width:100%;max-width:var(--wrap);margin:0 auto;padding:0 28px}

/* 공통 타이포 */
.eyebrow{
  font-family:var(--mono);
  font-size:12px;
  letter-spacing:.07em;
  text-transform:uppercase;
  color:var(--sigma);
  display:flex;align-items:center;gap:12px;
  margin:0 0 18px;
}
.eyebrow::after{content:"";flex:1;height:1px;background:var(--rule)}
.on-dark .eyebrow{color:var(--signal)}
.on-dark .eyebrow::after{background:var(--rule-dark)}

h2.sec-title{
  font-family:var(--display);
  font-weight:700;
  font-size:clamp(28px,4.2vw,44px);
  line-height:1.32;
  letter-spacing:-.01em;
  margin:0 0 16px;
}
h3.sub{
  font-family:var(--display);
  font-weight:700;
  font-size:20px;
  line-height:1.5;
  margin:0 0 10px;
}
.lede{
  font-size:17px;
  color:var(--graphite);
  max-width:62ch;
  margin:0 0 44px;
}
.on-dark .lede{color:rgba(239,240,234,.72)}

section{padding:96px 0;position:relative;scroll-margin-top:70px}
.on-dark{background:var(--ink);color:var(--paper)}

.mono{font-family:var(--mono)}
.num{font-family:var(--mono);font-variant-numeric:tabular-nums}

/* ─────────────────────────────────────────────
   상단 바
   ───────────────────────────────────────────── */
.topbar{
  position:sticky;top:0;z-index:50;
  background:rgba(13,33,28,.94);
  backdrop-filter:blur(8px);
  border-bottom:1px solid var(--rule-dark);
  color:var(--paper);
}
.topbar .wrap{display:flex;align-items:center;justify-content:space-between;height:62px;gap:20px}
.brand{display:flex;align-items:baseline;gap:12px;min-width:0}
.brand .org{font-size:13px;color:rgba(239,240,234,.6);white-space:nowrap;text-decoration:none}
.brand .org:hover,.brand .org:focus-visible{color:var(--paper)}
.brand .plat{font-family:var(--display);font-weight:700;font-size:18px;white-space:nowrap}
.brand .plat b{color:var(--signal)}
.topnav{display:flex;gap:26px;font-size:13.5px}
.topnav a{color:rgba(239,240,234,.72);text-decoration:none;padding:4px 0;border-bottom:1px solid transparent}
.topnav a:hover,.topnav a:focus-visible{color:var(--paper);border-bottom-color:var(--signal)}
@media(max-width:860px){.topnav{display:none}}

/* ─────────────────────────────────────────────
   히어로 — 시그마 눈금자(시그니처)
   ───────────────────────────────────────────── */
.hero{background:var(--ink);color:var(--paper);padding:88px 0 0;overflow:hidden}
.hero-head{max-width:900px}
.hero-kicker{
  font-size:12.5px;color:var(--signal);margin:0 0 26px;
  display:flex;flex-wrap:wrap;align-items:baseline;gap:10px;
}
.hero h1{
  font-family:var(--display);
  font-weight:700;
  font-size:clamp(38px,6.4vw,72px);
  line-height:1.24;
  letter-spacing:-.02em;
  margin:0 0 26px;
}
.hero h1 em{font-style:normal;color:var(--signal)}
.hero p.claim{
  font-size:clamp(16px,2vw,19px);
  color:rgba(239,240,234,.78);
  max-width:60ch;margin:0 0 38px;
}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:56px}
.btn{
  display:inline-flex;align-items:center;gap:10px;
  padding:14px 26px;border-radius:2px;
  font-size:14.5px;font-weight:600;text-decoration:none;
  border:1px solid transparent;transition:.18s ease;
}
.btn-solid{background:var(--signal);color:#231400}
.btn-solid:hover{background:#f0a458}
.btn-ghost{border-color:rgba(239,240,234,.34);color:var(--paper)}
.btn-ghost:hover{border-color:var(--paper);background:rgba(239,240,234,.07)}
.btn .arw{font-family:var(--mono);font-size:13px}

/* 눈금자 */
.ruler-box{border-top:1px solid var(--rule-dark);padding:34px 0 74px}
.ruler-cap{
  display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;
  font-family:var(--mono);font-size:11.5px;letter-spacing:.05em;
  color:rgba(239,240,234,.45);margin-bottom:6px;
}
.ruler svg{width:100%;height:auto;display:block}
/* 좁은 화면에서는 눈금자를 세로 단계로 바꿔 글자를 읽을 수 있게 한다 */
.ruler-mobile{display:none;margin:0;padding:0;list-style:none}
.ruler-mobile li{display:grid;grid-template-columns:56px 1fr;gap:16px;align-items:baseline;padding:16px 0;border-top:1px solid var(--rule-dark)}
.ruler-mobile .sg{font-family:var(--mono);font-size:20px;color:rgba(239,240,234,.75)}
.ruler-mobile li:nth-child(2) .sg{color:var(--azure)}
.ruler-mobile li:nth-child(3) .sg{color:var(--signal);font-size:24px;font-weight:600}
.ruler-mobile b{display:block;font-size:14.5px;font-weight:600;color:var(--paper)}
.ruler-mobile span{font-size:13.5px;color:rgba(239,240,234,.55)}
@media(max-width:720px){
  .ruler{display:none}
  .ruler-mobile{display:block}
}
.axis-line{stroke:rgba(239,240,234,.28);stroke-width:1.5}
.seg{stroke-width:3;fill:none;stroke-linecap:round}
.seg-in{stroke:rgba(239,240,234,.42)}
.seg-out{stroke:var(--azure)}
.seg-x{stroke:var(--signal)}
.tick{stroke:rgba(239,240,234,.3);stroke-width:1}
.tick-major{stroke:rgba(239,240,234,.65);stroke-width:1.5}
.lbl{font-family:"IBM Plex Mono",monospace;font-size:15px;fill:rgba(239,240,234,.9)}
.lbl-sm{font-family:"IBM Plex Sans KR",sans-serif;font-size:12.5px;fill:rgba(239,240,234,.5)}
.lbl-x{font-family:"IBM Plex Mono",monospace;font-size:26px;font-weight:600;fill:var(--signal)}
.lbl-azure{fill:var(--azure)}

@keyframes draw{to{stroke-dashoffset:0}}
@keyframes fadein{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.anim-draw{stroke-dasharray:1400;stroke-dashoffset:1400;animation:draw 1.6s cubic-bezier(.2,.7,.2,1) forwards}
.d1{animation-delay:.15s}.d2{animation-delay:.75s}.d3{animation-delay:1.25s}
.anim-fade{opacity:0;animation:fadein .6s ease forwards}
.f1{animation-delay:.7s}.f2{animation-delay:1.2s}.f3{animation-delay:1.7s}
.pulse{animation:pulseo 2.6s ease-in-out 2s infinite}
@keyframes pulseo{0%,100%{opacity:1}50%{opacity:.45}}

/* ─────────────────────────────────────────────
   비교 3열
   ───────────────────────────────────────────── */
.cmp{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:1px solid var(--rule);background:#fff}
.cmp-col{padding:32px 28px;border-right:1px solid var(--rule)}
.cmp-col:last-child{border-right:0}
.cmp-col.is-x{background:var(--ink);color:var(--paper);border-right:0}
.cmp-tag{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;color:var(--graphite);margin-bottom:10px}
.cmp-col.is-x .cmp-tag{color:var(--signal)}
.cmp-name{font-family:var(--display);font-weight:700;font-size:23px;margin:0 0 4px}
.cmp-en{font-family:var(--mono);font-size:12px;color:var(--graphite);margin-bottom:20px}
.cmp-col.is-x .cmp-en{color:rgba(239,240,234,.5)}
.cmp dl{margin:0;font-size:14.2px}
.cmp dt{font-family:var(--mono);font-size:11px;letter-spacing:.02em;color:var(--graphite);margin-top:16px}
.cmp-col.is-x dt{color:rgba(239,240,234,.5)}
.cmp dd{margin:4px 0 0;line-height:1.68}
@media(max-width:880px){
  .cmp{grid-template-columns:1fr}
  .cmp-col{border-right:0;border-bottom:1px solid var(--rule)}
}

/* X 의미 4칸 */
.xmean{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--rule);margin-top:1px}
.xmean div{background:var(--paper);padding:22px 20px}
.xmean b{font-family:var(--mono);font-size:13px;color:var(--sigma);display:block;margin-bottom:6px;letter-spacing:.06em}
.xmean p{margin:0;font-size:13.8px;color:var(--graphite);line-height:1.7}
@media(max-width:880px){.xmean{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.xmean{grid-template-columns:1fr}}

/* ─────────────────────────────────────────────
   난제 유형
   ───────────────────────────────────────────── */
.topics{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule)}
.topic{background:#fff;padding:28px 26px}
.topic .code{font-family:var(--mono);font-size:11.5px;color:var(--azure);letter-spacing:.12em}
.topic h4{font-family:var(--display);font-weight:700;font-size:19px;margin:8px 0 8px}
.topic p{margin:0;font-size:14.2px;color:var(--graphite);line-height:1.72}
@media(max-width:880px){.topics{grid-template-columns:1fr}}

/* ─────────────────────────────────────────────
   실행 파이프라인
   ───────────────────────────────────────────── */
.pipe{position:relative;margin-top:8px}
.pipe-rail{
  position:absolute;left:0;right:0;top:26px;height:2px;
  background:linear-gradient(90deg,var(--azure) 0%,var(--sigma) 55%,var(--signal) 100%);
  opacity:.35;
}
.pipe-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;position:relative;align-items:stretch}
.stage{background:transparent;display:flex;flex-direction:column;height:100%}
.stage .dot{
  width:14px;height:14px;border-radius:50%;
  background:var(--paper);border:3px solid var(--sigma);
  margin:20px 0 22px;position:relative;z-index:2;
}
.stage:nth-child(1) .dot,.stage:nth-child(2) .dot{border-color:var(--azure)}
.stage:nth-child(5) .dot,.stage:nth-child(6) .dot{border-color:var(--signal)}
.stage .st-no{font-family:var(--mono);font-size:11px;letter-spacing:.16em;color:var(--graphite)}
.stage h4{font-family:var(--display);font-weight:700;font-size:20px;margin:6px 0 4px}
.stage .st-en{font-family:var(--mono);font-size:11.5px;color:var(--graphite);margin-bottom:12px}
.stage p{font-size:13.8px;color:var(--graphite);margin:0 0 14px;line-height:1.7}
.stage .st-meta{border-top:1px solid var(--rule);padding-top:10px;font-size:12.2px;margin-top:auto}
.stage .st-meta span{display:block;color:var(--graphite)}
.stage .st-meta b{font-weight:600;color:var(--ink)}
@media(max-width:1000px){
  .pipe-grid{grid-template-columns:repeat(2,1fr);gap:28px}
  .pipe-rail{display:none}
  .stage{border-left:2px solid var(--rule);padding-left:18px}
  .stage .dot{margin-top:0}
}
@media(max-width:560px){.pipe-grid{grid-template-columns:1fr}}

.pipe-total{
  display:flex;flex-wrap:wrap;gap:26px;align-items:baseline;
  margin-top:44px;padding-top:22px;border-top:1px solid var(--rule);
  font-size:14px;color:var(--graphite);
}
.pipe-total strong{font-family:var(--mono);font-size:22px;color:var(--ink);font-weight:600}

/* ─────────────────────────────────────────────
   3주체
   ───────────────────────────────────────────── */
.roles{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.role{border:1px solid var(--rule-dark);padding:30px 26px;background:rgba(239,240,234,.03)}
.role .rk{font-family:var(--mono);font-size:11.5px;letter-spacing:.16em;color:var(--signal);margin-bottom:12px}
.role h4{font-family:var(--display);font-weight:700;font-size:22px;margin:0 0 4px}
.role .who{font-size:13px;color:rgba(239,240,234,.55);margin-bottom:18px}
.role ul{margin:0;padding-left:0;list-style:none;font-size:14px}
.role li{padding:8px 0;border-top:1px solid var(--rule-dark);color:rgba(239,240,234,.82);line-height:1.65}
.role li b{color:var(--paper);font-weight:600}
@media(max-width:880px){.roles{grid-template-columns:1fr}}

/* ─────────────────────────────────────────────
   운영 · 표 / 가중치
   ───────────────────────────────────────────── */
.two{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:start}
.two > *{min-width:0}
@media(max-width:940px){.two{grid-template-columns:1fr;gap:44px}}

.tbl-scroll{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
table.tbl{width:100%;border-collapse:collapse;font-size:14px;background:#fff}
@media(max-width:640px){table.tbl{min-width:520px}}
table.tbl th,table.tbl td{border:1px solid var(--rule);padding:12px 14px;text-align:left;vertical-align:top;line-height:1.65}
table.tbl th{
  background:var(--paper-2);font-weight:600;font-size:12.5px;
  font-family:var(--mono);letter-spacing:.01em;color:var(--ink);
}
table.tbl td.n{font-family:var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap}

.weight{margin:0;padding:0;list-style:none}
.weight li{padding:14px 0;border-bottom:1px solid var(--rule)}
.weight .wtop{display:flex;justify-content:space-between;align-items:baseline;gap:14px;margin-bottom:8px}
.weight .wname{font-weight:600;font-size:15px}
.weight .wval{font-family:var(--mono);font-size:14px;color:var(--sigma)}
.weight .wbar{height:6px;background:var(--paper-2);border-radius:0;overflow:hidden}
.weight .wbar i{display:block;height:100%;background:var(--sigma);width:0;transition:width 1.1s cubic-bezier(.2,.7,.2,1)}
.weight li:nth-child(2) .wbar i{background:var(--azure)}
.weight li:nth-child(3) .wbar i{background:var(--signal)}
.weight .wdesc{font-size:13.2px;color:var(--graphite);margin:8px 0 0;line-height:1.65}

.screen-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:28px}
.screen-steps div{border:1px solid var(--rule);background:#fff;padding:20px 18px}
.screen-steps .sn{font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--graphite)}
.screen-steps h5{font-family:var(--display);font-weight:700;font-size:17px;margin:6px 0 8px}
.screen-steps p{margin:0;font-size:13.4px;color:var(--graphite);line-height:1.7}
@media(max-width:760px){.screen-steps{grid-template-columns:1fr}}

/* 카드 리스트 (보상·권리 / 재원) */
.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.card{border:1px solid var(--rule);background:#fff;padding:28px 26px}
.card .ck{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;color:var(--sigma);margin-bottom:10px}
.card h4{font-family:var(--display);font-weight:700;font-size:19px;margin:0 0 10px}
.card ul{margin:0;padding-left:18px;font-size:14.2px;color:var(--graphite);line-height:1.75}
.card ul li{margin-bottom:7px}
.card ul li b{color:var(--ink);font-weight:600}
@media(max-width:880px){.cards{grid-template-columns:1fr}}

/* 캘린더 */
.cal{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--rule);border:1px solid var(--rule)}
.cal div{background:#fff;padding:22px 20px}
.cal .q{font-family:var(--mono);font-size:12px;letter-spacing:.14em;color:var(--azure);margin-bottom:8px}
.cal h5{font-family:var(--display);font-weight:700;font-size:17px;margin:0 0 8px}
.cal p{margin:0;font-size:13.4px;color:var(--graphite);line-height:1.7}
@media(max-width:880px){.cal{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.cal{grid-template-columns:1fr}}

/* 3R 연계 */
.threer{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px}
.threer div{border-top:2px solid var(--sigma);padding-top:16px}
.threer div:nth-child(2){border-top-color:var(--azure)}
.threer div:nth-child(3){border-top-color:var(--signal)}
.threer b{font-family:var(--mono);font-size:12.5px;letter-spacing:.14em;display:block;margin-bottom:6px}
.threer h5{font-family:var(--display);font-weight:700;font-size:18px;margin:0 0 8px}
.threer p{margin:0;font-size:13.6px;color:var(--graphite);line-height:1.7}
@media(max-width:880px){.threer{grid-template-columns:1fr}}

/* 로드맵 */
.road{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.road div{border:1px solid var(--rule-dark);padding:26px 22px;background:rgba(239,240,234,.03)}
.road .ph{font-family:var(--mono);font-size:11.5px;letter-spacing:.16em;color:var(--signal)}
.road h5{font-family:var(--display);font-weight:700;font-size:19px;margin:8px 0 4px}
.road .per{font-family:var(--mono);font-size:12px;color:rgba(239,240,234,.5);margin-bottom:14px}
.road ul{margin:0;padding-left:16px;font-size:13.6px;color:rgba(239,240,234,.78);line-height:1.72}
.road li{margin-bottom:6px}
@media(max-width:940px){.road{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.road{grid-template-columns:1fr}}

/* CTA */
.cta{background:var(--sigma);color:#fff;padding:82px 0}
.cta h2{font-family:var(--display);font-weight:700;font-size:clamp(26px,4vw,40px);margin:0 0 14px;line-height:1.35}
.cta p{font-size:16.5px;color:rgba(255,255,255,.85);max-width:56ch;margin:0 0 34px}
.cta-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-bottom:40px}
.cta-grid a{
  display:block;text-decoration:none;padding:26px 24px;
  border:1px solid rgba(255,255,255,.3);transition:.18s ease;
}
.cta-grid a:hover,.cta-grid a:focus-visible{background:rgba(255,255,255,.1);border-color:#fff}
.cta-grid .lab{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;color:rgba(255,255,255,.7)}
.cta-grid strong{display:block;font-family:var(--display);font-size:21px;margin:8px 0 6px;font-weight:700}
.cta-grid span{font-size:13.6px;color:rgba(255,255,255,.8);line-height:1.65}
@media(max-width:760px){.cta-grid{grid-template-columns:1fr}}
.contact{
  display:flex;flex-wrap:wrap;gap:12px 40px;
  padding-top:26px;border-top:1px solid rgba(255,255,255,.25);
  font-size:14px;color:rgba(255,255,255,.9);
}
.contact span{display:flex;gap:10px;align-items:baseline}
