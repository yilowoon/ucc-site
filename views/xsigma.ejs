<script>
// 스크롤 등장 + 배점 막대 채우기
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var targets = document.querySelectorAll('.rv');

  function fillBars(root){
    root.querySelectorAll('.wbar i').forEach(function(bar){
      var pct = parseInt(bar.getAttribute('data-fill'), 10) || 0;
      // 30점을 100% 폭으로 잡아, 최고 배점도 여백을 남기며 차이가 드러나게 한다
      bar.style.width = Math.round(pct / 30 * 100) + '%';
    });
  }

  if (reduce || !('IntersectionObserver' in window)) {
    targets.forEach(function(el){ el.classList.add('in'); fillBars(el); });
    return;
  }

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (!entry.isIntersecting) return;
      entry.target.classList.add('in');
      fillBars(entry.target);
      io.unobserve(entry.target);
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });

  targets.forEach(function(el){ io.observe(el); });
})();
</script>
