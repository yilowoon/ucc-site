<%- include('partials/header') %>

<style>
/* 엑스시그마 전용 보조 스타일 — 전부 사이트 토큰(딥그린·골드·Pretendard)만 사용 */
.x-code{font-size:.75rem;letter-spacing:.1em;color:var(--ci-blue-d);font-weight:700;margin:0 0 6px}
.x-k{font-size:.75rem;letter-spacing:.12em;color:var(--gold-600);font-weight:700;margin:0 0 2px}
.x-who{font-size:.86rem;color:var(--muted);margin:0 0 12px}

.x-scale{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:0 0 30px}
.x-scale .st{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper-warm);padding:18px 20px}
.x-scale .sg{font-weight:800;font-size:1.15rem;color:var(--muted)}
.x-scale .st:nth-child(2) .sg{color:var(--ci-blue-d)}
.x-scale .st:nth-child(3){background:linear-gradient(160deg,var(--green-800),var(--green-900));border-color:var(--green-800);color:#fff}
.x-scale .st:nth-child(3) .sg{color:var(--gold-400)}
.x-scale b{display:block;font-size:.98rem;margin-top:6px}
.x-scale span{font-size:.85rem;color:var(--muted)}
.x-scale .st:nth-child(3) span{color:rgba(255,255,255,.72)}
@media(max-width:760px){.x-scale{grid-template-columns:1fr}}

.x-dl{margin:6px 0 0}
.x-dl dt{font-size:.74rem;color:var(--muted);margin-top:12px;font-weight:700;letter-spacing:.02em}
.x-dl dd{margin:3px 0 0;font-size:.92rem;color:var(--ink-soft);line-height:1.6}
.x-hi{background:linear-gradient(160deg,var(--green-800),var(--green-900))!important;border-color:var(--green-800)!important}
.x-hi h3{color:var(--gold-400)!important}
.x-hi .x-dl dt{color:var(--gold-400)}
.x-hi .x-dl dd{color:rgba(255,255,255,.86)}
.x-hi b{color:#fff}

.x-mean{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:24px}
.x-mean div{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);padding:18px}
.x-mean b{display:block;color:var(--green-700);font-weight:800;margin-bottom:6px}
.x-mean p{font-size:.9rem;color:var(--ink-soft);margin:0;line-height:1.6}
@media(max-width:820px){.x-mean{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.x-mean{grid-template-columns:1fr}}

.x-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.x-step{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);padding:22px;display:flex;flex-direction:column}
.x-step .no{font-weight:800;color:var(--gold-600);letter-spacing:.1em;font-size:.78rem}
.x-step h4{margin:8px 0 2px;color:var(--green-800);font-size:1.1rem}
.x-step .en{font-size:.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:.1em}
.x-step>p{font-size:.9rem;color:var(--ink-soft);margin:10px 0 14px;line-height:1.65}
.x-step .meta{border-top:1px solid var(--line);padding-top:10px;font-size:.82rem;color:var(--muted);margin-top:auto}
.x-step .meta span{display:block;margin-top:2px}
.x-step .meta b{color:var(--ink);font-weight:700}
@media(max-width:820px){.x-steps{grid-template-columns:1fr}}

.x-totals{display:flex;flex-wrap:wrap;gap:14px 30px;margin-top:26px;padding-top:18px;border-top:1px solid var(--line);font-size:.92rem;color:var(--muted)}
.x-totals strong{color:var(--green-800);font-weight:800;font-size:1.05rem}

.x-tbl-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}
.x-tbl{width:100%;border-collapse:collapse;font-size:.92rem;background:var(--paper)}
.x-tbl th,.x-tbl td{border:1px solid var(--line);padding:11px 13px;text-align:left;vertical-align:top;line-height:1.6}
.x-tbl th{background:var(--paper-alt);color:var(--green-800);font-weight:700;font-size:.84rem}
@media(max-width:640px){.x-tbl{min-width:540px}}

.x-weight{list-style:none;margin:18px 0 0;padding:0}
.x-weight li{padding:12px 0;border-bottom:1px solid var(--line)}
.x-weight .top{display:flex;justify-content:space-between;gap:12px;margin-bottom:8px}
.x-weight .nm{font-weight:700}
.x-weight .vl{font-weight:800;color:var(--gold-600)}
.x-weight .bar{height:8px;background:var(--paper-alt);border-radius:6px;overflow:hidden}
.x-weight .bar i{display:block;height:100%;background:linear-gradient(90deg,var(--green-600),var(--green-800))}
.x-weight .ds{font-size:.85rem;color:var(--muted);margin:8px 0 0}

.x-3r{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:8px}
.x-3r div{border-top:3px solid var(--ci-green-d);padding-top:14px}
.x-3r div:nth-child(2){border-top-color:var(--ci-blue-d)}
.x-3r div:nth-child(3){border-top-color:var(--ci-orange-d)}
.x-3r b{display:block;font-size:.76rem;letter-spacing:.12em;color:var(--muted)}
.x-3r h4{margin:4px 0 6px;color:var(--green-800)}
.x-3r p{font-size:.9rem;color:var(--ink-soft);margin:0;line-height:1.65}
@media(max-width:820px){.x-3r{grid-template-columns:1fr}}

.x-grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.x-grid4 .cell{border:1px solid var(--line);border-radius:var(--radius);background:var(--paper);padding:20px}
.x-grid4 .q{font-size:.78rem;letter-spacing:.1em;color:var(--ci-blue-d);font-weight:700}
.x-grid4 h4{margin:6px 0 8px;color:var(--green-800);font-size:1.05rem}
.x-grid4 p{font-size:.88rem;color:var(--ink-soft);margin:0;line-height:1.6}
@media(max-width:820px){.x-grid4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.x-grid4{grid-template-columns:1fr}}

.x-sub{font-weight:800;color:var(--green-800);font-size:1.15rem;margin:0 0 12px}
.x-two{display:grid;grid-template-columns:1.05fr .95fr;gap:44px;align-items:start}
@media(max-width:940px){.x-two{grid-template-columns:1fr;gap:40px}}
.x-note{font-size:.9rem;color:var(--muted);margin:14px 0 0}

/* section--dark 카드 (로드맵) */
.section--dark .x-road{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.section--dark .x-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:var(--radius);padding:22px}
.section--dark .x-card .ph{font-size:.76rem;letter-spacing:.12em;color:var(--gold-400);font-weight:700}
.section--dark .x-card h4{color:#fff;margin:8px 0 2px}
.section--dark .x-card .per{color:rgba(255,255,255,.55);font-size:.82rem;margin-bottom:12px}
.section--dark .x-card ul{margin:0;padding-left:16px;color:rgba(255,255,255,.82);font-size:.9rem;line-height:1.7}
@media(max-width:940px){.section--dark .x-road{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.section--dark .x-road{grid-template-columns:1fr}}

.x-cta-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:10px}
.x-cta-grid a{display:block;text-decoration:none;border:1px solid rgba(255,255,255,.32);border-radius:var(--radius);padding:20px 22px;transition:.18s ease}
.x-cta-grid a:hover{background:rgba(255,255,255,.12);border-color:#fff}
.x-cta-grid .lab{font-size:.74rem;letter-spacing:.12em;color:rgba(255,255,255,.7)}
.x-cta-grid strong{display:block;color:#fff;margin:6px 0 5px;font-size:1.1rem}
.x-cta-grid span{font-size:.88rem;color:rgba(255,255,255,.82);line-height:1.6}
@media(max-width:640px){.x-cta-grid{grid-template-columns:1fr}}
.x-contact{display:flex;flex-wrap:wrap;gap:10px 32px;margin-top:22px;padding-top:18px;border-top:1px solid rgba(255,255,255,.22);font-size:.92rem;color:rgba(255,255,255,.9)}
.x-contact em{font-style:normal;font-size:.74rem;letter-spacing:.1em;color:rgba(255,255,255,.6);margin-right:8px}
.x-contact a{color:inherit}

/* 플랫폼 계통도 이미지 */
.x-diagram{margin:0;text-align:center}
.x-diagram img{width:100%;max-width:1200px;height:auto;border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-sm);background:#fff}
.x-diagram figcaption{font-size:.85rem;color:var(--muted);margin-top:12px}
</style>

<section class="page-banner">
  <div class="container">
    <span class="page-banner-en">X-SIGMA PLATFORM</span>
    <h1 class="page-banner-title">엑스시그마 플랫폼</h1>
    <p class="page-banner-desc">지역의 난제를 바깥의 지식과 연결해 현장에서 검증하는 개방형 문제해결 플랫폼</p>
  </div>
</section>

<!-- 인트로 -->
<section class="section">
  <div class="container">
    <p class="section-lede">
      <strong>엑스시그마</strong>는 사단법인 도시공동체본부가 운영하는 <strong>개방형 문제해결 플랫폼</strong>입니다.
      한 지역이 혼자 풀지 못하는 문제를 공개 과제로 바꾸고, 전국의 연구자·기업·활동가에게 해법을 구한 뒤,
      리빙랩 현장에서 실제로 작동하는지까지 검증합니다.
