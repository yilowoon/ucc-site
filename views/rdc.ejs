<%- include('partials/header') %>
<%- include('partials/lp-styles') %>
<% var RDC_COURSE = '지역발전혁신가(RDC) 양성 과정'; %>

<!-- 히어로 -->
<section class="lp-hero">
  <div class="container">
    <span class="lp-hero-eyebrow">RDC · REGIONAL DEVELOPMENT CATALYST</span>
    <h1 class="lp-hero-title">지역을 되살리는 힘,<br><strong>지역발전혁신가(RDC)</strong></h1>
    <p class="lp-hero-sub">지역회복을 <b>진단부터 자립까지</b> 설계·실행하는 현장 전문가를 양성합니다. 리빙랩 기반의 단계별 학습으로, 지역이 <b>스스로 서게</b> 만드는 역량을 기릅니다.</p>
    <div class="lp-hero-cta">
      <a class="btn btn-primary btn-lg" href="/learn/apply?course=<%= encodeURIComponent(RDC_COURSE) %>">교육 신청하기 →</a>
      <a class="btn btn-ghost-light btn-lg" href="#curriculum">커리큘럼 보기</a>
    </div>
    <ul class="lp-hero-tags">
      <li>✓ 리빙랩 현장 실습</li>
      <li>✓ 진단→자립 전 과정</li>
      <li>✓ 지역회복 표준체계</li>
      <li>✓ RDC 전문가 네트워크</li>
    </ul>
  </div>
</section>

<!-- 과정 한눈에 -->
<section class="section" id="facts" style="padding-top:38px">
  <div class="container">
    <div class="course-facts">
      <div class="cf-item"><span class="cf-label">교육 대상</span><span class="cf-value">주민 리더 · 공공 담당자 · 사회적경제 종사자</span></div>
      <div class="cf-item"><span class="cf-label">교육 방식</span><span class="cf-value">리빙랩 기반 현장 실습 + 프로젝트</span></div>
      <div class="cf-item"><span class="cf-label">과정 구성</span><span class="cf-value">진단 → 설계 → 실증 → 자립·이양</span></div>
      <div class="cf-item"><span class="cf-label">수료 혜택</span><span class="cf-value">수료증 · RDC 전문가 네트워크</span></div>
    </div>
  </div>
</section>

<!-- 공감 · 이런 고민 -->
<section class="section section--alt" id="pain">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">혹시, 이런 고민 있으셨나요?</h2><span class="section-en">YOUR PAIN POINTS</span></div>
    </div>
    <p class="section-lede">지역을 살리고 싶지만, <strong>무엇을 어떻게 시작해야 할지</strong> 막막하셨다면 — 이 과정이 현장의 길을 열어드립니다.</p>
    <div class="pain-grid">
      <article class="pain-card"><span class="pain-q">Q</span><p>“사업은 하는데 <b>끝나면 지역에 남는 게</b> 없어요.”</p></article>
      <article class="pain-card"><span class="pain-q">Q</span><p>“주민 참여를 <b>어떻게 끌어내고 운영</b>하죠?”</p></article>
      <article class="pain-card"><span class="pain-q">Q</span><p>“지역 문제를 <b>진단하고 설계</b>하는 법을 모르겠어요.”</p></article>
      <article class="pain-card"><span class="pain-q">Q</span><p>“지역재생·공동체 분야에서 <b>전문가로 활동</b>하고 싶어요.”</p></article>
    </div>
    <p class="pain-answer">걱정 마세요. <b>진단 → 설계 → 실증 → 자립</b>까지, 리빙랩으로 직접 해보며 익힙니다.</p>
  </div>
</section>

<!-- 왜 지역개발전문가인가 -->
<section class="section" id="why">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-blue">왜 지역개발전문가인가</h2><span class="section-en">WHY RDC NOW</span></div>
    </div>
    <p class="section-lede">인구감소와 지방소멸의 시대, 지역을 되살리는 힘은 <strong>주민 스스로</strong>에게 있습니다. 도시공동체본부는 지역이 스스로 서도록 설계·실행하는 현장 전문가를 양성합니다.</p>
    <div class="sgrid sgrid--green">
      <article class="scard"><h4>지역소멸 위기</h4><p>인구감소·지방소멸에 대응할 <strong>현장 전문가</strong>가 절실합니다.</p></article>
      <article class="scard"><h4>주민주도 회복</h4><p>외부 지원이 아닌 <strong>주민 스스로</strong>의 힘으로 지역을 되살립니다.</p></article>
      <article class="scard"><h4>리빙랩 실증</h4><p>책상 위 계획이 아니라 <strong>현장에서 실험·검증</strong>합니다.</p></article>
      <article class="scard"><h4>자립·지속가능</h4><p>사업이 끝나도 지역이 <strong>스스로 서도록</strong> 설계합니다.</p></article>
    </div>
  </div>
</section>

<!-- 이런 분께 추천 -->
<section class="section section--alt" id="who">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">이런 분께 추천합니다</h2><span class="section-en">FOR WHOM</span></div>
    </div>
    <div class="persona-grid">
      <article class="persona-card"><span class="persona-ico">🧑‍🌾</span><h3>주민 리더·활동가</h3><p>마을공동체·주민자치를 이끌고 문제를 함께 풀고 싶은 분</p></article>
      <article class="persona-card"><span class="persona-ico">🏛️</span><h3>공공·정책 담당자</h3><p>지역진단·정책설계와 리빙랩 사업을 기획·운영하는 분</p></article>
      <article class="persona-card"><span class="persona-ico">🤝</span><h3>사회적경제 종사자</h3><p>지역순환경제·공동체 사업 모델을 설계하고 싶은 분</p></article>
      <article class="persona-card"><span class="persona-ico">🌍</span><h3>지역재생 전문가 준비</h3><p>지역발전혁신가(RDC)로 현장 전문가의 길을 걷고 싶은 분</p></article>
    </div>
  </div>
</section>

<!-- 교육 체계 · 단계 -->
<section class="section" id="ladder">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-blue">교육 체계 · 단계별 과정</h2><span class="section-en">LEARNING PATH</span></div>
    </div>
    <p class="section-lede">지역자원을 <strong>진단 → 설계 → 실증 → 자립·이양</strong>으로 이어가는 리빙랩 학습 사다리로, 주민부터 정책 담당자까지 눈높이에 맞춰 설계합니다.</p>
    <ol class="esg-flow" aria-label="RDC 학습 단계">
      <li><span class="ef-no">STEP 1</span><h3>진단</h3><p>지역자원·문제 조사와 정의</p></li>
      <li><span class="ef-no">STEP 2</span><h3>설계</h3><p>표준 프로그램·실행계획 설계</p></li>
      <li><span class="ef-no">STEP 3</span><h3>실증</h3><p>리빙랩 파일럿 운영·검증</p></li>
      <li><span class="ef-no">STEP 4</span><h3>자립</h3><p>운영모델·거버넌스 이양</p></li>
    </ol>
    <div class="esg-mods" style="margin-top:30px">
      <article class="esg-mod esg-mod--green"><div class="esg-mod-head"><span class="esg-mod-no">대상 A</span><h3 class="esg-mod-title">주민 리더 · 활동가</h3></div><ul class="esg-mod-list"><li>마을공동체·주민자치 리더십</li><li>주민참여형 문제해결 역량</li></ul></article>
      <article class="esg-mod esg-mod--blue"><div class="esg-mod-head"><span class="esg-mod-no">대상 B</span><h3 class="esg-mod-title">공공·정책 담당자</h3></div><ul class="esg-mod-list"><li>지역진단·정책설계 실무</li><li>리빙랩 사업 기획·운영</li></ul></article>
      <article class="esg-mod esg-mod--blue"><div class="esg-mod-head"><span class="esg-mod-no">대상 C</span><h3 class="esg-mod-title">사회적경제 종사자</h3></div><ul class="esg-mod-list"><li>지역순환경제·사회적가치</li><li>공동체 사업 모델 설계</li></ul></article>
      <article class="esg-mod esg-mod--feature"><div class="esg-mod-head"><span class="esg-mod-no">대상 D</span><h3 class="esg-mod-title">지역발전혁신가(RDC)</h3><span class="esg-mod-badge">전문가</span></div><ul class="esg-mod-list"><li>진단~자립 전 과정 퍼실리테이션</li><li>RDC 전문가·코디네이터 양성</li></ul></article>
    </div>
  </div>
</section>

<!-- 핵심 역량 배너 -->
<section class="lp-band">
  <div class="container">
    <p class="lp-band-lead">조사·계획을 넘어, 지역이 스스로 서게!</p>
    <h2 class="lp-band-title">리빙랩으로 완성하는 <b>지역회복 설계</b></h2>
    <p class="lp-band-sub">지역자원을 <b>진단하고 설계해 현장에서 실증</b>하고, 운영모델과 거버넌스를 지역에 이양해 지속가능한 자립까지 이끕니다.</p>
    <ul class="lp-band-stack">
      <li>🔎 지역진단 · 자원조사</li>
      <li>🧪 리빙랩 실증 · 퍼실리테이션</li>
      <li>🏡 자립 · 거버넌스 이양</li>
    </ul>
  </div>
</section>

<!-- 핵심 커리큘럼 -->
<section class="section" id="curriculum">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">핵심 커리큘럼</h2><span class="section-en">CURRICULUM</span></div>
    </div>
    <p class="section-lede">리빙랩(Living Lab) 기반의 <strong>단계별 실습 커리큘럼</strong>으로, 지역을 조사하고 문제를 정의하여 표준 프로그램을 설계·실증하고 자립까지 이끕니다.</p>
    <%
      const curriculum = [
        { no: "01", title: "지역진단 · 회복력", items: ["인구·경제·공동체 진단", "회복탄력성 개념과 지표", "지역 현황 분석"] },
        { no: "02", title: "리빙랩 방법론", items: ["주민참여형 문제해결", "현장 실험 설계와 운영", "퍼실리테이션 기법"] },
        { no: "03", title: "자원조사 · 문제정의", items: ["지역자원 매핑", "이해관계자 분석", "핵심 과제 도출"] },
        { no: "04", title: "표준 프로그램 설계", items: ["지역회복 표준체계 적용", "실행계획 수립", "실증(파일럿) 설계"] },
        { no: "05", title: "자립 · 이양", items: ["운영모델·거버넌스 구축", "성과관리 체계", "지역으로의 이양"] },
        { no: "06", title: "수료 · 네트워크", featured: true, items: ["프로젝트 발표·수료", "RDC 전문가 네트워크", "현장 연계·후속 지원"] }
      ];
    %>
    <div class="esg-mods">
      <% curriculum.forEach(function(m){ %>
        <article class="esg-mod esg-mod--green<%= m.featured ? ' esg-mod--feature' : '' %>">
          <div class="esg-mod-head"><span class="esg-mod-no"><%= m.no %></span><h3 class="esg-mod-title"><%= m.title %></h3><% if (m.featured) { %><span class="esg-mod-badge">수료</span><% } %></div>
          <ul class="esg-mod-list"><% m.items.forEach(function(it){ %><li><%= it %></li><% }); %></ul>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- 수료 후 활용(진로) -->
<section class="section section--alt" id="outcomes">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-orange">수료 후 활용 · 진로</h2><span class="section-en">OUTCOMES</span></div>
    </div>
    <p class="section-lede">수료 후에는 지역 현장에서 <strong>바로 활동</strong>할 수 있는 전문가로 성장합니다. 지역재생·공동체 사업의 기획자이자 실행자가 됩니다.</p>
    <%
      const outcomes = [
        { lv: "진로 01", title: "지역혁신전문가(RDC)", cls: "green", items: ["마을 코디네이터", "지역재생 현장 매니저", "공동체 활동 지원가"] },
        { lv: "진로 02", title: "사업 기획·운영", cls: "blue", items: ["지역재생·공동체 사업 기획", "리빙랩 프로젝트 운영", "성과관리·평가"] },
        { lv: "진로 03", title: "정책 자문·퍼실리테이터", cls: "orange", items: ["정책 자문·컨설팅", "리빙랩 퍼실리테이션", "주민 교육·역량강화"] }
      ];
    %>
    <div class="esg-mods esg-mods--3">
      <% outcomes.forEach(function(m){ %>
        <article class="esg-mod esg-mod--<%= m.cls %>">
          <div class="esg-mod-head"><span class="esg-mod-no"><%= m.lv %></span><h3 class="esg-mod-title"><%= m.title %></h3></div>
          <ul class="esg-mod-list"><% m.items.forEach(function(it){ %><li><%= it %></li><% }); %></ul>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- 수료 후, 이렇게 달라집니다 -->
<section class="section" id="change">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">수료 후, 이렇게 달라집니다</h2><span class="section-en">BEFORE → AFTER</span></div>
    </div>
    <div class="ba-grid">
      <article class="ba-card">
        <div class="ba-before"><span class="ba-tag">BEFORE</span><p>사업이 끝나면 지역에 남는 것이 없음</p></div>
        <span class="ba-arrow" aria-hidden="true">→</span>
        <div class="ba-after"><span class="ba-tag ba-tag--on">AFTER</span><p>운영모델·거버넌스를 <b>지역에 이양해 자립</b></p></div>
      </article>
      <article class="ba-card">
        <div class="ba-before"><span class="ba-tag">BEFORE</span><p>주민 참여를 끌어내기 어려움</p></div>
        <span class="ba-arrow" aria-hidden="true">→</span>
        <div class="ba-after"><span class="ba-tag ba-tag--on">AFTER</span><p>퍼실리테이션으로 <b>주민주도 문제해결</b></p></div>
      </article>
      <article class="ba-card">
        <div class="ba-before"><span class="ba-tag">BEFORE</span><p>책상 위 계획에 머무는 사업</p></div>
        <span class="ba-arrow" aria-hidden="true">→</span>
        <div class="ba-after"><span class="ba-tag ba-tag--on">AFTER</span><p>리빙랩으로 <b>현장에서 실험·검증</b></p></div>
      </article>
      <article class="ba-card">
        <div class="ba-before"><span class="ba-tag">BEFORE</span><p>지역재생 커리어의 방향이 막연함</p></div>
        <span class="ba-arrow" aria-hidden="true">→</span>
        <div class="ba-after"><span class="ba-tag ba-tag--on">AFTER</span><p>RDC로 <b>현장 전문가·코디네이터</b>로 활동</p></div>
      </article>
    </div>
  </div>
</section>

<!-- 강점 (POINT) -->
<section class="section section--alt" id="strength">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-blue">도시공동체본부 RDC의 강점</h2><span class="section-en">WHY US</span></div>
    </div>
    <div class="point-list">
      <article class="point-row"><span class="point-no">01</span><div class="point-body"><h3>진단에서 자립까지</h3><p>조사·진단에 머물지 않고 <b>설계 → 실증 → 자립</b>까지 하나로 연결합니다.</p></div></article>
      <article class="point-row"><span class="point-no">02</span><div class="point-body"><h3>리빙랩 현장 중심</h3><p>이론이 아니라 <b>현장에서 실험하고 검증</b>하는 실전형 교육입니다.</p></div></article>
      <article class="point-row"><span class="point-no">03</span><div class="point-body"><h3>지역회복 표준체계</h3><p>도시공동체본부의 <b>지역회복 표준 프로그램</b>을 적용·실습합니다.</p></div></article>
      <article class="point-row"><span class="point-no">04</span><div class="point-body"><h3>전문가 네트워크</h3><p>수료 후 <b>RDC 전문가 네트워크</b>로 지속 성장·연계합니다.</p></div></article>
    </div>
  </div>
</section>

<!-- 신청 절차 -->
<section class="section" id="apply">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">신청 절차</h2><span class="section-en">HOW TO APPLY</span></div>
    </div>
    <p class="section-lede">아래 절차에 따라 간편하게 신청하실 수 있습니다. 세부 일정은 <a href="/learn/calendar">연간교육일정</a>에서 확인하세요.</p>
    <ol class="esg-flow esg-flow--apply" aria-label="신청 절차">
      <li><span class="ef-no">STEP 1</span><h3>교육 신청</h3><p>신청 폼 작성</p></li>
      <li><span class="ef-no">STEP 2</span><h3>상담 안내</h3><p>과정·일정 안내</p></li>
      <li><span class="ef-no">STEP 3</span><h3>등록</h3><p>수강 확정</p></li>
      <li><span class="ef-no">STEP 4</span><h3>교육 시작</h3><p>리빙랩·프로젝트</p></li>
    </ol>
  </div>
</section>

<!-- FAQ -->
<section class="section section--alt" id="faq">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-orange">자주 묻는 질문</h2><span class="section-en">FAQ</span></div>
    </div>
    <div class="faq-list">
      <details class="faq-item"><summary>전공·경력이 없어도 들을 수 있나요?</summary><div class="faq-a">네. 주민 리더·활동가부터 공공 담당자, 사회적경제 종사자까지 누구나 참여할 수 있도록 단계별로 설계되어 있습니다.</div></details>
      <details class="faq-item"><summary>리빙랩이 무엇인가요?</summary><div class="faq-a">리빙랩(Living Lab)은 <b>주민이 참여해 지역 문제를 현장에서 실험·검증</b>하는 방식입니다. 책상 위 계획이 아니라 실제 현장에서 해결안을 만들어 봅니다.</div></details>
      <details class="faq-item"><summary>수료 후 어떤 활동을 할 수 있나요?</summary><div class="faq-a">마을 코디네이터·지역재생 매니저, 지역재생·공동체 사업 기획·운영, 정책 자문·퍼실리테이터 등 <b>지역 현장 전문가</b>로 활동할 수 있습니다.</div></details>
      <details class="faq-item"><summary>교육은 어떻게 진행되나요?</summary><div class="faq-a">지역회복 표준체계를 바탕으로 한 <b>리빙랩 현장 실습과 프로젝트</b> 중심으로 진행되며, 수료 후 RDC 전문가 네트워크로 이어집니다.</div></details>
    </div>
    <p class="faq-more">더 궁금한 점이 있으신가요? <a href="/#contact">교육 문의하기 →</a></p>
  </div>
</section>

