<%- include('partials/header') %>
<style>
  .tk-grid{display:grid;grid-template-columns:360px 1fr;gap:20px;align-items:start}
  @media(max-width:900px){.tk-grid{grid-template-columns:1fr}}
  .tk-form .field{margin-bottom:12px}
  .tk-form label{display:block;font-size:.82rem;font-weight:700;color:var(--ink-soft);margin-bottom:5px}
  .tk-form input,.tk-form select,.tk-form textarea{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:9px;font-size:.92rem;font-family:inherit}
  .tk-form textarea{resize:vertical;min-height:60px}
  .tk-listhead{display:flex;align-items:center;gap:12px;padding:4px 16px 8px;font-size:.76rem;font-weight:800;color:var(--muted)}
  .tk-listhead .lh-title{flex:1;padding-left:22px}
  .tk-listhead .lh-st{flex:none;width:52px;text-align:center}
  .tk-listhead .lh-upd{flex:none;white-space:nowrap}
  .tk-cards{display:grid;gap:10px}
  .tk-item{background:var(--paper);border:1px solid var(--line);border-left:4px solid var(--line);border-radius:12px;box-shadow:var(--shadow-sm);overflow:hidden}
  .tk-item--이슈{border-left-color:#c5221f}.tk-item--진행중{border-left-color:#1b93c6}.tk-item--대기{border-left-color:#8a6d00}.tk-item--보류{border-left-color:#8a939c}.tk-item--완료{border-left-color:#2b8a5a}
  .tk-sum{list-style:none;cursor:pointer;display:flex;align-items:center;gap:12px;padding:13px 16px;user-select:none}
  .tk-sum::-webkit-details-marker{display:none}
  .tk-sum .caret{flex:none;color:var(--muted);transition:transform .15s;font-size:.8rem}
  .tk-item[open] .tk-sum .caret{transform:rotate(90deg)}
  .tk-sum .s-title{flex:1;min-width:0;font-weight:800;color:var(--green-800);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .tk-sum .s-seg{flex:0 0 auto;display:flex;gap:2px;width:120px;height:9px}
  .tk-sum .s-seg .seg{flex:1;background:var(--paper-warm,#eee);border:1px solid var(--line);border-radius:3px}
  .tk-sum .s-seg .seg.on{background:#2b8a5a;border-color:#2b8a5a}
  .tk-sum .s-rate{flex:none;font-size:.76rem;font-weight:800;color:var(--green-800);min-width:34px;text-align:right}
  @media(max-width:620px){.tk-sum .s-seg{display:none}.tk-sum .s-rate{min-width:30px}}
  .tk-sum .s-upd{flex:none;color:var(--muted);font-size:.8rem;white-space:nowrap}
  .tk-sum:hover{background:#fcfbf7}
  .tk-item[open] .tk-sum{border-bottom:1px solid var(--line)}
  .tk-body{padding:14px 18px 18px}
  .tk-card-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
  .tk-title{font-size:1.1rem;font-weight:800;color:var(--green-800);margin:0}
  .st-badge{font-size:.72rem;font-weight:800;border-radius:999px;padding:3px 10px;color:#fff;white-space:nowrap}
  .st-이슈{background:#c5221f}.st-진행중{background:#1b93c6}.st-대기{background:#8a6d00}.st-보류{background:#8a939c}.st-완료{background:#2b8a5a}
  .tk-meta{display:flex;gap:16px;flex-wrap:wrap;margin:10px 0;font-size:.86rem}
  .tk-meta .mk{color:var(--muted);font-weight:700;margin-right:5px}
  .tk-field{margin-top:8px;font-size:.9rem;line-height:1.6;color:var(--ink-soft);white-space:pre-wrap}
  .tk-field .fk{font-size:.74rem;font-weight:800;color:var(--muted);display:block;margin-bottom:2px}
  .tk-issue{background:#fdf3f2;border:1px solid #f0cfcb;border-radius:8px;padding:8px 10px}
  .tk-issue .fk{color:#c5221f}
  .tk-rate{display:flex;align-items:center;gap:10px;margin:8px 0 2px}
  .tk-rate-bar{flex:1;height:8px;background:var(--paper-warm,#eee);border:1px solid var(--line);border-radius:999px;overflow:hidden}
  .tk-rate-bar span{display:block;height:100%;background:linear-gradient(90deg,#1b93c6,#2b8a5a);border-radius:999px}
  .tk-rate-num{font-size:.8rem;font-weight:800;color:var(--green-800);min-width:38px;text-align:right}
  /* 단계별 균등 분할 진행바 */
  .tk-seg{flex:1;display:flex;gap:3px;height:11px}
  .tk-seg .seg{flex:1;background:var(--paper-warm,#eee);border:1px solid var(--line);border-radius:4px;transition:background .15s}
  .tk-seg .seg.on{background:#2b8a5a;border-color:#2b8a5a}
  /* 폼 단계 편집기 */
  .step-list{display:grid;gap:10px}
  .step-row{display:flex;flex-direction:column;gap:8px;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:var(--paper-warm,#faf9f5)}
  .step-main{display:flex;align-items:center;gap:8px}
  .step-row .step-no{flex:none;width:22px;height:22px;border-radius:50%;background:#fff;border:1px solid var(--line);color:var(--muted);font-size:.74rem;font-weight:800;display:flex;align-items:center;justify-content:center}
  .step-label-in{flex:1 1 auto;width:100%;min-width:0}
  .step-sub{display:flex;gap:7px;padding-left:30px}
  .step-person{flex:1 1 50%;min-width:0;width:auto !important}
  .step-ctrls{display:flex;align-items:center;gap:8px;flex-wrap:wrap;padding-left:30px}
  .step-due-wrap{flex:0 0 auto;display:flex;align-items:center;gap:5px;font-size:.74rem;font-weight:700;color:var(--muted);white-space:nowrap}
  .step-due-in{width:auto;padding:6px 8px}
  .step-done{flex:none;border:1px solid var(--line);background:#fff;color:var(--muted);font-weight:800;font-size:.76rem;border-radius:8px;padding:7px 10px;cursor:pointer;white-space:nowrap}
  .step-done.on{background:#2b8a5a;border-color:#2b8a5a;color:#fff}
  .step-del{flex:none;border:none;background:transparent;color:#c5221f;font-size:1.1rem;line-height:1;cursor:pointer;padding:0 4px}
  .step-foot{display:flex;align-items:center;justify-content:space-between;margin-top:9px;gap:10px;flex-wrap:wrap}
  .step-rate{font-size:.86rem;color:var(--muted);font-weight:700}
  .step-rate b{color:var(--green-800);font-size:1rem}
  /* 카드 단계 목록 */
  .tk-steps{display:grid;gap:6px;margin-top:4px}
  .tk-step{display:flex;align-items:center;gap:9px;padding:7px 10px;border:1px solid var(--line);border-radius:9px;background:var(--paper)}
  .tk-step.done{background:#f1f8f3;border-color:#cfe6d7}
  .tk-step-ico{flex:none;width:20px;height:20px;border-radius:50%;background:var(--paper-warm,#eee);color:var(--muted);font-size:.72rem;font-weight:800;display:flex;align-items:center;justify-content:center}
  .tk-step.done .tk-step-ico{background:#2b8a5a;color:#fff}
  .tk-step-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
  .tk-step-label{min-width:0;font-size:.9rem;color:var(--ink)}
  .tk-step-persons{font-size:.74rem;color:var(--muted)}
  .tk-step-persons b{color:var(--green-800);font-weight:700}
  .tk-step-due{flex:none;font-size:.74rem;font-weight:700;color:#8a6d00;background:#fdf6e3;border:1px solid #efe2b8;border-radius:6px;padding:2px 7px;white-space:nowrap}
  .tk-step.done .tk-step-label{color:var(--muted);text-decoration:line-through}
  .tk-step-btn{flex:none;font-weight:800}
  .tk-progress{margin-top:12px;padding-top:12px;border-top:1px dashed var(--line)}
  .tk-progress label{display:block;font-size:.74rem;font-weight:800;color:var(--muted);margin-bottom:5px}
  .tk-progress textarea{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:9px;font-size:.9rem;font-family:inherit;resize:vertical;min-height:46px}
  .tk-progress button{margin-top:8px}
  .tk-actions{margin-top:12px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  /* 모달(레이어) */
  dialog.tk-modal{width:min(736px,96vw);max-height:92vh;border:none;border-radius:16px;padding:0;box-shadow:0 18px 50px rgba(0,0,0,.28)}
  dialog.tk-modal::backdrop{background:rgba(20,28,24,.5)}
  .tk-modal-head{position:sticky;top:0;background:var(--paper);display:flex;justify-content:space-between;align-items:center;gap:10px;padding:18px 22px;border-bottom:1px solid var(--line);z-index:2}
  .tk-modal-head h2{margin:0;font-size:1.2rem;color:var(--green-800)}
  .tk-modal-x{border:none;background:transparent;font-size:1.5rem;line-height:1;color:var(--muted);cursor:pointer;padding:2px 6px}
  .tk-modal-body{padding:18px 22px;overflow-y:auto;max-height:calc(92vh - 140px)}
  .tk-modal-foot{position:sticky;bottom:0;background:var(--paper);display:flex;gap:8px;justify-content:flex-end;padding:14px 22px;border-top:1px solid var(--line)}
  .tk-form .field{margin-bottom:12px}
  .tk-form label{display:block;font-size:.82rem;font-weight:700;color:var(--ink-soft);margin-bottom:5px}
  .tk-form .step-due-wrap{display:flex}
  .tk-newbtn{background:var(--gold-500,#c79a3b);color:#23180a;border:1px solid var(--gold-600,#b9893a);font-weight:800}
</style>
<div class="container admin-wrap">
  <div class="admin-head">
    <div><h1>업무관리</h1><p class="admin-sub">임원 업무의 진행·이슈·담당을 한눈에 관리합니다. (이슈 → 진행중 → 대기 → 보류 → 완료 순 정렬)</p></div>
    <div class="admin-head-actions">
      <button type="button" class="btn btn-sm tk-newbtn" onclick="openCreate()">+ 새 업무 등록</button>
      <a class="btn btn-neutral btn-sm" href="/exec/meetings">회의록 관리</a>
      <a class="btn btn-neutral btn-sm" href="/exec">← 업무관리</a>
    </div>
  </div>

  <% if (msg) { %><p class="form-alert ok"><%= msg %></p><% } %>
  <% if (err) { %><p class="form-alert err"><%= err %></p><% } %>

  <!-- 업무 목록 (전체 폭) -->
  <div class="tk-list-wrap">
    <% if (!tasks.length) { %>
      <div class="admin-auth-card"><p class="field-hint" style="margin:0">등록된 업무가 없습니다. 위 ‘+ 새 업무 등록’으로 추가하거나, 회의록에서 ‘AI로 업무 정리’를 해보세요.</p></div>
    <% } %>
    <% if (tasks.length) { %>
    <div class="tk-listhead">
      <span class="lh-title">업무명</span><span class="lh-st">상태</span><span class="lh-upd">마지막 업데이트</span>
    </div>
    <% } %>
    <div class="tk-cards">
        <% tasks.forEach(function(t){ var openIt = (edit && edit.id === t.id) || (typeof openId !== 'undefined' && openId === t.id); var cardSteps = parseSteps(t.steps); %>
          <details class="tk-item tk-item--<%= t.status %>"<%= openIt ? ' open' : '' %> id="task-<%= t.id %>">
            <summary class="tk-sum">
              <span class="caret">▶</span>
              <span class="s-title"><%= esc(t.title) %></span>
              <% if (cardSteps.length) { %>
                <span class="s-seg" title="단계 <%= cardSteps.filter(function(s0){return s0.done;}).length %>/<%= cardSteps.length %> 완료">
                  <% cardSteps.forEach(function(sp, i){ %><span class="seg<%= sp.done ? ' on' : '' %>" title="<%= i+1 %>. <%= esc(sp.label) %><%= sp.done ? ' (완료)' : '' %>"></span><% }); %>
                </span>
                <span class="s-rate"><%= t.rate || 0 %>%</span>
              <% } %>
              <span class="st-badge st-<%= t.status %>"><%= t.status %></span>
              <span class="s-upd"><%= t.updated_at ? fmtDate(t.updated_at) : '-' %></span>
            </summary>
            <div class="tk-body">
            <div class="tk-meta">
              <% if (t.manager) { %><span><span class="mk">담당</span><%= esc(t.manager) %></span><% } %>
              <% if (t.participants) { %><span><span class="mk">참여</span><%= esc(t.participants) %></span><% } %>
              <% if (t.due_date) { %><span><span class="mk">완료예정</span><%= esc(t.due_date) %></span><% } %>
              <% if (t.updated_at) { %><span><span class="mk">갱신</span><%= fmtDate(t.updated_at) %></span><% } %>
            </div>
            <div class="tk-rate">
              <% if (cardSteps.length) { %>
                <div class="tk-seg" title="단계 <%= cardSteps.filter(function(s0){return s0.done;}).length %>/<%= cardSteps.length %> 완료">
                  <% cardSteps.forEach(function(sp, i){ %><span class="seg<%= sp.done ? ' on' : '' %>" title="<%= i+1 %>. <%= esc(sp.label) %><%= sp.done ? ' (완료)' : '' %>"></span><% }); %>
                </div>
              <% } else { %>
                <div class="tk-rate-bar"><span style="width:<%= Math.max(0, Math.min(100, t.rate || 0)) %>%"></span></div>
              <% } %>
              <span class="tk-rate-num"><%= t.rate || 0 %>%</span>
            </div>
            <% if (cardSteps.length) { %>
              <div class="tk-field"><span class="fk">진행 단계 (완료 비율로 진행률 계산)</span>
                <div class="tk-steps">
                  <% cardSteps.forEach(function(sp, i){ %>
                    <div class="tk-step<%= sp.done ? ' done' : '' %>">
                      <span class="tk-step-ico"><%= sp.done ? '✓' : (i+1) %></span>
                      <div class="tk-step-main">
                        <span class="tk-step-label"><%= esc(sp.label) %></span>
                        <% if (sp.owner || sp.lead) { %>
                          <span class="tk-step-persons"><% if (sp.owner) { %>담당 <b><%= esc(sp.owner) %></b><% } %><% if (sp.owner && sp.lead) { %> · <% } %><% if (sp.lead) { %>책임 <b><%= esc(sp.lead) %></b><% } %></span>
                        <% } %>
                      </div>
                      <% if (sp.due) { %><span class="tk-step-due">~<%= esc(sp.due) %></span><% } %>
                      <form action="/exec/tasks/<%= t.id %>/step/toggle" method="post" style="margin:0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="idx" value="<%= i %>" />
                        <button type="submit" class="linkbtn tk-step-btn"><%= sp.done ? '완료취소' : '완료' %></button>
                      </form>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% } %>
            <% if (t.progress) { %><div class="tk-field"><span class="fk">진행 기록</span><%= esc(t.progress) %></div><% } %>
            <% if (t.issues) { %><div class="tk-field tk-issue"><span class="fk">이슈 / 문제</span><%= esc(t.issues) %></div><% } %>
            <% if (t.detail) { %><div class="tk-field"><span class="fk">상세 / 맥락</span><%= esc(t.detail) %></div><% } %>
            <form class="tk-progress" action="/exec/tasks/<%= t.id %>/progress" method="post">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label>추가사항 및 향후계획</label>
              <textarea name="note" rows="2" required placeholder="진행 상황에 누적될 내용을 입력하세요 (예: 10/20 MOU 초안 회신 받음, 다음 주 검토 회의)"></textarea>
              <button type="submit" class="btn btn-neutral btn-sm">업데이트</button>
            </form>
            <div class="tk-actions">
              <% if (t.status !== '완료') { %>
                <form action="/exec/tasks/<%= t.id %>/status" method="post" style="display:inline" onsubmit="return confirm('이 업무를 완료 처리할까요?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="status" value="완료" />
                  <button type="submit" class="btn btn-primary btn-sm">✓ 완료</button>
                </form>
              <% } else { %>
                <form action="/exec/tasks/<%= t.id %>/status" method="post" style="display:inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="status" value="진행중" />
                  <button type="submit" class="btn btn-neutral btn-sm">↺ 다시 열기</button>
                </form>
              <% } %>
              <button type="button" class="btn btn-neutral btn-sm" onclick="openEdit(<%= t.id %>)">수정</button>
              <form action="/exec/tasks/<%= t.id %>/delete" method="post" style="display:inline" onsubmit="return confirm('이 업무를 삭제할까요?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="linkbtn linkbtn-danger">삭제</button>
              </form>
            </div>
            </div><!-- /.tk-body -->
          </details>
        <% }); %>
      </div>
  </div>
</div>

<!-- 새 업무/수정 모달(레이어) -->
<dialog id="taskDlg" class="tk-modal">
  <form method="post" action="/exec/tasks" class="tk-form" id="taskForm">
    <div class="tk-modal-head">
      <h2 id="dlgTitle">새 업무 등록</h2>
      <button type="button" class="tk-modal-x" onclick="closeDlg()" aria-label="닫기">×</button>
    </div>
    <div class="tk-modal-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="id" id="tfId" value="" />
      <div class="field"><label>업무명</label><input type="text" name="title" id="tfTitle" required placeholder="예: 충남연구원 AI 스터디그룹 운영" /></div>
      <div class="field"><label>상태</label>
        <select name="status" id="tfStatus">
          <% STATUSES.forEach(function(st){ %><option value="<%= st %>"><%= st %></option><% }); %>
        </select>
      </div>
      <div class="field"><label>담당(매니징)</label><input type="text" name="manager" id="tfManager" placeholder="예: 이형구" /></div>
      <div class="field"><label>참여자</label><input type="text" name="participants" id="tfParticipants" placeholder="쉼표로 구분" /></div>
      <div class="field">
        <label>진행 상황 (단계) — 진행률 자동계산</label>
        <div id="stepList" class="step-list"></div>
        <div class="step-foot">
          <button type="button" class="btn btn-neutral btn-sm" onclick="addStep()">+ 단계 추가</button>
          <span class="step-rate">예상 진행률 <b id="rateView">0</b>%</span>
        </div>
      </div>
      <div class="field"><label>완료예정일(업무 전체)</label><input type="date" name="due_date" id="tfDue" /></div>
      <div class="field"><label>이슈 / 문제</label><textarea name="issues" id="tfIssues" placeholder="막힌 지점·결정 필요 사항"></textarea></div>
      <div class="field"><label>상세 / 맥락</label><textarea name="detail" id="tfDetail" placeholder="배경·세부 내용"></textarea></div>
      <div class="field"><label>진행 기록 (누적 메모·선택)</label><textarea name="progress" id="tfProgress" placeholder="AI 정리·추가사항이 누적되는 기록"></textarea></div>
    </div>
    <div class="tk-modal-foot">
      <button type="button" class="btn btn-neutral" onclick="closeDlg()">취소</button>
      <button type="submit" class="btn btn-primary" id="dlgSave">업무 등록</button>
    </div>
  </form>
</dialog>
<script id="tasksData" type="application/json"><%- JSON.stringify(tasks.map(function(t){ return {id:t.id,title:t.title,status:t.status,manager:t.manager,participants:t.participants,due_date:t.due_date||'',issues:t.issues,detail:t.detail,progress:t.progress,steps:parseSteps(t.steps)}; })).replace(/</g,'\\u003c') %></script>

<script>
  var TASK_MAP = {};
  (function(){ try { JSON.parse(document.getElementById('tasksData').textContent).forEach(function(t){ TASK_MAP[t.id] = t; }); } catch(e){} })();
  var dlg = document.getElementById('taskDlg');

  function escAttr(s){ return (s==null?'':String(s)); }
  function stepRowHtml(label, done, due){
    return '<div class="step-row">' +
      '<div class="step-main">' +
        '<span class="step-no"></span>' +
        '<input type="text" class="step-label-in" name="step_label" value="" placeholder="단계 내용 (예: 공고 확인 / 지원서 작성 / 최종 제출)" oninput="recalcRate()" />' +
      '</div>' +
      '<div class="step-sub">' +
        '<input type="text" class="step-person" name="step_owner" value="" placeholder="담당자" />' +
        '<input type="text" class="step-person" name="step_lead" value="" placeholder="책임자" />' +
      '</div>' +
      '<div class="step-ctrls">' +
        '<label class="step-due-wrap">완료예정 <input type="date" class="step-due-in" name="step_due" value="" /></label>' +
        '<input type="hidden" name="step_done" value="' + (done ? '1':'0') + '" />' +
        '<button type="button" class="step-done' + (done?' on':'') + '" onclick="toggleStepBtn(this)">' + (done?'완료됨':'완료') + '</button>' +
        '<button type="button" class="step-del" title="단계 삭제" onclick="delStep(this)">×</button>' +
      '</div>' +
    '</div>';
  }
  function setSteps(steps){
    var list = document.getElementById('stepList');
    list.innerHTML = '';
    if (!steps || !steps.length) steps = [{label:'',done:false,due:''},{label:'',done:false,due:''},{label:'',done:false,due:''}];
    steps.forEach(function(sp){
      var tmp = document.createElement('div'); tmp.innerHTML = stepRowHtml(sp.label, !!sp.done, sp.due);
      var row = tmp.firstChild;
      row.querySelector('input[name="step_label"]').value = sp.label || '';
      row.querySelector('input[name="step_due"]').value = sp.due || '';
      row.querySelector('input[name="step_owner"]').value = sp.owner || '';
      row.querySelector('input[name="step_lead"]').value = sp.lead || '';
      list.appendChild(row);
    });
    renumberSteps(); recalcRate();
  }
  function openCreate(){
    document.getElementById('dlgTitle').textContent = '새 업무 등록';
    document.getElementById('dlgSave').textContent = '업무 등록';
    document.getElementById('tfId').value = '';
    document.getElementById('tfTitle').value = '';
    document.getElementById('tfStatus').value = '진행중';
    document.getElementById('tfManager').value = '';
    document.getElementById('tfParticipants').value = '';
    document.getElementById('tfDue').value = '';
    document.getElementById('tfIssues').value = '';
    document.getElementById('tfDetail').value = '';
    document.getElementById('tfProgress').value = '';
    setSteps(null);
    dlg.showModal();
  }
  function openEdit(id){
    var t = TASK_MAP[id]; if (!t) return;
    document.getElementById('dlgTitle').textContent = '업무 수정';
    document.getElementById('dlgSave').textContent = '수정 저장';
    document.getElementById('tfId').value = t.id;
    document.getElementById('tfTitle').value = t.title || '';
    document.getElementById('tfStatus').value = t.status || '진행중';
    document.getElementById('tfManager').value = t.manager || '';
    document.getElementById('tfParticipants').value = t.participants || '';
    document.getElementById('tfDue').value = t.due_date || '';
    document.getElementById('tfIssues').value = t.issues || '';
    document.getElementById('tfDetail').value = t.detail || '';
    document.getElementById('tfProgress').value = t.progress || '';
    setSteps(t.steps);
    dlg.showModal();
  }
  function closeDlg(){ dlg.close(); }
  dlg.addEventListener('click', function(e){ if (e.target === dlg) dlg.close(); }); // 배경 클릭 닫기

  function recalcRate(){
    var rows = document.querySelectorAll('#stepList .step-row');
    var total = 0, done = 0;
    rows.forEach(function(r){
      var label = (r.querySelector('input[name="step_label"]').value || '').trim();
      if (!label) return;
      total++;
      if (r.querySelector('input[name="step_done"]').value === '1') done++;
    });
    var pct = total ? Math.round(done / total * 100) : 0;
    var v = document.getElementById('rateView');
    if (v) v.textContent = pct;
  }
  function toggleStepBtn(btn){
    var row = btn.closest('.step-row');
    var h = row.querySelector('input[name="step_done"]');
    if (h.value === '1') { h.value = '0'; btn.classList.remove('on'); btn.textContent = '완료'; }
    else { h.value = '1'; btn.classList.add('on'); btn.textContent = '완료됨'; }
    recalcRate();
  }
  function delStep(btn){
    var row = btn.closest('.step-row');
    row.parentNode.removeChild(row);
    renumberSteps();
    recalcRate();
  }
  function renumberSteps(){
    var nos = document.querySelectorAll('#stepList .step-row .step-no');
    nos.forEach(function(n, i){ n.textContent = i + 1; });
  }
  function addStep(){
    var list = document.getElementById('stepList');
    var tmp = document.createElement('div');
    tmp.innerHTML = stepRowHtml('', false, '');
    list.appendChild(tmp.firstChild);
    renumberSteps();
    recalcRate();
  }
  recalcRate();
</script>
