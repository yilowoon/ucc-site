<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <span class="page-banner-en">SUNLIGHT INCOME VILLAGE</span>
    <h1 class="page-banner-title">햇빛소득마을</h1>
    <p class="page-banner-desc">기후위기 대응과 지역경제 활성화를 함께 이루는, 주민 참여형 재생에너지 소득 공유 사업.</p>
  </div>
</section>

<!-- 개념 및 핵심 가치 -->
<section class="section" id="concept">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">개념 및 핵심 가치</h2><span class="section-en">CONCEPT &amp; VALUES</span></div>
    </div>
    <p class="section-lede">사단법인 도시공동체본부의 핵심 프로젝트 <strong>햇빛소득마을</strong>은 마을의 유휴 공간에 <strong>태양광 등 재생에너지 발전설비</strong>를 설치하고, 그 <strong>발전 수익을 주민이 공유</strong>하여 <strong>기후위기 대응과 지역 소득 증대</strong>를 동시에 실현하는 주민 참여형 사업입니다. 진단·설계부터 주민조합 설립, 운영·수익 배분까지 전 과정을 본부가 동반합니다.</p>

    <div class="mv-grid">
      <article class="mv-card">
        <span class="mv-icon mv-icon--green" aria-hidden="true">☀</span>
        <h3>재생에너지 기반</h3>
        <p>마을 유휴 자원을 활용해 발전설비를 조성하여 <strong>탄소중립과 에너지 자립</strong>을 실현합니다.</p>
      </article>
      <article class="mv-card">
        <span class="mv-icon mv-icon--blue" aria-hidden="true">◍</span>
        <h3>주민 참여 · 소득 공유</h3>
        <p>주민이 조합원으로 참여해 발전 수익을 <strong>지역 내에서 공정하게 배분</strong>받습니다.</p>
      </article>
      <article class="mv-card">
        <span class="mv-icon mv-icon--orange" aria-hidden="true">⟳</span>
        <h3>지역 순환 경제</h3>
        <p>수익 일부를 마을 공동사업에 재투자하여 <strong>지속 가능한 지역 순환 경제</strong>를 만듭니다.</p>
      </article>
    </div>
  </div>
</section>

<!-- 사업 추진 체계 (순환 구조) -->
<section class="section section--alt" id="system">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-blue">사업 추진 체계</h2><span class="section-en">FRAMEWORK</span></div>
    </div>
    <p class="section-lede">도시공동체본부를 중심으로 <strong>주민·기술/금융·행정</strong>이 유기적으로 협력하는 <strong>선순환 거버넌스</strong>로 추진합니다.</p>

    <div class="cycle">
      <div class="cyc-row">
        <div class="cyc-box cyc--green">
          <span class="cyc-tag">총괄 · 설계</span>
          <h3>도시공동체본부</h3>
          <p>표준 모델 개발 및 운영 지원</p>
        </div>
        <span class="cyc-h" aria-hidden="true">→</span>
        <div class="cyc-box cyc--green">
          <span class="cyc-tag">주체 · 운영</span>
          <h3>주민 · 마을조합</h3>
          <p>조합 설립 및 주도적 참여</p>
        </div>
      </div>
      <div class="cyc-mid" aria-hidden="true">
        <span class="cyc-v cyc-v--up">↑</span>
        <span class="cyc-v cyc-v--down">↓</span>
      </div>
      <div class="cyc-row">
        <div class="cyc-box cyc--orange">
          <span class="cyc-tag">행정 · 지원</span>
          <h3>지자체 · 공공</h3>
          <p>부지 및 인허가 협조</p>
        </div>
        <span class="cyc-h" aria-hidden="true">←</span>
        <div class="cyc-box cyc--blue">
          <span class="cyc-tag">기술 · 금융</span>
          <h3>기술 · 금융 파트너</h3>
          <p>EPC 시공 및 프로젝트 파이낸싱</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 사업 추진 프로세스 -->
<section class="section" id="process">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-orange">사업 추진 프로세스</h2><span class="section-en">PROCESS</span></div>
    </div>

    <ol class="sprocess">
      <li class="sproc-step">
        <span class="sproc-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6"/><line x1="15" y1="15" x2="21" y2="21"/><path d="M8 11l1.6 1.6L13 9"/></svg>
        </span>
        <span class="sproc-step-no">STEP 1</span>
        <h3>수요조사</h3>
        <p>지역 발굴 및 여건 분석</p>
      </li>
      <li class="sproc-step">
        <span class="sproc-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1.5"/><path d="M3 9h18M9 4v16"/><path d="M13 13h4M13 16h4"/></svg>
        </span>
        <span class="sproc-step-no">STEP 2</span>
        <h3>타당성 및 설계</h3>
        <p>경제성 분석 및 표준 모델 설계</p>
      </li>
      <li class="sproc-step">
        <span class="sproc-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="8.5" cy="8" r="2.6"/><circle cx="16" cy="9" r="2.2"/><path d="M3.5 19c0-3 2.2-5 5-5s5 2 5 5M14 19c.2-2.5 1.8-4 4.2-4"/></svg>
        </span>
        <span class="sproc-step-no">STEP 3</span>
        <h3>주민조합 설립</h3>
        <p>주민 협동조합 구성</p>
      </li>
      <li class="sproc-step">
        <span class="sproc-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="16" height="10" rx="1"/><path d="M3 11h16M8 6l-1 10M13 6l1 10"/><path d="M11 16v4M7 20h8"/></svg>
        </span>
        <span class="sproc-step-no">STEP 4</span>
        <h3>시공 및 설치</h3>
        <p>발전 설비 조성 및 계통 연계</p>
      </li>
      <li class="sproc-step">
        <span class="sproc-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5 5l1.8 1.8M17.2 17.2L19 19M19 5l-1.8 1.8M6.8 17.2L5 19"/></svg>
        </span>
        <span class="sproc-step-no">STEP 5</span>
        <h3>운영 및 수익배분</h3>
        <p>주민 소득 증대 및 기금 조성</p>
      </li>
    </ol>
  </div>
</section>

<!-- 법적 근거 -->
<section class="section section--alt" id="legal">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">법적 근거</h2><span class="section-en">LEGAL BASIS</span></div>
    </div>
    <p class="section-lede">햇빛소득마을은 다음의 <strong>국가 법령과 지자체 조례</strong>에 근거하여 <strong>정책적 정당성</strong>을 확보하고 있습니다.</p>

    <div class="law-list">
      <div class="law-item">
        <span class="law-ico" aria-hidden="true">§</span>
        <div><span class="law-name">탄소중립·녹색성장 기본법 <em>(탄소중립기본법)</em></span>
          <span class="law-desc">온실가스 감축, 재생에너지 보급 확대, 지역 주도의 탄소중립 이행 의무 규정</span></div>
      </div>
      <div class="law-item">
        <span class="law-ico" aria-hidden="true">§</span>
        <div><span class="law-name">신에너지 및 재생에너지 개발·이용·보급 촉진법 <em>(신재생에너지법)</em></span>
          <span class="law-desc">신재생에너지 발전 비중 확대 목표 달성 및 보급 촉진을 위한 공공부문의 역할 강조</span></div>
      </div>
      <div class="law-item">
        <span class="law-ico" aria-hidden="true">§</span>
        <div><span class="law-name">도시재생 활성화 및 지원에 관한 특별법 <em>(도시재생법)</em></span>
          <span class="law-desc">주거환경 개선 및 지역 공동체 활성화를 위한 주민 주도형 재생사업 지원</span></div>
      </div>
      <div class="law-item">
        <span class="law-ico" aria-hidden="true">§</span>
        <div><span class="law-name">협동조합 기본법</span>
          <span class="law-desc">지역 주민이 주체가 되어 설립한 마을협동조합의 사회적 경제 활동 지원</span></div>
      </div>
      <div class="law-item">
        <span class="law-ico" aria-hidden="true">§</span>
        <div><span class="law-name">각 지자체별 관련 조례</span>
          <span class="law-desc">탄소중립 이행 조례, 신재생에너지 보급 지원 조례, 도시재생 활성화 조례, 마을공동체 지원 조례 등</span></div>
      </div>
    </div>
  </div>
</section>

<!-- 추진 당위성 -->
<section class="section" id="rationale">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-blue">추진 당위성</h2><span class="section-en">WHY IT MATTERS</span></div>
    </div>
    <p class="section-lede">국제 사회와 국가, 지역이 직면한 복합 위기에 대한 <strong>현실적이고 효과적인 대안</strong>입니다.</p>

    <div class="sgrid sgrid--blue">
      <article class="scard"><h4>글로벌 탄소중립 이행</h4><p>지자체의 재생에너지 보급 확대는 인류 공통 과제인 기후위기 대응과 국가 탄소중립 목표 달성의 핵심입니다.</p></article>
      <article class="scard"><h4>국가 에너지 정책 부합</h4><p>화석연료 중심에서 분산형 재생에너지로 전환하는 국가 에너지 전환 정책에 직접 기여합니다.</p></article>
      <article class="scard"><h4>지역 소멸 극복 · 경제 활성화</h4><p>유휴 부지에서 창출한 발전 수익을 주민과 공유하여 지역 소득 증대와 지속 가능한 일자리를 만듭니다.</p></article>
      <article class="scard"><h4>사회적 가치 실현</h4><p>주민이 직접 참여하는 협동조합 모델로 지역 공동체를 회복하고 사회적 신뢰를 증진합니다.</p></article>
    </div>
  </div>
</section>

<!-- 사업 타당성 -->
<section class="section section--alt" id="feasibility">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-orange">사업 타당성</h2><span class="section-en">FEASIBILITY</span></div>
    </div>
    <p class="section-lede">실현 가능성과 지속 가능성을 검증한 <strong>체계적인 모델</strong>입니다.</p>

    <div class="sgrid sgrid--orange">
      <article class="scard"><h4>주민 주도형 지속 모델</h4><p>주민이 스스로 출자·운영하는 협동조합 방식으로 지역의 소속감과 사업 지속성을 확보합니다.</p></article>
      <article class="scard"><h4>전문성과 파트너십</h4><p>행정안전부 소관 비영리법인의 신뢰성과 다수 대학·전문기관과의 파트너십으로 안정적으로 추진합니다.</p></article>
      <article class="scard"><h4>검증된 표준 모델·프로세스</h4><p>타당성 진단부터 수익 배분까지 전 과정의 표준 모델과 프로세스를 갖춰 시행착오를 최소화합니다.</p></article>
      <article class="scard"><h4>투명한 수익성·재투자</h4><p>수익 배분을 투명하게 관리하고, 일부를 마을 공동사업에 재투자해 지역 안에서 경제가 순환합니다.</p></article>
    </div>
  </div>
</section>

<!-- 지자체 참여 효과 -->
<section class="section" id="benefits">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">지자체 참여 효과</h2><span class="section-en">FOR LOCAL GOVERNMENTS</span></div>
    </div>
    <p class="section-lede">지자체의 참여는 성공의 핵심 열쇠이며, 참여를 통해 <strong>구체적인 편익</strong>을 얻습니다.</p>

    <div class="sgrid sgrid--green">
      <article class="scard"><h4>정책 목표 조기 달성</h4><p>탄소중립·신재생에너지 보급 목표를 앞당겨 달성하고, 우수 지자체로 선정될 기회를 확보합니다.</p></article>
      <article class="scard"><h4>민원 감소 · 신속 인허가</h4><p>주민 주도형 사업으로 갈등을 사전에 완화하여 민원을 최소화하고 인허가를 신속히 진행합니다.</p></article>
      <article class="scard"><h4>예산 절감 · 행정 효율</h4><p>본부의 전문성과 민간 재원을 활용해 자체 예산 부담을 줄이고 행정력을 효율적으로 운용합니다.</p></article>
      <article class="scard"><h4>지역 경제 · 일자리</h4><p>주민 소득 증대와 지역 내 선순환 경제 구조로 지역 경제를 활성화하고 일자리를 창출합니다.</p></article>
      <article class="scard"><h4>사회적 경제 생태계</h4><p>마을협동조합 설립·운영 지원을 통해 지역 사회적 경제 생태계를 강화하고 포용 공동체를 만듭니다.</p></article>
      <article class="scard"><h4>지역 브랜드 가치 제고</h4><p>친환경·주민 친화적 조성으로 지자체 브랜드 가치를 높이고 주민의 자부심을 키웁니다.</p></article>
    </div>

    <div class="solar-closing">
      <p>사단법인 도시공동체본부는 <strong>지역 스스로 회복하는 힘을 설계하고, 그 체계를 남깁니다.</strong> 지자체의 적극적인 참여와 협력은 햇빛소득마을이 지역에 새로운 희망과 활력을 불어넣는 성공 모델로 자리 잡는 데 결정적인 역할을 합니다. 본부는 지역의 회복과 자립을 위한 <strong>최고의 파트너</strong>가 되겠습니다.</p>
      <a class="btn btn-primary" href="/about/location">지자체 · 파트너 협력 문의</a>
    </div>
  </div>
</section>

<!-- 지역별 추진 현황 (지도) -->
<section class="section section--alt" id="regions">
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-blue">지역별 추진 현황</h2><span class="section-en">STATUS BY REGION</span></div>
    </div>
    <p class="section-lede">전국 시·도별 햇빛소득마을 추진 현황입니다. <strong>지역을 선택</strong>하면 해당 지역의 상세 현황을 확인할 수 있습니다.</p>

    <div class="solar-totals">
      <div class="stot"><span class="stot-num"><%= totals.regions %></span><span class="stot-label">추진·운영 지역</span></div>
      <div class="stot"><span class="stot-num"><%= totals.villages %></span><span class="stot-label">조성 마을</span></div>
      <div class="stot"><span class="stot-num"><%= totals.households %></span><span class="stot-label">참여 가구</span></div>
      <div class="stot"><span class="stot-num"><%= totals.capacity %></span><span class="stot-label">발전용량 (MW)</span></div>
    </div>

    <%
      const SHORT = {
        seoul:"서울", incheon:"인천", gyeonggi:"경기", gangwon:"강원",
        chungnam:"충남", sejong:"세종", chungbuk:"충북", daejeon:"대전",
        gyeongbuk:"경북", daegu:"대구", jeonbuk:"전북", gyeongnam:"경남",
        ulsan:"울산", busan:"부산", gwangju:"광주", jeonnam:"전남", jeju:"제주"
      };
      // 수도권 등 라벨 겹침 방지용 위치 보정 (없으면 중심점 사용)
      const LABELPOS = {
        seoul:{x:262,y:150}, incheon:{x:170,y:150}, gyeonggi:{x:238,y:205},
        sejong:{x:288,y:290}, daejeon:{x:305,y:322}, gwangju:{x:226,y:483},
        gangwon:{x:430,y:150}
      };
    %>
    <div class="kmap-wrap">
      <svg class="kmap-svg" viewBox="0 0 800 760" role="list"
           aria-label="전국 시·도 햇빛소득마을 추진 현황" xmlns="http://www.w3.org/2000/svg">
        <% sido.forEach(function(s){ var r = byCode[s.code]; %>
          <a href="/projects/solar/<%= s.code %>" role="listitem" aria-label="<%= r.name %> <%= r.status %>">
            <title><%= r.name %> · <%= r.status %><%= r.villages > 0 ? " · " + r.villages + "마을" : "" %></title>
            <path class="kregion is-<%= r.cls %>" d="<%= s.d %>"/>
          </a>
        <% }); %>
        <% sido.forEach(function(s){ var r = byCode[s.code]; var lp = LABELPOS[s.code] || { x: s.cx, y: s.cy }; %>
          <text class="kregion-label" x="<%= lp.x %>" y="<%= lp.y %>"><%= SHORT[s.code] %></text>
          <% if (r.villages > 0) { %><text class="kregion-count" x="<%= lp.x %>" y="<%= lp.y + 13 %>"><%= r.villages %>마을</text><% } %>
        <% }); %>
      </svg>
      <ul class="kmap-legend">
        <li><span class="lg-dot is-live"></span>운영중</li>
        <li><span class="lg-dot is-active"></span>추진중</li>
        <li><span class="lg-dot is-prep"></span>준비중</li>
      </ul>
    </div>

    <!-- 목록형(접근성·모바일 보조) -->
    <div class="region-list">
      <% regions.forEach(function(r){ %>
        <a class="region-row is-<%= r.cls %>" href="/projects/solar/<%= r.code %>">
          <span class="rr-name"><%= r.name %></span>
          <span class="rr-status"><%= r.status %></span>
          <span class="rr-arrow" aria-hidden="true">→</span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
