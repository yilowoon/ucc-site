<%- include('partials/header') %>

<section class="page-banner page-banner--sm">
  <div class="container">
    <span class="page-banner-en">CORPORATE MEMBER</span>
    <h1 class="page-banner-title">기업회원</h1>
  </div>
</section>

<div class="container page-wrap">
  <article class="page-content">
    <p class="lead">기업회원은 도시공동체본부와 함께 <strong>실제 도시문제를 해결해 나가는 협력기업</strong>입니다.</p>
    <p>본부의 목적에 공감하는 기업이 회원으로 참여하여, 리빙랩·실증 사업, 공동 프로젝트, ESG 협력 등 다양한 방식으로 지역사회의 변화에 함께합니다.</p>

    <section class="corp-exec">
      <div class="corp-exec-head">
        <h2 class="corp-exec-h">임원사 <span class="corp-exec-en">EXECUTIVE PARTNERS</span></h2>
      </div>
      <p class="corp-exec-desc">
        <strong>임원사</strong>는 기업회원 가운데 도시공동체본부의 <strong>이사회에 참여</strong>하여 운영과 주요 의사결정에 함께하고,
        본부의 대표 협력사업을 앞장서서 이끌어가는 핵심 기업입니다. 일반 기업회원과 달리 본부의 방향을 함께 정하는 <strong>운영 파트너</strong>로서,
        아래는 현재 본부와 함께하고 있는 임원사입니다.
      </p>

    <%
      var featured = partners.filter(function(p){ return p.featured; });
      if (!featured.length) featured = partners;
    %>
    <div class="partner-cards">
      <% featured.forEach(function(p){ %>
        <div class="partner-card">
          <div class="partner-card-head">
            <h3 class="partner-name"><%= esc(p.name) %></h3>
            <% if (p.field) { %><span class="partner-field"><%= esc(p.field) %></span><% } %>
          </div>
          <p class="partner-intro"><%= esc(p.intro) %></p>
          <% if (p.region || p.url) { %>
            <div class="partner-meta">
              <% if (p.region) { %><span>📍 <%= esc(p.region) %></span><% } %>
              <% if (p.url) { %><a href="<%= esc(p.url) %>" target="_blank" rel="noopener">홈페이지 →</a><% } %>
            </div>
          <% } %>
        </div>
      <% }); %>
    </div>

    <div class="partner-viewall">
      <button type="button" class="btn btn-neutral" id="partnerViewAll" aria-expanded="false" aria-controls="partnerListSection">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-3px;margin-right:6px">
          <line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line>
          <circle cx="3.5" cy="6" r="1.2"></circle><circle cx="3.5" cy="12" r="1.2"></circle><circle cx="3.5" cy="18" r="1.2"></circle>
        </svg>
        전체보기
      </button>
    </div>

    <section class="reg-members partner-list" id="partnerListSection" hidden>
      <h2 class="reg-members-title">임원사 전체 목록</h2>
      <p class="reg-members-desc">도시공동체본부 임원사 <strong><%= partners.length %></strong>곳</p>
      <div class="reg-table-wrap">
        <table class="reg-table">
          <thead>
            <tr><th>기업명</th><th>분야</th><th>지역</th><th>협력 소개</th></tr>
          </thead>
          <tbody>
            <% if (!partners.length) { %>
              <tr><td colspan="4" class="reg-empty">등록된 임원사가 없습니다.</td></tr>
            <% } %>
            <% partners.forEach(function(p){ %>
              <tr>
                <td class="reg-name">
                  <% if (p.url) { %><a href="<%= esc(p.url) %>" target="_blank" rel="noopener"><%= esc(p.name) %></a><% } else { %><%= esc(p.name) %><% } %>
                </td>
                <td><%= esc(p.field || '-') %></td>
                <td><%= esc(p.region || '-') %></td>
                <td><%= esc(p.intro || '-') %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </section>
    </section><!-- /corp-exec -->

    <p style="margin-top:26px"><a class="btn btn-primary" href="/signup">기업회원 가입 · 혜택 전체보기</a></p>

    <h2 class="corp-members-h">기업회원 명단</h2>
    <p class="corp-members-desc">임원사를 포함해 도시공동체본부에 가입한 전체 기업회원 명단입니다. 회비 납부 여부에 따라 정회원·준회원으로 구분됩니다.</p>
    <%
      var groups = [
        { key: 'full',  label: '정회원', cls: 'grade-full',  note: '회비 납부가 확인된 정회원', list: full },
        { key: 'assoc', label: '준회원', cls: 'grade-assoc', note: '회비 납부 확인 전(준회원)', list: assoc }
      ];
    %>
    <%- include('partials/member-list-tabs', { groups: groups }) %>
  </article>
</div>

<script>
  (function(){
    var btn = document.getElementById('partnerViewAll');
    var sec = document.getElementById('partnerListSection');
    if (!btn || !sec) return;
    btn.addEventListener('click', function(){
      var open = sec.hasAttribute('hidden');
      if (open) { sec.removeAttribute('hidden'); btn.setAttribute('aria-expanded','true'); btn.classList.add('on'); sec.scrollIntoView({behavior:'smooth', block:'nearest'}); }
      else { sec.setAttribute('hidden',''); btn.setAttribute('aria-expanded','false'); btn.classList.remove('on'); }
    });
  })();
</script>

<%- include('partials/footer') %>
