<%- include('partials/header') %>

<section class="page-banner page-banner--sm">
  <div class="container">
    <span class="page-banner-en"><%= meta.en %></span>
    <h1 class="page-banner-title"><%= meta.name %></h1>
  </div>
</section>

<%- include('partials/board-tabs') %>

<div class="container board-wrap">
  <article class="post-view">
    <header class="post-view-head">
      <% if (post.pinned) { %><span class="badge-pin">공지</span><% } %>
      <h2 class="post-view-title"><%= esc(post.title) %></h2>
      <div class="post-view-meta">
        <span>작성자 <%= esc(post.author) %></span>
        <span>등록일 <%= fmtDateTime(post.created_at) %></span>
        <span>조회 <%= post.views %></span>
        <% if (post.updated_at && post.updated_at !== post.created_at) { %>
          <span>수정 <%= fmtDateTime(post.updated_at) %></span>
        <% } %>
      </div>
    </header>

    <% if (images.length) { %>
      <div class="post-images">
        <% images.forEach(function(img){ %>
          <figure class="post-image">
            <a href="/uploads/<%= img.filename %>" target="_blank" rel="noopener">
              <img src="/uploads/<%= img.filename %>" alt="<%= esc(img.original) %>" loading="lazy" />
            </a>
          </figure>
        <% }); %>
      </div>
    <% } %>

    <div class="post-content"><%- (typeof nl2brLink === 'function' ? nl2brLink(post.content) : nl2br(post.content)) %></div>

    <% if (files.length) { %>
      <div class="post-files">
        <h3>첨부파일</h3>
        <ul>
          <% files.forEach(function(f){ %>
            <li>
              <a href="/board/download/<%= f.id %>">
                <span class="file-ico" aria-hidden="true">📄</span>
                <span class="file-name"><%= esc(f.original) %></span>
                <span class="file-size"><%= (f.size/1024).toFixed(0) %> KB</span>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <% if (isAdmin) { %>
      <div class="post-admin-actions">
        <a class="btn btn-ghost-dark btn-sm" href="/admin/edit/<%= post.id %>">수정</a>
        <form action="/admin/delete/<%= post.id %>" method="post" onsubmit="return confirm('이 게시물을 삭제하시겠습니까? 되돌릴 수 없습니다.');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-danger btn-sm">삭제</button>
        </form>
      </div>
    <% } %>
  </article>

  <nav class="post-nav" aria-label="이전 다음 글">
    <div class="post-nav-item">
      <span>이전</span>
      <% if (prev) { %><a href="/board/<%= currentBoard %>/<%= prev.id %>"><%= esc(prev.title) %></a><% } else { %><em>이전 글이 없습니다</em><% } %>
    </div>
    <div class="post-nav-item">
      <span>다음</span>
      <% if (next) { %><a href="/board/<%= currentBoard %>/<%= next.id %>"><%= esc(next.title) %></a><% } else { %><em>다음 글이 없습니다</em><% } %>
    </div>
  </nav>

  <div class="post-view-foot">
    <a class="btn btn-neutral" href="/board/<%= currentBoard %>?page=<%= backPage %>">목록으로</a>
  </div>
</div>

<%- include('partials/footer') %>
