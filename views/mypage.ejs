<%- include('partials/header') %>
<style>
  .mypage-info-lead{margin:2px 0 12px;font-size:.9rem;line-height:1.65;color:var(--ink-soft,#3d4a44);background:var(--paper-warm,#f8f6f0);border:1px solid var(--line,#e4e2da);border-radius:10px;padding:12px 14px}
  .mypage-info-lead strong{color:var(--green-700,#1a4a3a)}
  .mypage-use{font-size:.8rem;color:var(--muted,#6b766f);font-weight:500}
</style>

<section class="page-banner">
  <div class="container">
    <span class="page-banner-en">MY PAGE</span>
    <h1 class="page-banner-title">마이페이지</h1>
    <p class="page-banner-desc"><%= esc(m.name) %> 님, 반갑습니다. 회원 정보와 등급을 확인하실 수 있습니다.</p>
  </div>
</section>

<div class="container page-wrap">
  <div class="mypage-card">
    <div class="mypage-top">
      <div class="mypage-id">
        <span class="mypage-avatar" aria-hidden="true"><%= esc(m.name.charAt(0)) %></span>
        <div>
          <h2 class="mypage-name"><%= esc(m.name) %></h2>
          <div class="mypage-badges">
            <span class="grade-badge <%= m.grade === '정회원' ? 'grade-full' : 'grade-assoc' %>"><%= esc(m.grade || '준회원') %></span>
            <span class="board-tag"><%= esc(m.member_type) %></span>
            <span class="fee-badge <%= m.fee_paid ? 'fee-ok' : 'fee-no' %>"><%= m.fee_paid ? '회비 납부' : '회비 미납' %></span>
          </div>
        </div>
      </div>
      <a class="btn btn-primary btn-sm" href="/mypage/edit">정보 수정</a>
    </div>

    <% if (m.grade !== '정회원') { %>
      <p class="mypage-notice">현재 <strong>준회원</strong>입니다. 회비 납부 후 관리자 확인을 거치면 <strong>정회원</strong>으로 전환되어 모든 회원 혜택을 이용하실 수 있습니다. 문의: 1670-9678 · contact@ucc.or.kr</p>
    <% } %>

    <p class="mypage-info-lead">아래는 회원님의 가입 정보입니다. <strong>이름</strong>은 회원증·회원 명부 식별 및 본인 확인에, <strong>이메일</strong>은 로그인 계정 식별과 회비·행사 등 필수 안내 발송에 사용됩니다.</p>
    <dl class="mypage-info">
      <div><dt>이름</dt><dd><%= esc(m.name) %> <span class="mypage-use">· 회원 식별·본인 확인용</span></dd></div>
      <div><dt>이메일</dt><dd><%= esc(m.email) %> <span class="mypage-use">· 로그인 계정·안내 발송용</span></dd></div>
      <div><dt>연락처</dt><dd><%= esc(m.phone || '-') %></dd></div>
      <div><dt>소속</dt><dd><%= esc(m.org_name || '-') %></dd></div>
      <div><dt>직급</dt><dd><%= m.position ? esc(m.position) : '미입력' %></dd></div>
      <div><dt>하시는 일</dt><dd><%= m.job ? esc(m.job) : '미입력' %></dd></div>
      <div><dt>관심 분야</dt><dd><%= m.interest ? esc(m.interest) : '미입력' %></dd></div>
      <div><dt>회원 유형</dt><dd><%= esc(m.member_type) %></dd></div>
      <div><dt>회원 등급</dt><dd><%= esc(m.grade || '준회원') %></dd></div>
      <div><dt>회비 납부</dt><dd><%= m.fee_paid ? '납부 완료' : '미납' %></dd></div>
      <div><dt>회원 가입 승인일</dt><dd><%= m.confirmed_at ? fmtDate(m.confirmed_at) : '미승인' %></dd></div>
      <div><dt>가입일</dt><dd><%= fmtDate(m.created_at) %></dd></div>
      <% var eduText = [m.education, m.edu_level].filter(Boolean).join(' · '); %>
      <% var addrText = [m.address, m.address_detail].filter(Boolean).join(' '); %>
      <div class="mypage-info-full"><dt>주소</dt><dd><%= addrText ? esc(addrText) : '미입력' %></dd></div>
      <div><dt>최종학력</dt><dd><%= eduText ? esc(eduText) : '미입력' %></dd></div>
      <div><dt>최종전공</dt><dd><%= m.major ? esc(m.major) : '미입력' %></dd></div>
      <div class="mypage-info-full"><dt>전문분야</dt><dd><%= m.specialty ? esc(m.specialty) : '미입력' %></dd></div>
    </dl>

    <div class="mypage-actions">
      <a class="btn btn-neutral btn-sm" href="/mypage/edit">정보 수정</a>
      <form action="/logout" method="post" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn-ghost btn-sm">로그아웃</button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
