<script>
(function(){
  var bar=document.getElementById('lpSticky'); if(!bar) return;
  function onScroll(){ if(window.scrollY>600) bar.classList.add('is-show'); else bar.classList.remove('is-show'); }
  window.addEventListener('scroll', onScroll, {passive:true}); onScroll();
})();
</script>

