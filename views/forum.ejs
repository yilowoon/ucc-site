<!-- 향후 추진 방향 -->
<section class="section" id="roadmap">
  <div class="container">
    <div class="section-head"><div><h2 class="section-title c-green">향후 추진 방향</h2><span class="section-en">ROADMAP</span></div></div>
    <div class="point-list">
      <article class="point-row"><span class="point-no">01</span><div class="point-body"><h3>지역 기반 혁신 커뮤니티 형성</h3><p>다양한 주체 간 협업 구조를 설계하고, <b>정기 포럼·커뮤니티 행사</b>를 활성화합니다.</p></div></article>
      <article class="point-row"><span class="point-no">02</span><div class="point-body"><h3>청년 및 창업가 육성</h3><p>세종형 혁신·창업 경진대회를 운영하고, <b>혁신·창업 교육·멘토링·초기 창업</b>을 지원합니다.</p></div></article>
      <article class="point-row"><span class="point-no">03</span><div class="point-body"><h3>세종형 로컬벤처 모델 구축</h3><p>지역문제 해결 중심의 비즈니스 모델을 개발하고, <b>공공–민간–시민사회 연계형</b> 프로젝트를 추진합니다.</p></div></article>
      <article class="point-row"><span class="point-no">04</span><div class="point-body"><h3>글로벌 네트워크 연계</h3><p>해외 도시 및 혁신 클러스터와 교류하고, <b>국제포럼·글로벌 파트너십</b>을 구축합니다.</p></div></article>
    </div>
  </div>
</section>

<!-- 두잉 기고문: 최신 글 요약 테이블 + [내용 읽기]/[목록 보기] 펼침 레이어. 평소엔 숨김(히어로 버튼으로 노출) -->
<%
  var dcLatest = (typeof latest !== "undefined" && latest) ? latest : ((typeof columns !== "undefined" && columns && columns.length) ? columns[0] : null);
  var dcOpen = (typeof openArticle !== "undefined" && openArticle) ? openArticle : null;
  var dcList = (typeof columns !== "undefined" && columns ? columns : []).map(function(c){
    return { slug: String(c.slug || c.id), title: c.title, subtitle: c.subtitle || "",
      author: c.author || "도시공동체본부", date: c.date || c.dateline || "", read_min: c.read_min || 0, category: c.category || "기고문" };
  });
%>
<section class="section section--alt" id="columns"<% if (!dcOpen) { %> hidden<% } %>>
  <div class="container">
    <div class="section-head">
      <div><h2 class="section-title c-green">두잉 기고문</h2><span class="section-en">DOING · COLUMN</span></div>
    </div>

    <% if (dcLatest) { %>
    <!-- 최신 기고문 요약 테이블 + 액션 -->
    <div class="dc-summary">
      <table class="dc-table"><tbody>
        <tr><th>제목</th><td class="dc-t"><%= dcLatest.title %></td></tr>
        <% if (dcLatest.subtitle) { %><tr><th>부제</th><td><%= dcLatest.subtitle %></td></tr><% } %>
        <tr><th>목적</th><td><%= dcLatest.purpose || dcLatest.lede || "—" %></td></tr>
        <tr><th>작성자</th><td><%= dcLatest.author || "도시공동체본부" %><% if (dcLatest.author_title) { %> <span class="dc-mut">· <%= dcLatest.author_title %></span><% } %></td></tr>
        <tr><th>작성일</th><td><%= dcLatest.date %></td></tr>
        <tr><th>소요 시간</th><td>약 <%= dcLatest.read_min %>분</td></tr>
      </tbody></table>
      <div class="dc-actions">
        <span class="dc-cat"><%= dcLatest.category || "정책 논고" %></span>
        <button type="button" class="btn btn-primary" data-dc-read="<%= dcLatest.slug || dcLatest.id %>">📖 내용 읽기</button>
        <button type="button" class="btn btn-ghost" data-dc-list>☰ 목록 보기</button>
      </div>
    </div>

    <!-- 펼침 레이어(프레임) -->
    <div class="dc-layer"<% if (!dcOpen) { %> hidden<% } %>>
      <div class="dc-layer-head">
        <span class="dc-layer-title"><span class="dc-chip">READING</span><span class="dc-layer-label">내용 읽기</span></span>
        <button type="button" class="dc-layer-close" data-dc-close>✕ 닫기</button>
      </div>
      <div class="dc-frame" id="dcFrame" data-slug="<%= dcOpen ? (dcOpen.slug || dcOpen.id) : '' %>" data-mode="<%= dcOpen ? 'content' : '' %>">
        <% if (dcOpen) { %><%- include('partials/column-article', { c: dcOpen }) %><% } %>
      </div>
    </div>
    <script type="application/json" id="dcData"><%- JSON.stringify(dcList).replace(/</g, "\\u003c") %></script>
    <% } else { %>
    <div class="df-callout" style="grid-template-columns:1fr;margin-top:24px"><div class="df-co"><span>첫 기고문을 준비하고 있습니다. 곧 이 자리에서 만나보실 수 있습니다.</span></div></div>
    <% } %>
  </div>
</section>

<!-- 마감 CTA -->
<section class="final-cta">
  <div class="container">
    <span class="fc-meet">📅 두잉날 — 매월 셋째 주 수요일 18:30</span>
    <h2>함께 실천할 동행자를 기다립니다</h2>
    <p>혁신·문화·창업·지속가능발전에 관심 있는 누구나 함께할 수 있습니다.<br>지역의 작은 행동 하나하나가 미래의 커다란 혁신이 되도록, 두잉새롬마당이 실천으로 답하겠습니다.</p>
    <div class="final-cta-btns">
      <a class="btn btn-primary btn-lg" href="/signup">참여 신청 →</a>
      <a class="btn btn-ghost-light btn-lg" href="#columns" data-col-jump><span aria-hidden="true">✍</span> 두잉 기고문 보기</a>
    </div>
  </div>
</section>

<script>
/* 두잉 기고문 하단 섹션:
   - 히어로/마감 버튼 → 섹션(요약 테이블) 노출
   - [내용 읽기] → 레이어에 전문 프레임 펼침, [목록 보기] → 같은 레이어에 목록 테이블 펼침 */
(function(){
  var SEC = document.getElementById("columns");
  if (!SEC) return;
  var layer = SEC.querySelector(".dc-layer");
  var frame = SEC.querySelector("#dcFrame");
  var labelEl = SEC.querySelector(".dc-layer-label");
  var chipEl = SEC.querySelector(".dc-chip");
  var LIST = [];
  try { LIST = JSON.parse((document.getElementById("dcData")||{}).textContent || "[]"); } catch (e) {}

  function reveal(){ SEC.removeAttribute("hidden"); }
  function scrollTo(el, flash){
    if (!el) return;
    requestAnimationFrame(function(){
      el.scrollIntoView({ behavior: "smooth", block: "start" });
      if (flash) { SEC.classList.remove("df-flash"); void SEC.offsetWidth; SEC.classList.add("df-flash"); }
    });
  }
  function esc(s){ return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
  function setHead(label, chip){ if (labelEl) labelEl.textContent = label; if (chipEl) chipEl.textContent = chip; }
  function closeLayer(push){
    if (layer) layer.setAttribute("hidden", "");
    if (frame) frame.dataset.mode = "";
    if (push && location.search) history.replaceState({}, "", "/projects/forum");
  }
  function showContent(slug, push){
    reveal();
    if (!layer || !frame) { window.location.href = "/projects/forum?column=" + encodeURIComponent(slug) + "#columns"; return; }
    layer.removeAttribute("hidden"); setHead("내용 읽기", "READING");
    // 이미 같은 글이 로드돼 있으면 재요청 없이 펼침
    if (frame.dataset.mode === "content" && frame.dataset.slug === String(slug) && frame.querySelector(".dc-article")) {
      scrollTo(layer);
      if (push) history.pushState({}, "", "/projects/forum?column=" + encodeURIComponent(slug));
      return;
    }
    frame.innerHTML = '<div class="dc-loading">기고문을 불러오는 중…</div>';
    scrollTo(layer);
    fetch("/api/columns/" + encodeURIComponent(slug), { headers: { "X-Requested-With": "fetch" } })
      .then(function(r){ if (!r.ok) throw 0; return r.json(); })
      .then(function(j){
        if (!j.ok) throw 0;
        frame.innerHTML = j.html; frame.dataset.mode = "content"; frame.dataset.slug = String(slug);
        if (push) history.pushState({}, "", "/projects/forum?column=" + encodeURIComponent(slug));
      })
      .catch(function(){ window.location.href = "/projects/forum?column=" + encodeURIComponent(slug) + "#columns"; });
  }
  function showList(push){
    reveal();
    if (!layer || !frame) return;
    var rows = LIST.map(function(c){
      return '<tr>'
        + '<td><span class="dl-title">' + esc(c.title) + '</span>' + (c.subtitle ? '<span class="dl-sub">' + esc(c.subtitle) + '</span>' : '') + '</td>'
        + '<td class="dl-nowrap">' + esc(c.author) + '</td>'
        + '<td class="dl-nowrap">' + esc(c.date) + '</td>'
        + '<td class="dl-nowrap">약 ' + esc(c.read_min) + '분</td>'
        + '<td><button type="button" class="btn btn-primary" data-dc-read="' + esc(c.slug) + '">내용 읽기</button></td>'
        + '</tr>';
    }).join("");
    frame.innerHTML = '<div class="dc-list-wrap"><table class="dc-list"><thead><tr><th>제목</th><th>작성자</th><th>작성일</th><th>소요</th><th></th></tr></thead><tbody>'
      + (rows || '<tr><td colspan="5" style="text-align:center;color:var(--muted);padding:40px 0">등록된 기고문이 없습니다.</td></tr>')
      + '</tbody></table></div>';
    frame.dataset.mode = "list"; frame.dataset.slug = "";
    layer.removeAttribute("hidden"); setHead("기고문 목록", "LIST");
    scrollTo(layer);
    if (push && location.search) history.replaceState({}, "", "/projects/forum");
  }

  document.addEventListener("click", function(e){
    var jump = e.target.closest("[data-col-jump]");
    if (jump) { e.preventDefault(); reveal(); scrollTo(SEC, true); return; }

    var read = e.target.closest("[data-dc-read]");
    if (read) {
      e.preventDefault();
      var slug = read.getAttribute("data-dc-read");
      if (layer && !layer.hasAttribute("hidden") && frame.dataset.mode === "content" && frame.dataset.slug === String(slug)) { closeLayer(true); return; }
      showContent(slug, true); return;
    }
    var list = e.target.closest("[data-dc-list]");
    if (list) {
      e.preventDefault();
      if (layer && !layer.hasAttribute("hidden") && frame.dataset.mode === "list") { closeLayer(true); return; }
      showList(true); return;
    }
    var close = e.target.closest("[data-dc-close]");
    if (close) { e.preventDefault(); closeLayer(true); return; }
  });
  window.addEventListener("popstate", function(){
    var m = location.search.match(/[?&]column=([^&#]+)/);
    if (m) showContent(decodeURIComponent(m[1]), false);
    else closeLayer(false);
  });
})();
</script>

<%- include('partials/footer') %>
