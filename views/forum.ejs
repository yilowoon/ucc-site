<%- include('partials/header') %>
<link rel="stylesheet" href="/css/column.css?v=1" />
<style>
  /* 두잉새롬마당 — 배움터 과정(AI활용전문가과정) 계열 랜딩 디자인 */
  .btn-ghost-light{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.5)}
  .btn-ghost-light:hover{background:rgba(255,255,255,.18);border-color:#fff;color:#fff;transform:translateY(-2px)}
  .lp-hero{position:relative;overflow:hidden;color:#fff;text-align:center;background:linear-gradient(rgba(16,44,33,.78), rgba(11,33,25,.9)), url('/img/forum-hero.svg') center/cover no-repeat;padding:clamp(64px,9vw,112px) 0 clamp(54px,7vw,90px)}
  .lp-hero::after{content:"";position:absolute;left:50%;top:-80px;width:440px;height:440px;transform:translateX(-50%);background:radial-gradient(circle, rgba(205,155,76,.26), transparent 68%);pointer-events:none}
  .lp-hero .container{position:relative;z-index:1}
  .lp-hero-eyebrow{display:inline-block;font-size:.78rem;letter-spacing:.22em;font-weight:800;color:var(--gold-400);margin-bottom:18px}
  .lp-hero-title{font-size:clamp(2rem,5.6vw,3.4rem);font-weight:800;line-height:1.22;letter-spacing:-1px;margin:0 0 18px}
  .lp-hero-title strong{color:#ffd98a}
  .lp-hero-sub{font-size:clamp(1rem,2.2vw,1.18rem);line-height:1.7;color:rgba(255,255,255,.9);margin:0 auto 30px;max-width:720px}
  .lp-hero-sub b{color:#ffe6b0;font-weight:700}
  .lp-hero-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .lp-hero-cta .btn-icon{font-size:1.05em;margin-right:4px}
  .lp-hero-tags{list-style:none;display:flex;gap:10px 22px;justify-content:center;flex-wrap:wrap;margin:30px 0 0;padding:0}
  .lp-hero-tags li{font-size:.92rem;font-weight:600;color:rgba(255,255,255,.82)}
  /* 카드 공통 */
  .persona-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
  .persona-card{text-align:center;background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:30px 22px;box-shadow:var(--shadow-sm);transition:transform .24s var(--ease),box-shadow .24s var(--ease)}
  .persona-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}
  .persona-ico{font-size:2.3rem;line-height:1;display:block;margin-bottom:12px}
  .persona-card h3{font-size:1.14rem;color:var(--green-800);margin:0 0 8px}
  .persona-card p{font-size:.94rem;color:var(--ink-soft);line-height:1.58;margin:0}
  .persona-card .pv-en{display:block;font-size:.72rem;letter-spacing:.14em;font-weight:800;color:var(--gold-600);margin-bottom:6px;text-transform:uppercase}
  .point-list{display:grid;gap:16px}
  .point-row{display:flex;gap:22px;align-items:flex-start;background:var(--paper);border:1px solid var(--line);border-left:4px solid var(--ci-blue);border-radius:16px;padding:26px 30px;box-shadow:var(--shadow-sm);transition:transform .22s var(--ease),box-shadow .22s var(--ease)}
  .point-row:hover{transform:translateX(4px);box-shadow:var(--shadow)}
  .point-no{flex:0 0 auto;font-size:1.7rem;font-weight:800;color:var(--ci-blue-d);line-height:1;min-width:46px}
  .point-body h3{font-size:1.2rem;color:var(--green-800);margin:0 0 7px}
  .point-body p{margin:0;color:var(--ink-soft);font-size:1rem;line-height:1.62}
  .point-body p b{color:var(--green-800)}
  /* 두잉 콜아웃(豆/0701/두잉날) */
  .df-callout{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:24px}
  .df-co{background:var(--paper-warm);border:1px solid var(--line);border-radius:14px;padding:20px 22px;box-shadow:var(--shadow-sm)}
  .df-co b{display:block;color:var(--gold-600);font-size:1.02rem;margin-bottom:6px}
  .df-co span{color:var(--ink-soft);font-size:.92rem;line-height:1.55}
  @media(max-width:720px){.df-callout{grid-template-columns:1fr}}
  /* 색상 체계 스와치 */
  .df-sw{display:flex;align-items:center;gap:12px;padding:8px 0;border-top:1px solid var(--paper-alt)}
  .df-sw:first-of-type{border-top:0}
  .df-sw i{width:34px;height:34px;border-radius:8px;flex:0 0 auto}
  .df-sw .sw-name{font-weight:700;color:var(--green-800);font-size:.92rem}
  .df-sw .sw-hex{color:var(--muted);font-size:.78rem;font-variant-numeric:tabular-nums}
  .df-sw .sw-mean{margin-left:auto;color:var(--ink-soft);font-size:.82rem;text-align:right}
  /* 강조 배너 */
  .lp-band{text-align:center;color:#fff;padding:clamp(48px,7vw,78px) 0;background:radial-gradient(120% 130% at 50% 0%, #1f5540, #0e2a20 72%);position:relative;overflow:hidden}
  .lp-band::after{content:"";position:absolute;left:50%;top:-100px;width:420px;height:420px;transform:translateX(-50%);background:radial-gradient(circle, rgba(205,155,76,.2), transparent 68%);pointer-events:none}
  .lp-band .container{position:relative;z-index:1}
  .lp-band-lead{font-size:clamp(1.1rem,2.6vw,1.45rem);font-weight:700;color:#e9efe9;margin:0 0 8px}
  .lp-band-title{font-size:clamp(1.7rem,4.4vw,2.5rem);font-weight:800;margin:0 0 14px;letter-spacing:-.5px}
  .lp-band-title b{color:#ffd98a}
  .lp-band-sub{color:rgba(255,255,255,.82);font-size:1.02rem;line-height:1.7;max-width:640px;margin:0 auto 26px}
  .lp-band-stack{list-style:none;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin:0;padding:0}
  .lp-band-stack li{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:11px 20px;font-weight:700;font-size:.96rem}
  /* 마감 CTA */
  .final-cta{text-align:center;color:#fff;padding:clamp(56px,8vw,92px) 0;background:radial-gradient(120% 130% at 50% 0%, #1f5540, #0e2a20 70%);position:relative;overflow:hidden}
  .final-cta::after{content:"";position:absolute;left:50%;bottom:-120px;width:460px;height:460px;transform:translateX(-50%);background:radial-gradient(circle, rgba(205,155,76,.18), transparent 68%)}
  .final-cta .container{position:relative;z-index:1}
  .final-cta .fc-meet{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:8px 18px;font-weight:700;font-size:.9rem;margin-bottom:18px}
  .final-cta h2{font-size:clamp(1.5rem,3.6vw,2.2rem);font-weight:800;margin:0 0 14px;letter-spacing:-.5px}
  .final-cta p{color:rgba(255,255,255,.88);font-size:1.05rem;line-height:1.7;margin:0 0 28px}
  .final-cta-btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  /* 기고문 섹션 — 평소엔 숨김, '두잉 기고문 보기' 클릭 시에만 노출 */
  /* (헤더 간격은 전역 html{scroll-padding-top:88px}로 처리되므로 scroll-margin 중복 금지) */
  #columns[hidden]{display:none}
  #columns.df-flash{animation:dfFlash 1.6s var(--ease)}
  @keyframes dfFlash{0%{box-shadow:inset 0 0 0 3px var(--gold-400)}100%{box-shadow:inset 0 0 0 3px transparent}}
  /* 최신 기고문 요약 테이블 + 액션 */
  .dc-summary{display:flex;gap:0;align-items:stretch;background:var(--paper);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow-sm);overflow:hidden;margin-top:26px}
  .dc-table{flex:1;border-collapse:collapse;font-size:.98rem}
  .dc-table th{width:96px;text-align:left;vertical-align:top;padding:14px 10px 14px 26px;color:var(--gold-600);font-weight:800;font-size:.84rem;white-space:nowrap;border-bottom:1px solid var(--paper-alt)}
  .dc-table td{padding:14px 26px 14px 0;color:var(--ink-soft);line-height:1.55;border-bottom:1px solid var(--paper-alt);word-break:keep-all}
  .dc-table tr:last-child th,.dc-table tr:last-child td{border-bottom:0}
  .dc-table .dc-t{font-weight:800;color:var(--green-900);font-size:1.14rem;letter-spacing:-.02em}
  .dc-table .dc-mut{color:var(--muted);font-weight:500}
  .dc-actions{flex:0 0 auto;display:flex;flex-direction:column;gap:10px;justify-content:center;padding:22px 24px;background:var(--paper-warm);border-left:1px solid var(--line);min-width:200px}
  .dc-cat{font-size:.72rem;font-weight:800;letter-spacing:.08em;color:var(--gold-600);text-transform:uppercase;text-align:center;margin-bottom:4px}
  .dc-actions .btn{width:100%;justify-content:center}
  @media(max-width:720px){.dc-summary{flex-direction:column}.dc-actions{flex-direction:row;flex-wrap:wrap;border-left:0;border-top:1px solid var(--line);min-width:0}.dc-cat{width:100%}.dc-table th{padding-left:18px}.dc-table td{padding-right:18px}.dc-actions .btn{flex:1}}
  /* 펼침 레이어(프레임) */
  .dc-layer{margin-top:14px;border:1px solid var(--line);border-radius:18px;background:var(--paper);box-shadow:var(--shadow);overflow:hidden;animation:dcExpand .34s var(--ease)}
  .dc-layer[hidden]{display:none}
  @keyframes dcExpand{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:none}}
  .dc-layer-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 22px;background:var(--green-800);color:#fff}
  .dc-layer-title{font-weight:800;font-size:1rem;display:flex;align-items:center}
  .dc-chip{font-size:.68rem;font-weight:800;color:var(--gold-400);letter-spacing:.14em;margin-right:10px;border:1px solid rgba(220,178,106,.5);border-radius:999px;padding:2px 9px}
  .dc-layer-close{background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.32);color:#fff;border-radius:999px;padding:6px 15px;font-weight:700;font-size:.84rem;cursor:pointer;transition:background .18s var(--ease)}
  .dc-layer-close:hover{background:rgba(255,255,255,.24)}
  .dc-frame{padding:clamp(18px,3vw,34px) var(--gutter)}
  .dc-frame .col-shell{padding:0}
  .dc-loading{text-align:center;color:var(--muted);font-weight:600;padding:50px 0}
  /* 목록 테이블 */
  .dc-list-wrap{overflow-x:auto}
  .dc-list{width:100%;border-collapse:collapse;font-size:.95rem;min-width:520px}
  .dc-list thead th{background:var(--green-800);color:#fff;font-weight:700;text-align:left;padding:12px 16px;font-size:.88rem;white-space:nowrap}
  .dc-list td{padding:14px 16px;border-bottom:1px solid var(--paper-alt);color:var(--ink-soft);vertical-align:middle}
  .dc-list tbody tr:hover{background:var(--paper-warm)}
  .dc-list .dl-title{font-weight:800;color:var(--green-900)}
  .dc-list .dl-sub{display:block;color:var(--muted);font-size:.84rem;margin-top:3px;font-weight:500}
  .dc-list .dl-nowrap{white-space:nowrap}
  .dc-list .btn{padding:7px 16px;font-size:.84rem;white-space:nowrap}
</style>

<!-- 히어로 -->
<section class="lp-hero">
  <div class="container">
    <span class="lp-hero-eyebrow">DOING INNOVATION FORUM · DIF</span>
    <h1 class="lp-hero-title">세종의 미래를 <strong>행동(Doing)</strong>으로</h1>
    <p class="lp-hero-sub"><b>두잉새롬마당</b>은 세종특별자치시를 중심으로 지속가능한 지역혁신 생태계를 조성하는 <b>민간 주도형 혁신 플랫폼</b>입니다. 말이 아닌 <b>행동</b>으로, 형식이 아닌 <b>실천</b>으로 세종을 사람 중심·혁신 중심 도시로 전환시켜 갑니다.</p>
    <div class="lp-hero-cta">
      <a class="btn btn-primary btn-lg" href="/signup">참여 신청 →</a>
      <a class="btn btn-ghost-light btn-lg" href="#columns" data-col-jump><span class="btn-icon" aria-hidden="true">✍</span> 두잉 기고문 보기</a>
    </div>
    <ul class="lp-hero-tags">
      <li>✓ 민간 주도</li>
      <li>✓ 혁신 지향</li>
      <li>✓ 지역 기반</li>
      <li>✓ 글로벌 연결</li>
    </ul>
  </div>
</section>

<!-- 한눈에 -->
<section class="section" id="facts" style="padding-top:38px">
  <div class="container">
    <div class="course-facts">
      <div class="cf-item"><span class="cf-label">브랜드 명</span><span class="cf-value">두잉새롬마당</span></div>
