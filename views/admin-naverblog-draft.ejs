<%- include('partials/header') %>
<div class="container admin-wrap">
  <div class="admin-head">
    <div>
      <h1>네이버 블로그 원고</h1>
      <p class="admin-sub"><%= boardName %> · <%= fmtDate(post.created_at) %> · <a href="/board/<%= post.board %>/<%= post.id %>" target="_blank" rel="noopener">원문 보기</a></p>
    </div>
    <div class="admin-head-actions">
      <% if (writeUrl) { %>
        <a class="btn btn-primary btn-sm" href="<%= writeUrl %>" target="_blank" rel="noopener">네이버 글쓰기 열기</a>
      <% } %>
      <a class="btn btn-neutral btn-sm" href="/admin/naver-blog/<%= post.id %>/draft.txt">원고 내려받기</a>
      <a class="btn btn-neutral btn-sm" href="/admin/naver-blog?board=<%= post.board %>">목록</a>
    </div>
  </div>

  <div class="nb-note">
    <span class="nb-note-ico" aria-hidden="true">📝</span>
    <div>
      <p><b>붙여넣는 순서</b> — ① 제목 복사 → 네이버 글쓰기 제목란에 붙여넣기 ②
        본문 복사 → 스마트에디터 본문에 붙여넣기 ③ 아래 사진을 본문 흐름에 맞춰 올리기 ④
        태그 복사 → 태그 입력란에 붙여넣기.</p>
      <p>본문 맨 아래에는 원문 링크가 자동으로 들어갑니다. 블로그 방문자가 우리 누리집으로
        넘어오게 하는 장치이니 지우지 마세요. 태그는 <b>본문에 넣지 않고</b> 태그 입력란에만
        붙여넣습니다 — 네이버가 글 하단에 알아서 보여 줍니다.</p>
    </div>
  </div>

  <div class="nb-grid">
    <!-- 왼쪽: 붙여넣을 원고 -->
    <div>
      <div class="nb-card">
        <div class="nb-label">
          <span>제목</span>
          <button type="button" class="btn btn-neutral btn-sm" data-copy="#nbTitle">제목 복사</button>
        </div>
        <p class="nb-text nb-text--title" id="nbTitle"><%= draft.title %></p>
      </div>

      <div class="nb-card">
        <div class="nb-label">
          <span>본문 (공백 제외 <%= draft.bodyLength.toLocaleString() %>자)</span>
          <button type="button" class="btn btn-primary btn-sm" data-copy="#nbBody">본문 복사</button>
        </div>
        <pre class="nb-text nb-text--body" id="nbBody"><%= draft.body %></pre>
      </div>

      <div class="nb-card">
        <div class="nb-label">
          <span>태그 <%= draft.tags.length %>개</span>
          <button type="button" class="btn btn-neutral btn-sm" data-copy="#nbTags">태그 복사</button>
        </div>
        <p class="nb-text" id="nbTags"><%= draft.tagLine %></p>
      </div>
    </div>

    <!-- 오른쪽: 점검 · 올릴 파일 -->
    <div>
      <div class="nb-card">
        <h2>발행 전 점검</h2>
        <ul class="nb-check">
          <% draft.checklist.forEach(function(c){ %>
            <li class="<%= c.ok ? 'ok' : 'warn' %>">
              <span class="nb-check-mark" aria-hidden="true"><%= c.ok ? '✓' : '!' %></span>
              <span><b><%= c.label %></b><em><%= c.hint %></em></span>
            </li>
          <% }); %>
        </ul>
      </div>

      <div class="nb-card">
        <h2>올릴 사진 <%= draft.images.length %>장</h2>
        <% if (!draft.images.length) { %>
          <p class="nb-empty">이 글에는 이미지 첨부가 없습니다. 게시판 글을 수정해 사진을 추가하면 여기에 나타납니다.</p>
        <% } else { %>
          <div class="nb-imgs">
            <% draft.images.forEach(function(img, i){ %>
              <a class="nb-img" href="<%= img.url %>" download target="_blank" rel="noopener" title="<%= esc(img.name) %>">
                <img src="<%= img.url %>" alt="<%= esc(img.name) %>" loading="lazy" />
                <span><%= i + 1 %>. <%= img.name %></span>
              </a>
            <% }); %>
          </div>
        <% } %>
      </div>

      <% if (draft.files.length) { %>
        <div class="nb-card">
          <h2>첨부자료 <%= draft.files.length %>개</h2>
          <ul class="nb-check">
            <% draft.files.forEach(function(f){ %>
              <li><span class="nb-check-mark" aria-hidden="true">📎</span><span><a href="<%= f.url %>"><%= f.name %></a></span></li>
            <% }); %>
          </ul>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
(function(){
  // 복사 버튼 — data-copy="선택자" 로 지정한 요소의 텍스트를 클립보드에 담는다.
  // navigator.clipboard 는 HTTPS(또는 localhost)에서만 동작하므로, 실패 시 예전 방식으로 되돌린다.
  function toast(msg){
    var el = document.createElement('div');
    el.className = 'nb-toast';
    el.setAttribute('role', 'status');
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(function(){ el.remove(); }, 2000);
  }
  function legacyCopy(text){
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
    return ok;
  }
  document.addEventListener('click', function(e){
    var btn = e.target.closest('[data-copy]');
    if (!btn) return;
    var src = document.querySelector(btn.getAttribute('data-copy'));
    if (!src) return;
    var text = src.textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(
        function(){ toast('복사했습니다. 네이버 글쓰기 창에 붙여넣으세요.'); },
        function(){ toast(legacyCopy(text) ? '복사했습니다.' : '복사에 실패했습니다. 직접 선택해 복사해 주세요.'); }
      );
    } else {
      toast(legacyCopy(text) ? '복사했습니다.' : '복사에 실패했습니다. 직접 선택해 복사해 주세요.');
    }
  });
})();
</script>
<%- include('partials/footer') %>
