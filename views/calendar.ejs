<%- include('partials/header') %>

<section class="page-banner page-banner--sm">
  <div class="container">
    <span class="page-banner-en">EDUCATION CALENDAR</span>
    <h1 class="page-banner-title">연간교육일정</h1>
  </div>
</section>

<div class="container page-wrap cal-wrap">
  <div class="cal-head">
    <a class="cal-nav" href="/learn/calendar?ym=<%= prevYm %>" aria-label="이전 달">‹</a>
    <h2 class="cal-title"><%= (typeof lang !== 'undefined' && lang === 'en') ? (['','January','February','March','April','May','June','July','August','September','October','November','December'][month] + ' ' + year) : (year + '년 ' + month + '월') %></h2>
    <a class="cal-nav" href="/learn/calendar?ym=<%= nextYm %>" aria-label="다음 달">›</a>
  </div>

  <div class="cal-grid" role="grid">
    <% var _dow = (typeof lang !== 'undefined' && lang === 'en') ? ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'] : ['일','월','화','수','목','금','토']; %>
    <div class="cal-dow cal-dow--sun"><%= _dow[0] %></div>
    <div class="cal-dow"><%= _dow[1] %></div><div class="cal-dow"><%= _dow[2] %></div><div class="cal-dow"><%= _dow[3] %></div>
    <div class="cal-dow"><%= _dow[4] %></div><div class="cal-dow"><%= _dow[5] %></div>
    <div class="cal-dow cal-dow--sat"><%= _dow[6] %></div>

    <% weeks.forEach(function(week){ %>
      <% week.forEach(function(cell, i){ %>
        <% if (!cell) { %>
          <div class="cal-cell cal-cell--empty"></div>
        <% } else {
             var dateStr = ym + '-' + String(cell.day).padStart(2,'0');
             var isToday = dateStr === today;
             var wk = i === 0 ? ' cal-cell--sun' : (i === 6 ? ' cal-cell--sat' : '');
        %>
          <div class="cal-cell<%= wk %><%= isToday ? ' cal-cell--today' : '' %>">
            <span class="cal-day"><%= cell.day %></span>
            <% cell.events.forEach(function(ev){ %>
              <span class="cal-event cal-event--<%= (ev.category==='ESG'?'esg':(ev.category==='RDC'?'rdc':(ev.category==='AI'?'ai':'etc'))) %>" title="<%= esc(ev.title) %><%= ev.memo ? ' — ' + esc(ev.memo) : '' %>">
                <%= esc(ev.title) %>
              </span>
            <% }); %>
          </div>
        <% } %>
      <% }); %>
    <% }); %>
  </div>

  <div class="cal-legend">
    <span><i class="lg lg--esg"></i>ESG전문가과정</span>
    <span><i class="lg lg--rdc"></i>지역혁신개발전문가과정</span>
    <span><i class="lg lg--ai"></i>AI활용전문가과정</span>
    <span><i class="lg lg--etc"></i>기타</span>
    <a class="cal-apply" href="/learn/apply">교육 신청하기 →</a>
  </div>
</div>

<%- include('partials/footer') %>
