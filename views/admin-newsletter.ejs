<%- include('partials/header') %>
<div class="container admin-wrap">
  <div class="admin-head">
    <div>
      <h1>뉴스레터 관리</h1>
      <p class="admin-sub">사회적경제 등 키워드 뉴스를 매일 08:00·18:00 자동 수집합니다. 수집 소스: <b><%= naver ? '네이버 뉴스 API' : 'Google 뉴스 RSS' %></b><% if (!naver) { %> · 네이버 API 키를 설정하면 요약·원문 이미지가 풍부해집니다<% } %></p>
    </div>
    <div class="admin-head-actions">
      <a class="btn btn-neutral btn-sm" href="/newsletter" target="_blank" rel="noopener">공개 페이지</a>
      <a class="btn btn-neutral btn-sm" href="/admin">대시보드</a>
    </div>
  </div>

  <% if (msg === 'collecting') { %>
    <p class="form-alert ok">수집을 시작했습니다. 잠시 후(약 1분) 페이지를 새로고침하면 반영됩니다.</p>
  <% } %>

  <div class="member-toolbar">
    <div class="member-stats" style="margin:0"><span class="mstat"><b><%= total.toLocaleString() %></b> 총 뉴스레터</span></div>
    <form method="post" action="/admin/newsletter/collect" onsubmit="return confirm('지금 뉴스를 수집할까요? (약 1분 소요)');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn btn-primary btn-sm">지금 수집</button>
    </form>
  </div>

  <% if (!items.length) { %>
    <p class="post-empty">아직 수집된 뉴스레터가 없습니다. ‘지금 수집’을 눌러 시작하세요.</p>
  <% } else { %>
  <div class="member-scroll">
    <table class="log-table">
      <thead><tr><th>수집일(KST)</th><th>키워드</th><th>출처</th><th>제목</th><th>원문</th><th>관리</th></tr></thead>
      <tbody>
        <% items.forEach(function(n){ %>
          <tr>
            <td class="log-time"><%= fmtDate(n.created_at) %></td>
            <td><span class="nl-kw"><%= esc(n.keyword) %></span></td>
            <td><%= esc(n.source || '-') %></td>
            <td class="log-path"><%= esc(n.title) %></td>
            <td><% if (n.url) { %><a href="<%= esc(n.url) %>" target="_blank" rel="noopener">링크</a><% } else { %>-<% } %></td>
            <td>
              <form action="/admin/newsletter/<%= n.id %>/delete" method="post" onsubmit="return confirm('이 항목을 삭제할까요?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <input type="hidden" name="page" value="<%= page %>" />
                <button type="submit" class="linkbtn linkbtn-danger">삭제</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="pager">
    <% if (page > 1) { %><a class="btn btn-neutral btn-sm" href="/admin/newsletter?page=<%= page-1 %>">← 이전</a><% } %>
    <span class="pager-info"><%= page %> / <%= pages %> 페이지</span>
    <% if (page < pages) { %><a class="btn btn-neutral btn-sm" href="/admin/newsletter?page=<%= page+1 %>">다음 →</a><% } %>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
