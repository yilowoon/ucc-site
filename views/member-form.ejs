<%- include('partials/header') %>
<div class="container admin-auth-wrap">
  <div class="admin-auth-card">
    <% if (mode === 'signup') { %>
      <h1>회원가입</h1>
      <p class="admin-auth-sub">도시공동체본부 회원으로 함께하세요.</p>
      <% if (error) { %><p class="form-alert err"><%= error %></p><% } %>
      <form method="post" action="/signup" class="admin-form-fields">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field"><label for="name">이름</label><input type="text" id="name" name="name" value="<%= esc(form.name || '') %>" autocomplete="name" required /></div>
        <div class="field"><label for="email">이메일</label><input type="email" id="email" name="email" value="<%= esc(form.email || '') %>" autocomplete="email" required /></div>
        <div class="field"><label for="phone">연락처 <span class="field-hint">선택</span></label><input type="tel" id="phone" name="phone" value="<%= esc(form.phone || '') %>" autocomplete="tel" /></div>
        <div class="field"><label for="password">비밀번호 <span class="field-hint">8자 이상</span></label><input type="password" id="password" name="password" autocomplete="new-password" required minlength="8" /></div>
        <div class="field"><label for="confirm">비밀번호 확인</label><input type="password" id="confirm" name="confirm" autocomplete="new-password" required minlength="8" /></div>
        <button type="submit" class="btn btn-primary btn-block">가입하기</button>
      </form>
      <p class="admin-auth-hint">이미 회원이신가요? <a href="/login">로그인</a></p>
    <% } else { %>
      <h1>로그인</h1>
      <p class="admin-auth-sub">회원 로그인</p>
      <% if (typeof joined !== 'undefined' && joined) { %><p class="form-alert ok">회원가입이 완료되었습니다. 로그인해 주세요.</p><% } %>
      <% if (error) { %><p class="form-alert err"><%= error %></p><% } %>
      <form method="post" action="/login" class="admin-form-fields">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <% if (typeof next !== 'undefined' && next) { %><input type="hidden" name="next" value="<%= esc(next) %>" /><% } %>
        <div class="field"><label for="email">이메일</label><input type="email" id="email" name="email" value="<%= esc(form.email || '') %>" autocomplete="email" required autofocus /></div>
        <div class="field"><label for="password">비밀번호</label><input type="password" id="password" name="password" autocomplete="current-password" required /></div>
        <button type="submit" class="btn btn-primary btn-block">로그인</button>
      </form>

      <% var _oap = (typeof oauthProviders !== 'undefined' ? oauthProviders : []); %>
      <% if (_oap.length) { %>
        <div class="sns-login">
          <div class="sns-login-div"><span>SNS 간편 로그인</span></div>
          <div class="sns-btns">
            <% _oap.forEach(function(o){ %>
              <a class="sns-btn sns-<%= o.key %>" href="/auth/<%= o.key %><%= (typeof next !== 'undefined' && next) ? ('?next=' + encodeURIComponent(next)) : '' %>">
                <span class="sns-ico" aria-hidden="true">
                  <% if (o.key === 'kakao') { %>
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.9 3 2.8 6.3 2.8 10.3c0 2.6 1.7 4.9 4.3 6.2-.2.7-.7 2.5-.8 2.9 0 .2 0 .4.3.3.2-.1 2.7-1.8 3.7-2.5.6.1 1.1.1 1.7.1 5.1 0 9.2-3.3 9.2-7.3S17.1 3 12 3z"/></svg>
                  <% } else if (o.key === 'naver') { %>
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.3 3v9.3L8.2 3H3v18h4.7v-9.3L15.8 21H21V3z"/></svg>
                  <% } else { %>
                    <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M23 12.3c0-.8-.1-1.5-.2-2.3H12v4.5h6.2a5.3 5.3 0 0 1-2.3 3.5v2.9h3.7c2.2-2 3.4-5 3.4-8.6z"/><path fill="#34A853" d="M12 24c3.1 0 5.7-1 7.6-2.8l-3.7-2.9c-1 .7-2.4 1.1-3.9 1.1-3 0-5.5-2-6.4-4.8H1.8v3C3.7 21.4 7.5 24 12 24z"/><path fill="#FBBC05" d="M5.6 14.6a7.2 7.2 0 0 1 0-4.6v-3H1.8a12 12 0 0 0 0 10.6z"/><path fill="#EA4335" d="M12 4.8c1.7 0 3.2.6 4.4 1.7l3.3-3.3C17.7 1.2 15.1 0 12 0 7.5 0 3.7 2.6 1.8 6.4l3.8 3c.9-2.8 3.4-4.6 6.4-4.6z"/></svg>
                  <% } %>
                </span>
                <span class="sns-txt"><%= o.label %>로 시작하기</span>
              </a>
            <% }); %>
          </div>
          <p class="sns-note">처음이시면 <b>소셜 계정으로 바로 회원가입</b>되고, 가입 후 마이페이지에서 정보를 보완할 수 있습니다.</p>
        </div>
      <% } %>

      <p class="admin-auth-hint">
        <a href="/login/forgot">비밀번호를 잊으셨나요?</a>
        <span class="admin-auth-sep">·</span>
        아직 회원이 아니신가요? <a href="/signup">회원가입</a>
      </p>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
