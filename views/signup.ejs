        </thead>
        <tbody>
          <tr><td rowspan="3" class="ms-cat">정회원</td><td>개인회원</td><td>1만원</td><td>1만원 <span class="ms-sub">(익년도부터)</span></td><td class="ms-yes">있음</td></tr>
          <tr><td>기업회원</td><td>30만원</td><td>30만원 <span class="ms-sub">(익년도부터)</span></td><td class="ms-yes">대표 1인</td></tr>
          <tr><td>단체회원</td><td>무료 <span class="ms-sub">(현재)</span></td><td>익년도부터 유료 <span class="ms-sub">(이사회 결정)</span></td><td class="ms-yes">대표 1인</td></tr>
          <tr><td class="ms-cat">준회원</td><td>공통</td><td>미납</td><td>미납</td><td class="ms-no">없음</td></tr>
