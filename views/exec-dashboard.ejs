<%- include('partials/header') %>
<style>
  .exec-today{font-size:.92rem;font-weight:700;color:var(--muted);margin:2px 0 16px}
  .exec-today b{color:var(--green-800)}
  .exec-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px;margin:8px 0 24px}
  .exec-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:18px 20px;box-shadow:var(--shadow-sm)}
  .exec-card .k{font-size:.8rem;color:var(--muted);font-weight:700}
  .exec-card .v{font-size:1.9rem;font-weight:800;color:var(--green-800);line-height:1.1;margin-top:4px}
  .exec-sec{margin-bottom:22px}
  .exec-sec .sec-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px}
  .exec-sec h2{margin:0;font-size:1.2rem}
  .st-badge{display:inline-block;font-size:.72rem;font-weight:800;border-radius:999px;padding:3px 10px;color:#fff;white-space:nowrap}
  .st-이슈{background:#c5221f}.st-진행중{background:#1b93c6}.st-대기{background:#8a6d00}.st-보류{background:#8a939c}.st-완료{background:#2b8a5a}
  .ex-table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--paper)}
  .ex-table{width:100%;border-collapse:collapse;min-width:720px;font-size:.9rem}
  .ex-table thead th{background:var(--paper-warm,#f6f4ee);color:var(--green-800);font-weight:800;font-size:.82rem;text-align:left;padding:12px 14px;border-bottom:1px solid var(--line);white-space:nowrap}
  .ex-table tbody td{padding:12px 14px;border-bottom:1px solid var(--line);vertical-align:middle;color:var(--ink)}
  .ex-table tbody tr:last-child td{border-bottom:0}
  .ex-table tbody tr:hover{background:#fcfbf7}
  .ex-table .c-no{width:1%;color:var(--muted);text-align:center;white-space:nowrap}
  .ex-table .c-title{font-weight:700}
  .ex-table .c-title a{color:var(--green-800)}
  .ex-table .nowrap{white-space:nowrap}
  .ex-table .muted{color:var(--muted)}
  .mini-rate{display:flex;align-items:center;gap:8px;min-width:120px}
  .mini-rate-bar{flex:1;height:7px;background:var(--paper-warm,#eee);border:1px solid var(--line);border-radius:999px;overflow:hidden}
  .mini-rate-bar span{display:block;height:100%;background:linear-gradient(90deg,#1b93c6,#2b8a5a);border-radius:999px}
  .mini-rate-num{font-size:.78rem;font-weight:800;color:var(--green-800);min-width:34px;text-align:right}
  .ex-empty{padding:22px 16px;text-align:center;color:var(--muted)}
  .upd-chip{font-size:.66rem;font-weight:900;letter-spacing:.04em;color:#fff;background:#e8830c;border-radius:6px;padding:2px 7px;text-transform:uppercase}
  .seen-chip{font-size:.74rem;font-weight:800;border-radius:999px;padding:3px 10px}
  .seen-ok{background:#e9f6ee;color:#2b8a5a;border:1px solid #cfe6d7}
  .seen-no{background:#f3f1ee;color:#9aa4ad;border:1px solid var(--line)}
</style>
<div class="container admin-wrap">
  <div class="admin-head">
    <div><h1>임원 업무관리</h1><p class="admin-sub">카카오톡 대화(회의록)를 올려 업무를 AI로 정리하고, 진행·이슈·담당을 체계적으로 관리합니다.</p></div>
    <div class="admin-head-actions">
      <a class="btn btn-neutral btn-sm" href="/exec/meetings">회의록 관리</a>
      <a class="btn btn-primary btn-sm" href="/exec/tasks">업무 보드</a>
    </div>
  </div>

  <p class="exec-today">📅 오늘 <b><%= today %></b> 기준</p>

  <div class="exec-cards">
    <div class="exec-card"><span class="k">전체 업무</span><span class="v"><%= stats.taskTotal %></span></div>
    <div class="exec-card"><span class="k">진행중</span><span class="v" style="color:#1b93c6"><%= stats.counts['진행중'] %></span></div>
    <div class="exec-card"><span class="k">이슈</span><span class="v" style="color:#c5221f"><%= stats.counts['이슈'] %></span></div>
    <div class="exec-card"><span class="k">완료</span><span class="v" style="color:#2b8a5a"><%= stats.counts['완료'] %></span></div>
    <div class="exec-card"><span class="k">회의록</span><span class="v"><%= stats.logCount %></span></div>
  </div>

  <!-- 주요 업무: 전체 폭 테이블 -->
  <section class="exec-sec">
    <div class="sec-head">
      <h2>주요 업무</h2>
      <a class="btn btn-neutral btn-sm" href="/exec/tasks">업무 보드 전체보기 →</a>
    </div>
    <div class="ex-table-wrap">
      <table class="ex-table">
        <thead>
          <tr>
            <th class="c-no">번호</th><th>타이틀</th><th class="nowrap">업무담당자</th>
            <th class="nowrap">작성일</th><th class="nowrap">현재 상태</th><th>진행률</th><th class="nowrap">완료예정일</th><th class="nowrap">업데이트</th>
          </tr>
        </thead>
        <tbody>
          <% if (!tasks.length) { %>
            <tr><td colspan="8" class="ex-empty">등록된 업무가 없습니다. 회의록을 올리고 ‘AI로 업무 정리’를 해보세요.</td></tr>
          <% } %>
          <% tasks.forEach(function(t, i){ var r = Math.max(0, Math.min(100, t.rate || 0)); %>
            <tr>
              <td class="c-no"><%= i + 1 %></td>
              <td class="c-title"><a href="/exec/tasks?edit=<%= t.id %>"><%= esc(t.title) %></a></td>
              <td class="nowrap"><% if (t.manager) { %><%= esc(t.manager) %><% } else { %><span class="muted">-</span><% } %></td>
              <td class="nowrap muted"><%= fmtDate(t.created_at) || '-' %></td>
              <td class="nowrap"><span class="st-badge st-<%= t.status %>"><%= t.status %></span></td>
              <td>
                <span class="mini-rate">
                  <span class="mini-rate-bar"><span style="width:<%= r %>%"></span></span>
                  <span class="mini-rate-num"><%= r %>%</span>
                </span>
              </td>
              <td class="nowrap <%= t.due_date ? '' : 'muted' %>"><%= t.due_date ? esc(t.due_date) : '-' %></td>
              <td class="nowrap"><% if (typeof pendingIds !== 'undefined' && pendingIds.has(t.id)) { %><span class="upd-chip">update</span><% } else { %><span class="muted">-</span><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 최근 회의록: 전체 폭 테이블 -->
  <section class="exec-sec">
    <div class="sec-head">
      <h2>최근 회의록</h2>
      <a class="btn btn-neutral btn-sm" href="/exec/meetings">회의록 관리 →</a>
    </div>
    <div class="ex-table-wrap">
      <table class="ex-table">
        <thead>
          <tr>
            <th class="c-no">번호</th><th>회의록(제목)</th><th class="nowrap">기간</th>
            <th class="nowrap">메시지</th><th>참여자</th><th class="nowrap">등록일</th>
          </tr>
        </thead>
        <tbody>
          <% if (!logs.length) { %>
            <tr><td colspan="6" class="ex-empty">업로드된 대화가 없습니다.</td></tr>
          <% } %>
          <% logs.forEach(function(l, i){ var period = (l.period_from || '') + (l.period_to && l.period_to !== l.period_from ? ' ~ ' + l.period_to : ''); %>
            <tr>
              <td class="c-no"><%= i + 1 %></td>
              <td class="c-title"><a href="/exec/meetings/<%= l.id %>"><%= esc(l.title) %></a></td>
              <td class="nowrap muted"><%= period || '-' %></td>
              <td class="nowrap"><%= l.msg_count %>건</td>
              <td><% if (l.participants) { %><%= esc(l.participants) %><% } else { %><span class="muted">-</span><% } %></td>
              <td class="nowrap muted"><%= fmtDate(l.created_at) || '-' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- 임원 확인 현황 (참여도) -->
  <section class="exec-sec">
    <div class="sec-head">
      <h2>임원 확인 현황</h2>
      <span class="field-hint" style="margin:0">임원이 업무관리 페이지를 마지막으로 확인한 시각입니다.</span>
    </div>
    <div class="ex-table-wrap">
      <table class="ex-table">
        <thead>
          <tr>
            <th class="c-no">번호</th><th>임원</th><th class="nowrap">소속</th><th class="nowrap">직급</th>
            <th class="nowrap">마지막 확인</th><th class="nowrap">상태</th>
          </tr>
        </thead>
        <tbody>
          <% if (!execs || !execs.length) { %>
            <tr><td colspan="6" class="ex-empty">승인된 임원이 없습니다. 관리자 → 회원 상세에서 ‘임원으로 승인’하면 표시됩니다.</td></tr>
          <% } %>
          <% (execs || []).forEach(function(m, i){ var seen = (m.exec_seen_at || '').trim(); var isMe = (typeof viewerId !== 'undefined' && viewerId === m.id); %>
            <tr<%= isMe ? ' style="background:#f1f8f3"' : '' %>>
              <td class="c-no"><%= i + 1 %></td>
              <td class="c-title"><%= esc(m.name || '-') %><% if (isMe) { %> <span class="field-hint">(나)</span><% } %></td>
              <td class="nowrap"><% if (m.org_name) { %><%= esc(m.org_name) %><% } else { %><span class="muted">-</span><% } %></td>
              <td class="nowrap"><% if (m.position) { %><%= esc(m.position) %><% } else { %><span class="muted">-</span><% } %></td>
              <td class="nowrap <%= seen ? '' : 'muted' %>"><%= seen ? ((typeof fmtDateTime !== 'undefined') ? fmtDateTime(seen) : seen.slice(0,16).replace('T',' ')) : '-' %></td>
              <td class="nowrap"><% if (seen) { %><span class="seen-chip seen-ok">확인</span><% } else { %><span class="seen-chip seen-no">미확인</span><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p class="field-hint" style="margin-top:8px">※ ‘마지막 확인’은 임원이 로그인 후 업무관리 화면을 연 가장 최근 시각입니다. (관리자 접속은 집계에서 제외)</p>
  </section>
</div>
<%- include('partials/footer') %>
