<%- include('partials/header') %>
<style>
  .exec-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px;margin:8px 0 24px}
  .exec-card{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:18px 20px;box-shadow:var(--shadow-sm)}
  .exec-card .k{font-size:.8rem;color:var(--muted);font-weight:700}
  .exec-card .v{font-size:1.9rem;font-weight:800;color:var(--green-800);line-height:1.1;margin-top:4px}
  .exec-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  @media(max-width:820px){.exec-grid{grid-template-columns:1fr}}
  .st-badge{font-size:.72rem;font-weight:800;border-radius:999px;padding:2px 9px;color:#fff}
  .st-이슈{background:#c5221f}.st-진행중{background:#1b93c6}.st-대기{background:#8a6d00}.st-보류{background:#8a939c}.st-완료{background:#2b8a5a}
  .exec-list{list-style:none;margin:0;padding:0}
  .exec-list li{padding:11px 0;border-bottom:1px solid var(--line);display:flex;gap:10px;align-items:center;justify-content:space-between}
  .exec-list li:last-child{border-bottom:0}
  .exec-list a{color:var(--green-800);font-weight:700}
</style>
<div class="container admin-wrap">
  <div class="admin-head">
    <div><h1>임원 업무관리</h1><p class="admin-sub">카카오톡 대화(회의록)를 올려 업무를 AI로 정리하고, 진행·이슈·담당을 체계적으로 관리합니다.</p></div>
    <div class="admin-head-actions">
      <a class="btn btn-neutral btn-sm" href="/exec/meetings">회의록 관리</a>
      <a class="btn btn-primary btn-sm" href="/exec/tasks">업무 보드</a>
    </div>
  </div>

  <div class="exec-cards">
    <div class="exec-card"><span class="k">전체 업무</span><span class="v"><%= stats.taskTotal %></span></div>
    <div class="exec-card"><span class="k">진행중</span><span class="v" style="color:#1b93c6"><%= stats.counts['진행중'] %></span></div>
    <div class="exec-card"><span class="k">이슈</span><span class="v" style="color:#c5221f"><%= stats.counts['이슈'] %></span></div>
    <div class="exec-card"><span class="k">완료</span><span class="v" style="color:#2b8a5a"><%= stats.counts['완료'] %></span></div>
    <div class="exec-card"><span class="k">회의록</span><span class="v"><%= stats.logCount %></span></div>
  </div>

  <div class="exec-grid">
    <div class="admin-auth-card">
      <h2 style="margin-top:0;">주요 업무</h2>
      <% if (!tasks.length) { %><p class="field-hint">등록된 업무가 없습니다. 회의록을 올리고 ‘AI로 업무 정리’를 해보세요.</p><% } %>
      <ul class="exec-list">
        <% tasks.forEach(function(t){ %>
          <li>
            <a href="/exec/tasks?edit=<%= t.id %>"><%= esc(t.title) %></a>
            <span style="display:flex;gap:8px;align-items:center;white-space:nowrap">
              <% if (t.manager) { %><span class="field-hint"><%= esc(t.manager) %></span><% } %>
              <span class="st-badge st-<%= t.status %>"><%= t.status %></span>
            </span>
          </li>
        <% }); %>
      </ul>
      <p style="margin-top:12px"><a class="btn btn-neutral btn-sm" href="/exec/tasks">업무 보드 전체보기 →</a></p>
    </div>

    <div class="admin-auth-card">
      <h2 style="margin-top:0;">최근 회의록</h2>
      <% if (!logs.length) { %><p class="field-hint">업로드된 대화가 없습니다.</p><% } %>
      <ul class="exec-list">
        <% logs.forEach(function(l){ %>
          <li>
            <a href="/exec/meetings/<%= l.id %>"><%= esc(l.title) %></a>
            <span class="field-hint"><%= l.msg_count %>건 · <%= l.period_from || fmtDate(l.created_at) %></span>
          </li>
        <% }); %>
      </ul>
      <p style="margin-top:12px"><a class="btn btn-neutral btn-sm" href="/exec/meetings">회의록 관리 →</a></p>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
