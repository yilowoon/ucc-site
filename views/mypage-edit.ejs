<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <span class="page-banner-en">MY PAGE</span>
    <h1 class="page-banner-title">내 정보 수정</h1>
    <p class="page-banner-desc"><%= hasPassword ? '정보를 변경하려면 보안을 위해 현재 비밀번호를 입력해야 합니다.' : '소셜 로그인 계정입니다. 아래에서 정보를 입력·완성해 주세요.' %></p>
  </div>
</section>

<div class="container page-wrap">
  <!-- 회비 안내 플로팅(스크롤 따라다님) — 회원유형에 따라 실시간 갱신 -->
  <aside class="mp-fee-float" id="mpFeeFloat" aria-label="회비 안내">
    <h3>💳 회비 안내</h3>
    <div class="amt" id="mpFeeAmt">연 10,000원</div>
    <p class="msg" id="mpFeeMsg"></p>
    <p class="mp-fee-note">정회원 전환 시 위 회비가 적용됩니다. (회비 납부 확인 후 관리자 승인)</p>
  </aside>

  <% if (typeof welcome !== 'undefined' && welcome) { %>
    <section class="mp-guide">
      <div class="mp-guide-head">
        <span class="mp-guide-badge">간편로그인 완료</span>
        <h2 class="mp-guide-title">환영합니다! 소셜 계정으로 가입되었어요</h2>
      </div>
      <p class="mp-guide-lead">
        현재 회원님은 <b>준회원</b>입니다. 준회원만으로도 사이트의 대부분 서비스를 <b>바로 이용</b>하실 수 있어요.
        아래 두 가지 중 편한 쪽을 선택하시면 됩니다 — <b>지금 굳이 정보를 입력하지 않으셔도 됩니다.</b>
      </p>
      <div class="mp-guide-cards">
        <div class="mp-guide-card">
          <h3>① 준회원으로 계속 이용</h3>
          <p>추가 정보 입력 없이 지금 바로 공지·소식·프로젝트 등 서비스를 이용하실 수 있습니다. 정보는 <b>언제든</b> 마이페이지에서 보완할 수 있어요.</p>
          <a class="btn btn-neutral btn-sm" href="/">지금은 건너뛰고 둘러보기 →</a>
        </div>
        <div class="mp-guide-card is-hi">
          <h3>② 정회원으로 전환하기</h3>
          <p>정회원은 정기총회 의결권, 정회원 명단 등재 등 정식 회원 혜택을 받습니다. 전환하려면 아래 정보(특히 <b>이름·연락처·소속</b>)를 채워 저장한 뒤, <b>회비 납부가 확인되면 관리자가 정회원으로 승인</b>합니다.</p>
          <span class="mp-guide-arrow">↓ 아래 폼에서 정보를 입력해 주세요</span>
        </div>
      </div>
    </section>
  <% } %>
  <% if (done) { %><p class="form-alert ok" style="max-width:560px;margin:0 auto 18px"><%= done %></p><% } %>

  <div class="mypage-edit-grid">
    <!-- 정보 수정 -->
    <div class="mypage-card">
      <h2 class="mypage-h">기본 정보</h2>
      <% if (error) { %><p class="form-alert err"><%= error %></p><% } %>
      <form method="post" action="/mypage/edit" class="admin-form-fields" autocomplete="off">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field">
          <label for="email">이메일</label>
          <input type="email" id="email" name="email" value="<%= esc(m.email) %>" data-orig="<%= esc(m.email) %>" autocomplete="off" required />
          <p class="email-check" id="emailCheck" role="status" aria-live="polite"></p>
          <div class="email-verify" id="emailVerify" hidden>
            <button type="button" class="btn btn-neutral btn-sm" id="btnSendCode">인증코드 받기</button>
            <div class="code-row" id="codeRow" hidden>
              <input type="text" id="email_code" inputmode="numeric" maxlength="6" placeholder="메일로 받은 6자리 코드" oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
              <button type="button" class="btn btn-primary btn-sm" id="btnVerifyCode">확인</button>
            </div>
            <p class="verify-msg" id="verifyMsg" role="status" aria-live="polite"></p>
          </div>
          <span class="field-hint">이메일을 바꾸려면 새 이메일 입력 후 인증을 완료해 주세요.</span>
        </div>
        <div class="field"><label>회원 등급</label><input type="text" value="<%= esc(m.grade || '준회원') %>" disabled /><span class="field-hint">정회원 전환은 회비 확인 후 관리자가 처리합니다.</span></div>
        <div class="field"><label for="member_type">회원 유형</label>
          <select id="member_type" name="member_type">
            <% ['개인회원','기업회원','단체회원'].forEach(function(t){ %>
              <option value="<%= t %>" <%= (m.member_type === t) ? 'selected' : '' %>><%= t %></option>
            <% }); %>
          </select>
        </div>

        <input type="hidden" name="convert" id="convertFlag" value="0" />
        <input type="hidden" name="paid" id="mpPaid" value="0" />
        <input type="hidden" name="pay_method" id="mpPayMethod" value="" />

        <% if ((m.grade || '준회원') !== '정회원') { %>
          <div class="mp-convert" id="mpConvert">
            <p class="mp-convert-q">정회원으로 전환하시겠습니까?</p>
            <p class="mp-convert-sub">정회원은 정기총회 의결권·명단 등재 등 정식 회원 혜택을 받습니다. 아래 회비 납부에 동의하고 저장하면 결제 절차가 진행됩니다.</p>
            <button type="button" class="btn btn-neutral" id="convertBtn">정회원으로 전환</button>
            <div class="mp-convert-agree" id="mpConvertAgree" hidden>
              <div class="su-fee-row" id="feeRow">
                <input type="checkbox" id="fee_agree" name="fee_agree" value="1" />
                <label for="fee_agree" id="feeLabel">회비 납부에 동의합니다.</label>
              </div>
              <button type="button" class="linkbtn" id="convertCancel">전환 취소</button>
            </div>
          </div>
        <% } %>
        <div class="field"><label for="name">이름 <span class="field-hint">기업/단체는 담당자명</span></label><input type="text" id="name" name="name" value="<%= esc(m.name) %>" autocomplete="name" required /></div>
        <div class="field"><label for="phone">연락처 <span class="field-hint">숫자만 입력</span></label><input type="tel" id="phone" name="phone" value="<%= esc(m.phone || '') %>" autocomplete="off" inputmode="numeric" pattern="[0-9]{9,11}" maxlength="11" placeholder="숫자만 입력 (예: 01012345678)" oninput="this.value=this.value.replace(/[^0-9]/g,'')" /></div>
        <div class="field"><label for="org_name">소속 <span class="field-hint">소속기관이 없으면 '도시공동체본부'</span></label><input type="text" id="org_name" name="org_name" value="<%= esc(m.org_name || '') %>" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" placeholder="소속기관·단체명 (없으면 도시공동체본부)" /></div>
        <div class="field"><label for="position">직급 <span class="field-hint">선택</span></label><input type="text" id="position" name="position" value="<%= esc(m.position || '') %>" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" placeholder="예: 대표, 팀장, 연구원" /></div>
        <div class="field"><label for="job">하시는 일 <span class="field-hint">선택</span></label><input type="text" id="job" name="job" value="<%= esc(m.job || '') %>" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" placeholder="담당 업무·활동" /></div>
        <div class="field"><label for="interest">관심 분야 <span class="field-hint">선택</span></label><input type="text" id="interest" name="interest" value="<%= esc(m.interest || '') %>" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" placeholder="예: 사회적경제, 도시재생, 협동조합" /></div>
        <div class="field">
          <label for="address">주소</label>
          <div class="addr-row">
            <input type="text" id="address" name="address" value="<%= esc(m.address || '') %>" autocomplete="off" placeholder="주소 검색을 눌러 도로명 주소를 입력하세요" readonly />
            <button type="button" class="btn btn-neutral btn-sm" id="addrSearchBtn">주소 검색</button>
          </div>
        </div>
        <div class="field"><label for="address_detail">상세주소 <span class="field-hint">선택</span></label><input type="text" id="address_detail" name="address_detail" value="<%= esc(m.address_detail || '') %>" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" placeholder="건물·동·호수 등" /></div>
        <div class="write-grid">
          <div class="field"><label for="education">최종학력 · 학교 <span class="field-hint">선택</span></label><input type="text" id="education" name="education" value="<%= esc(m.education || '') %>" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" placeholder="예: OO대학교" /></div>
          <div class="field">
            <label for="edu_level">학위 <span class="field-hint">선택</span></label>
            <select id="edu_level" name="edu_level">
              <option value="">선택</option>
              <% ['고등학교','전문학사','학사','석사','박사','기타'].forEach(function(l){ %>
                <option value="<%= l %>" <%= (m.edu_level === l) ? 'selected' : '' %>><%= l %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="field"><label for="major">최종전공 <span class="field-hint">선택</span></label><input type="text" id="major" name="major" value="<%= esc(m.major || '') %>" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" placeholder="예: 도시공학" /></div>
        <div class="field"><label for="specialty">전문분야 <span class="field-hint">선택</span></label><input type="text" id="specialty" name="specialty" value="<%= esc(m.specialty || '') %>" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" placeholder="예: ESG 경영·지역개발 컨설팅" /></div>
        <% if (hasPassword) { %>
          <div class="field field--gate"><label for="current">현재 비밀번호 <span class="field-hint">보안 확인</span></label><input type="password" id="current" name="current" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" required /></div>
        <% } %>
        <button type="submit" class="btn btn-primary btn-block">정보 저장</button>
      </form>
    </div>

    <!-- 비밀번호 변경/설정 -->
    <div class="mypage-card">
      <h2 class="mypage-h"><%= hasPassword ? '비밀번호 변경' : '비밀번호 설정' %></h2>
      <% if (!hasPassword) { %>
        <p class="mypage-notice" style="margin-bottom:18px">소셜 로그인 계정입니다. 비밀번호를 설정하면 <b>이메일+비밀번호로도 로그인</b>할 수 있습니다. (선택 사항)</p>
      <% } %>
      <% if (pwError) { %><p class="form-alert err"><%= pwError %></p><% } %>
      <form method="post" action="/mypage/password" class="admin-form-fields">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <% if (hasPassword) { %>
          <div class="field"><label for="pw_current">현재 비밀번호</label><input type="password" id="pw_current" name="current" autocomplete="current-password" required /></div>
        <% } %>
        <div class="field"><label for="newpw">새 비밀번호 <span class="field-hint">8자 이상</span></label><input type="password" id="newpw" name="newpw" autocomplete="new-password" required minlength="8" /></div>
        <div class="field"><label for="pw_confirm">새 비밀번호 확인</label><input type="password" id="pw_confirm" name="confirm" autocomplete="new-password" required minlength="8" /></div>
        <button type="submit" class="btn btn-neutral btn-block"><%= hasPassword ? '비밀번호 변경' : '비밀번호 설정' %></button>
      </form>
    </div>
  </div>

  <p style="text-align:center;margin-top:18px"><a class="btn btn-ghost btn-sm" href="/mypage">← 마이페이지로</a></p>
</div>

<!-- 정회원 전환 결제 모달 (회원가입과 동일) -->
<div class="su-modal" id="mpModal" role="dialog" aria-modal="true" aria-label="회비 납부">
  <div class="su-modal-card">
    <button type="button" class="su-x" id="mpPayCancel" aria-label="닫기">&times;</button>
    <h3>회비 납부</h3>
    <div class="su-pay-sum"><span id="mpPayType">개인회원</span><b id="mpPayAmt">10,000원</b></div>
    <div class="su-tabs">
      <button type="button" class="su-tab active" data-m="bank">무통장 입금</button>
      <button type="button" class="su-tab" data-m="toss">카드·간편결제</button>
    </div>
    <div class="su-pane" id="mpPaneBank">
      <p class="su-warn">신청 후 <b>1주일 이내</b>에 회비가 납부되어야 정상 처리됩니다.</p>
      <div class="su-acct">
        <div><span>은행</span> 하나은행</div>
        <div><span>계좌</span> <b>602-910286-92405</b><button type="button" class="su-copy" data-copy="602-910286-92405">복사</button></div>
        <div><span>예금주</span> 사단법인 도시공동체본부</div>
      </div>
      <img class="su-acct-img" src="/img/account-copy.jpg" alt="사단법인 도시공동체본부 법인 계좌 사본" loading="lazy" />
      <button type="button" class="btn btn-primary btn-block" id="mpBankDone">무통장 입금으로 신청 완료</button>
    </div>
    <div class="su-pane" id="mpPaneToss" hidden>
      <div class="su-pay-line total"><span>결제 금액</span><span id="mpPayAmt2">10,000원</span></div>
      <p class="su-pay-note">※ 현재는 <b>데모 결제</b>입니다. 실제 청구되지 않으며, PG 연동 시 이 창에서 카드·간편결제로 실제 납부가 진행됩니다.</p>
      <button type="button" class="btn btn-primary btn-block" id="mpPayNow">결제하기</button>
    </div>
  </div>
</div>

<style>
  /* 정회원 전환 UI */
  .mp-convert{border:1px solid var(--gold-500);background:var(--paper-warm);border-radius:12px;padding:16px 18px;margin:2px 0 6px}
  .mp-convert-q{font-weight:800;color:var(--green-800);margin:0 0 4px;font-size:1rem}
  .mp-convert-sub{font-size:.86rem;color:var(--ink-soft);line-height:1.6;margin:0 0 12px}
  .mp-convert-agree{margin-top:12px}
  .mp-convert.is-on #convertBtn{display:none}
  .su-fee-row{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--line);background:#fff;border-radius:10px;padding:12px 14px;margin:0 0 8px}
  .su-fee-row input{margin-top:3px;width:18px;height:18px;accent-color:var(--green-700);flex:none}
  .su-fee-row label{font-size:.94rem;color:var(--ink);line-height:1.6;cursor:pointer}
  /* 결제 모달(회원가입과 동일) */
  .su-modal{position:fixed;inset:0;z-index:9999;background:rgba(13,33,28,.55);display:none;align-items:center;justify-content:center;padding:20px}
  .su-modal.open{display:flex}
  .su-modal-card{position:relative;background:#fff;border-radius:16px;max-width:420px;width:100%;padding:22px;box-shadow:0 24px 60px -18px rgba(14,42,32,.5);max-height:90vh;overflow:auto}
  .su-modal-card h3{margin:0 0 12px;font-size:1.15rem;color:var(--green-800)}
  .su-x{position:absolute;top:12px;right:14px;border:none;background:none;font-size:22px;line-height:1;color:var(--muted);cursor:pointer}
  .su-pay-sum{display:flex;justify-content:space-between;align-items:baseline;background:var(--paper-warm);border-radius:10px;padding:10px 14px;margin:0 0 14px;font-size:.92rem}
  .su-pay-sum b{color:var(--green-800);font-size:1.25rem;font-weight:800}
  .su-tabs{display:flex;gap:6px;margin-bottom:14px}
  .su-tab{flex:1;padding:9px 6px;border:1px solid var(--line);background:#fff;border-radius:9px;font-size:.88rem;font-weight:700;color:var(--muted);cursor:pointer}
  .su-tab.active{background:linear-gradient(150deg,var(--green-800),var(--green-900));color:#fff;border-color:var(--green-800)}
  .su-warn{background:#fff6e6;border:1px solid var(--gold-500);border-radius:9px;padding:10px 12px;font-size:.85rem;color:#7a5a1a;margin:0 0 12px;line-height:1.6}
  .su-acct{border:1px solid var(--line);border-radius:9px;padding:8px 14px;font-size:.9rem;margin-bottom:12px}
  .su-acct>div{display:flex;align-items:center;gap:8px;padding:5px 0}
  .su-acct>div span{color:var(--muted);width:42px;flex-shrink:0;font-size:.8rem}
  .su-acct b{color:var(--ink);font-weight:700}
  .su-copy{margin-left:auto;border:1px solid var(--line);background:var(--paper-warm);border-radius:6px;font-size:.72rem;padding:3px 9px;cursor:pointer;color:var(--green-800)}
  .su-acct-img{display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:9px;margin-bottom:14px}
  .su-pay-line{display:flex;justify-content:space-between;padding:10px 0;font-size:.95rem}
  .su-pay-line.total{border-top:2px solid var(--green-800);font-weight:800;color:var(--green-800);font-size:1.1rem}
  .su-pay-note{font-size:.82rem;color:var(--muted);background:var(--paper-alt);border-radius:8px;padding:10px 12px;margin:6px 0 14px;line-height:1.6}

  /* 회비 안내 플로팅 레이어 — 스크롤해도 따라다님(position:fixed) */
  .mp-fee-float{position:fixed;top:120px;right:24px;width:250px;z-index:40;border:1px solid var(--gold-500);background:var(--paper-warm);border-radius:14px;padding:18px 20px;box-shadow:0 16px 40px -14px rgba(14,42,32,.35)}
  .mp-fee-float h3{font-size:1rem;color:var(--gold-600);margin:0 0 8px;display:flex;align-items:center;gap:8px}
  .mp-fee-float .amt{font-size:1.4rem;font-weight:800;color:var(--green-800);margin:2px 0 8px}
  .mp-fee-float .msg{font-size:.9rem;color:var(--ink-soft);line-height:1.65;margin:0}
  .mp-fee-note{font-size:.8rem;color:var(--muted);margin:10px 0 0;padding-top:10px;border-top:1px dashed var(--line);line-height:1.5}
  @media(max-width:1240px){.mp-fee-float{display:none}} /* 좁은 화면에선 본문과 겹치지 않도록 숨김 */
  #emailVerify{margin-top:10px}
  .code-row{display:flex;gap:8px;margin-top:8px}
  .code-row input{flex:1;letter-spacing:4px;font-weight:700;text-align:center}
  .code-row input[readonly]{background:#e3f2e8;color:var(--green-800)}
  .code-row .btn{flex-shrink:0}
  .email-check{font-size:.82rem;margin:6px 0 0;min-height:1.1em}
  .email-check.ok{color:var(--green-700)} .email-check.err{color:#b53a2e}
  .verify-msg{font-size:.82rem;margin:8px 0 0;min-height:1em}
  .verify-msg.ok{color:var(--green-700);font-weight:600} .verify-msg.err{color:#b53a2e}
</style>
<script>
// 회비 안내 플로팅 — 회원유형 선택에 따라 실시간 갱신
(function(){
  var sel=document.getElementById('member_type'), amt=document.getElementById('mpFeeAmt'), msg=document.getElementById('mpFeeMsg');
  if(!sel||!amt) return;
  var FEES={"개인회원":10000,"기업회원":300000,"단체회원":0};
  var MSG={"개인회원":"개인회원 회비는 연 1만원입니다.","기업회원":"기업회원 회비는 연 30만원입니다.","단체회원":"단체회원은 현재(2026년) 규정상 무료로 운영합니다."};
  function won(n){return n.toLocaleString('ko-KR')+'원';}
  function upd(){var t=sel.value,f=FEES[t]||0; amt.textContent=(f>0)?('연 '+won(f)):'무료'; msg.textContent=MSG[t]||'';}
  sel.addEventListener('change',upd); upd();
})();
</script>
<script>
// 정회원 전환 + 회비 결제(회원가입 흐름과 동일)
(function(){
  var convert=document.getElementById('mpConvert'); if(!convert) return; // 이미 정회원이면 없음
  var sel=document.getElementById('member_type');
  var btn=document.getElementById('convertBtn'), cancel=document.getElementById('convertCancel');
  var agree=document.getElementById('mpConvertAgree'), feeChk=document.getElementById('fee_agree'), feeLabel=document.getElementById('feeLabel');
  var flag=document.getElementById('convertFlag'), paidInput=document.getElementById('mpPaid'), methodInput=document.getElementById('mpPayMethod');
  var editForm=feeChk.closest('form');
  var FEES={"개인회원":10000,"기업회원":300000,"단체회원":0};
  function won(n){return n.toLocaleString('ko-KR')+'원';}
  function fee(){return FEES[sel.value]||0;}
  function updLabel(){ var f=fee(); feeLabel.textContent = f>0 ? (sel.value+' 회비(연 '+won(f)+') 납부에 동의합니다.') : (sel.value+'은 현재 무료입니다. 정회원 전환에 동의합니다.'); }
  sel.addEventListener('change', updLabel); updLabel();

  var on=false, paymentConfirmed=false;
  btn.addEventListener('click', function(){ on=true; flag.value='1'; agree.hidden=false; convert.classList.add('is-on'); });
  cancel.addEventListener('click', function(){ on=false; flag.value='0'; agree.hidden=true; convert.classList.remove('is-on'); feeChk.checked=false; paidInput.value='0'; methodInput.value=''; paymentConfirmed=false; });

  // 결제 모달
  var modal=document.getElementById('mpModal');
  var payType=document.getElementById('mpPayType'), payAmt=document.getElementById('mpPayAmt'), payAmt2=document.getElementById('mpPayAmt2');
  var payNow=document.getElementById('mpPayNow'), payCancel=document.getElementById('mpPayCancel'), bankDone=document.getElementById('mpBankDone');
  var tabs=modal.querySelectorAll('.su-tab'), paneBank=document.getElementById('mpPaneBank'), paneToss=document.getElementById('mpPaneToss');
  function selectMethod(m){ tabs.forEach(function(t){t.classList.toggle('active',t.dataset.m===m);}); paneBank.hidden=(m!=='bank'); paneToss.hidden=(m!=='toss'); }
  tabs.forEach(function(t){ t.addEventListener('click', function(){ selectMethod(t.dataset.m); }); });
  function openModal(){ var f=fee(); payType.textContent=sel.value; payAmt.textContent=won(f); payAmt2.textContent=won(f); payNow.disabled=false; payNow.textContent='결제하기'; selectMethod('bank'); modal.classList.add('open'); }
  function closeModal(){ modal.classList.remove('open'); }
  payCancel.addEventListener('click', closeModal);
  modal.addEventListener('click', function(e){
    if(e.target===modal){ closeModal(); return; }
    var b=e.target.closest('.su-copy'); if(b && navigator.clipboard){ navigator.clipboard.writeText(b.dataset.copy).then(function(){ b.textContent='복사됨'; setTimeout(function(){b.textContent='복사';},1200); }); }
  });
  bankDone.addEventListener('click', function(){ methodInput.value='bank'; paidInput.value='0'; paymentConfirmed=true; closeModal(); editForm.requestSubmit(); });
  payNow.addEventListener('click', function(){ payNow.disabled=true; payNow.textContent='결제 처리 중…'; setTimeout(function(){ methodInput.value='toss'; paidInput.value='1'; paymentConfirmed=true; closeModal(); editForm.requestSubmit(); }, 1000); });

  // 저장 시 전환 흐름 개입
  editForm.addEventListener('submit', function(e){
    if(!on) return; // 전환 안 하면 일반 저장
    var f=fee();
    if(f>0 && !feeChk.checked){ e.preventDefault(); alert('회비 납부에 동의해 주셔야 정회원 전환이 진행됩니다.'); feeChk.focus(); return; }
    if(f>0 && !paymentConfirmed){ e.preventDefault(); openModal(); return; }
    // 무료(단체) 또는 결제 완료 → 그대로 제출
  });
})();
</script>
<script>
(function(){
  var inp=document.getElementById('email'); if(!inp) return;
  var orig=(inp.dataset.orig||'').toLowerCase();
  var chk=document.getElementById('emailCheck'), verify=document.getElementById('emailVerify');
  var codeRow=document.getElementById('codeRow'), codeInput=document.getElementById('email_code');
  var btnSend=document.getElementById('btnSendCode'), btnVerify=document.getElementById('btnVerifyCode'), vmsg=document.getElementById('verifyMsg');
  var re=/^[^\s@]+@[^\s@]+\.[^\s@]+$/, emailOk=false, verified=false, timer=null;
  var form=inp.closest('form');

  function reset(){ verified=false; verify.hidden=true; codeRow.hidden=true; codeInput.value=''; codeInput.readOnly=false;
    vmsg.textContent=''; vmsg.className='verify-msg'; btnSend.disabled=false; btnSend.textContent='인증코드 받기'; btnVerify.disabled=false; }
  function lock(){ verified=true; codeInput.readOnly=true; btnVerify.disabled=true; btnSend.disabled=true; btnSend.textContent='인증 완료';
    vmsg.textContent='새 이메일이 인증되었습니다.'; vmsg.className='verify-msg ok'; }

  function check(){
    var v=inp.value.trim().toLowerCase();
    chk.textContent=''; chk.className='email-check'; emailOk=false;
    if(v===orig){ verify.hidden=true; chk.textContent='현재 이메일입니다.'; return; }
    if(!re.test(v)){ verify.hidden=true; return; }
    clearTimeout(timer); chk.textContent='확인 중…';
    timer=setTimeout(function(){
      fetch('/api/check-email?email='+encodeURIComponent(v)).then(function(r){return r.json();}).then(function(d){
        if(inp.value.trim().toLowerCase()!==v) return;
        if(d.available){ emailOk=true; chk.textContent='사용 가능한 이메일입니다. 인증코드를 받아 인증해 주세요.'; chk.className='email-check ok'; verify.hidden=false; }
        else { emailOk=false; chk.textContent='이미 사용 중인 이메일입니다.'; chk.className='email-check err'; verify.hidden=true; }
      }).catch(function(){ chk.textContent=''; });
    },400);
  }
  inp.addEventListener('input', function(){ reset(); check(); });

  btnSend.addEventListener('click', function(){
    var v=inp.value.trim().toLowerCase();
    if(!re.test(v)){ vmsg.textContent='이메일을 먼저 정확히 입력해 주세요.'; vmsg.className='verify-msg err'; return; }
    btnSend.disabled=true; btnSend.textContent='전송 중…';
    fetch('/api/send-code',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({email:v}).toString()})
      .then(function(r){return r.json();}).then(function(d){
        btnSend.disabled=false; btnSend.textContent='코드 재전송';
        if(!d.ok){ vmsg.textContent=d.error||'코드 발송에 실패했습니다.'; vmsg.className='verify-msg err'; return; }
        codeRow.hidden=false; codeInput.focus();
        vmsg.textContent='인증 코드를 새 이메일로 보냈습니다. 10분 이내 입력해 주세요.'+(d.devCode?' [테스트: '+d.devCode+']':''); vmsg.className='verify-msg';
      }).catch(function(){ btnSend.disabled=false; btnSend.textContent='인증코드 받기'; vmsg.textContent='발송 오류. 잠시 후 다시 시도해 주세요.'; vmsg.className='verify-msg err'; });
  });
  btnVerify.addEventListener('click', function(){
    var v=inp.value.trim().toLowerCase(), code=codeInput.value.trim();
    if(code.length!==6){ vmsg.textContent='6자리 코드를 입력해 주세요.'; vmsg.className='verify-msg err'; return; }
    btnVerify.disabled=true;
    fetch('/api/verify-code',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({email:v,code:code}).toString()})
      .then(function(r){return r.json();}).then(function(d){
        if(d.ok){ lock(); alert('이메일이 인증되었습니다.'); }
        else { btnVerify.disabled=false; vmsg.textContent=d.error||'코드를 다시 확인하세요.'; vmsg.className='verify-msg err'; }
      }).catch(function(){ btnVerify.disabled=false; vmsg.textContent='인증 오류. 잠시 후 다시 시도해 주세요.'; vmsg.className='verify-msg err'; });
  });

  form.addEventListener('submit', function(e){
    var v=inp.value.trim().toLowerCase();
    if(v!==orig && !verified){ e.preventDefault(); alert('이메일을 변경하려면 새 이메일 인증을 완료해 주세요. (인증하지 않으려면 원래 이메일로 되돌려 주세요)'); inp.focus(); }
  });
})();
</script>

<!-- 다음(카카오) 우편번호 서비스: 도로명 주소 검색 -->
<script src="https://t1.daumcdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js"></script>
<script>
(function(){
  var btn = document.getElementById('addrSearchBtn');
  var addr = document.getElementById('address');
  if (!btn) return;
  function openSearch(){
    if (typeof daum === 'undefined' || !daum.Postcode) {
      // 스크립트 로드 실패 시 수동 입력 허용
      addr.removeAttribute('readonly'); addr.focus();
      alert('주소 검색 서비스를 불러오지 못했습니다. 주소를 직접 입력해 주세요.');
      return;
    }
    new daum.Postcode({
      oncomplete: function(data){
        addr.value = data.roadAddress || data.jibunAddress || '';
        var detail = document.getElementById('address_detail');
        if (detail) detail.focus();
      }
    }).open();
  }
  btn.addEventListener('click', openSearch);
  // readonly 필드를 클릭해도 검색창이 열리도록
  addr.addEventListener('click', openSearch);
})();
</script>

