<%- include('partials/header') %>

<section class="page-banner">
  <div class="container">
    <span class="page-banner-en">MY PAGE</span>
    <h1 class="page-banner-title">내 정보 수정</h1>
    <p class="page-banner-desc">정보를 변경하려면 보안을 위해 현재 비밀번호를 입력해야 합니다.</p>
  </div>
</section>

<div class="container page-wrap">
  <% if (done) { %><p class="form-alert ok" style="max-width:560px;margin:0 auto 18px"><%= done %></p><% } %>

  <div class="mypage-edit-grid">
    <!-- 정보 수정 -->
    <div class="mypage-card">
      <h2 class="mypage-h">기본 정보</h2>
      <% if (error) { %><p class="form-alert err"><%= error %></p><% } %>
      <form method="post" action="/mypage/edit" class="admin-form-fields">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field"><label>이메일</label><input type="email" value="<%= esc(m.email) %>" disabled /><span class="field-hint">이메일은 변경할 수 없습니다. 변경이 필요하면 사무처로 문의해 주세요.</span></div>
        <div class="field"><label>회원 등급</label><input type="text" value="<%= esc(m.grade || '준회원') %> · <%= esc(m.member_type) %>" disabled /></div>
        <div class="field"><label for="name">이름</label><input type="text" id="name" name="name" value="<%= esc(m.name) %>" autocomplete="name" required /></div>
        <div class="field"><label for="phone">연락처</label><input type="tel" id="phone" name="phone" value="<%= esc(m.phone || '') %>" autocomplete="tel" /></div>
        <div class="field"><label for="org_name">기관·단체명</label><input type="text" id="org_name" name="org_name" value="<%= esc(m.org_name || '') %>" /></div>
        <div class="field field--gate"><label for="current">현재 비밀번호 <span class="field-hint">보안 확인</span></label><input type="password" id="current" name="current" autocomplete="current-password" required /></div>
        <button type="submit" class="btn btn-primary btn-block">정보 저장</button>
      </form>
    </div>

    <!-- 비밀번호 변경 -->
    <div class="mypage-card">
      <h2 class="mypage-h">비밀번호 변경</h2>
      <% if (pwError) { %><p class="form-alert err"><%= pwError %></p><% } %>
      <form method="post" action="/mypage/password" class="admin-form-fields">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field"><label for="pw_current">현재 비밀번호</label><input type="password" id="pw_current" name="current" autocomplete="current-password" required /></div>
        <div class="field"><label for="newpw">새 비밀번호 <span class="field-hint">8자 이상</span></label><input type="password" id="newpw" name="newpw" autocomplete="new-password" required minlength="8" /></div>
        <div class="field"><label for="pw_confirm">새 비밀번호 확인</label><input type="password" id="pw_confirm" name="confirm" autocomplete="new-password" required minlength="8" /></div>
        <button type="submit" class="btn btn-neutral btn-block">비밀번호 변경</button>
      </form>
    </div>
  </div>

  <p style="text-align:center;margin-top:18px"><a class="btn btn-ghost btn-sm" href="/mypage">← 마이페이지로</a></p>
</div>

<%- include('partials/footer') %>
