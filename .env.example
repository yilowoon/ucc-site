# 프로덕션 환경변수 예시 (.env 로 복사해 값 채우기)
# server.js 가 시작 시 이 파일(.env)을 읽어 process.env 에 채웁니다.
# (이미 export/pm2 로 설정된 실제 환경변수가 있으면 그 값이 우선됩니다.)

NODE_ENV=production
PORT=3000

# 세션 서명용 임의 문자열 (32자 이상 권장). 예: openssl rand -hex 32
SESSION_SECRET=여기에-길고-임의의-문자열

# Gemini(Generative Language API) — 데일리뉴스·지구촌소식브리프·소개 챗봇에 사용
GEMINI_API_KEY=여기에-발급받은-키
# (선택) 텍스트 모델. 기본값 gemini-2.0-flash
# GEMINI_TEXT_MODEL=gemini-2.0-flash
# (선택) 데일리뉴스 이미지 모델
# GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# (선택) 네이버 뉴스 API 키 — 데일리뉴스 보강용
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# 이메일 발송(SMTP) — 회원가입 이메일 인증 코드 발송에 사용
# 미설정 시: 개발환경은 화면에 테스트 코드 노출, 운영(NODE_ENV=production)은 인증 불가 → 가입 차단
# 예) Gmail 앱비밀번호: 계정 2단계인증 후 '앱 비밀번호' 발급해 SMTP_PASS 에 입력
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=발송계정@gmail.com
SMTP_PASS=앱비밀번호-16자리
SMTP_FROM=사단법인 도시공동체본부 <발송계정@gmail.com>

# 사이트 기본 URL (SNS 로그인 리다이렉트·메일 링크용). 미설정 시 요청 호스트로 자동 구성.
# BASE_URL=https://ucc.or.kr

# SNS 간편로그인(카카오·네이버·구글) — 각 제공사 개발자센터에서 앱 등록 후 발급.
# 있는 것만 자동 활성화(로그인 화면에 버튼 표시). 리다이렉트 URI 등록: {BASE_URL}/auth/{provider}/callback
#  · 카카오: https://developers.kakao.com  (제품설정>카카오로그인 ON, Redirect URI 등록, 동의항목 이메일)
# KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=            # (선택) 카카오 보안>Client Secret 사용 시
#  · 네이버: https://developers.naver.com  (네아로 애플리케이션, 이메일·이름 제공)
# NAVER_LOGIN_CLIENT_ID=
# NAVER_LOGIN_CLIENT_SECRET=
#  · 구글: https://console.cloud.google.com  (OAuth 동의화면 + 사용자 인증정보, 승인된 리디렉션 URI)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# (선택) 카카오톡 공유(리치 카드) — 알림마당 공유 버튼용 JavaScript 키
# KAKAO_JS_KEY=
